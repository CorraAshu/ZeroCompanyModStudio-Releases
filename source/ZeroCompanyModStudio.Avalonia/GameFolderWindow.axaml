<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeroCompanyModStudioAvalonia"
        x:Class="ZeroCompanyModStudioAvalonia.GameFolderWindow"
        x:DataType="local:GameFolderVm"
        Title="Zero Company Mod Studio — Find the game"
        Width="680" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,monospace"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="22,20" Spacing="12">

    <TextBlock Text="Where is Star Wars Zero Company?" FontSize="17" FontWeight="SemiBold"
               Foreground="{DynamicResource Fore}"/>

    <!-- WHAT HAPPENED, in the words the old Studio's setup screen used: found one, found several,
         or found none - and, when something was remembered and has gone, where it was. All of them
         end at the same box, so a person whose copy lives somewhere unusual is not sent down a
         different road from one who has a choice to make. -->
    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Intro}"/>

    <!-- WHAT ALREADY STANDS IN THE WAY, before anything is pressed: the finder failing, or a folder
         this program cannot write its settings to (Program Files) - with what to do about it. -->
    <TextBlock IsVisible="{Binding HasProblem}" FontSize="12" TextWrapping="Wrap"
               Foreground="#F87171" Text="{Binding Problem}"/>

    <!-- Only when something was found to choose from. Selecting a row fills the box below, so the
         box is always the single place the answer is read from. The first is already selected. -->
    <ListBox IsVisible="{Binding HasCandidates}"
             ItemsSource="{Binding Candidates}"
             SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
             MaxHeight="150" Background="{DynamicResource Panel}"
             BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <!-- NOT Classes="num": that class's Faint colour won over the local one here and drew
               the paths grey on the selection's blue. Set directly, so it cannot. -->
          <TextBlock FontFamily="Consolas,Cascadia Mono,monospace" FontSize="12"
                     Foreground="{DynamicResource Fore}" Text="{Binding}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" Name="PathBox" Text="{Binding Typed, Mode=TwoWay}"
               Watermark="...\steamapps\common\Star Wars Zero Company" FontSize="13"
               KeyDown="OnPathKey" IsEnabled="{Binding NotDone}"/>
      <Button Grid.Column="1" Content="Browse…" Click="OnBrowse" FontSize="12.5" Padding="16,6"
              IsEnabled="{Binding NotDone}"/>
    </Grid>

    <!-- Judged on every keystroke, so "Use this install" is never offered for a folder that
         will fail the moment it is pressed. A failure after pressing (no usmap beside the
         program, a folder that cannot be written to) is said here too, in the same place - and
         the button stays pressable, so a retry needs no retyping. -->
    <TextBlock Classes="num" TextWrapping="Wrap" Text="{Binding Verdict}"
               Foreground="{Binding VerdictBrush}"/>

    <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Footnote}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button Content="{Binding SkipText}" Click="OnSkip" FontSize="12.5" Padding="18,6"/>
      <Button Content="Use this install" Click="OnUse" FontSize="12.5" Padding="22,6"
              IsEnabled="{Binding CanUse}" IsVisible="{Binding NotDone}" IsDefault="True"
              Background="{DynamicResource Accent}" Foreground="#1A1408"/>
    </StackPanel>
  </StackPanel>
</Window>
