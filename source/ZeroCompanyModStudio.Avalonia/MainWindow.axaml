<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeroCompanyModStudioAvalonia"
        x:Class="ZeroCompanyModStudioAvalonia.MainWindow"
        x:DataType="local:StudioVm"
        Title="Zero Company Mod Studio"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ground}">

  <!-- ONE PROPERTY GRID, SHARED. The data-asset tab and the model viewport's Properties tab
       are the same two-column reader over the same PropRow, and a second copy of this markup is
       a second place for the value column to drift. Trail visibility lives on the ROW now, which
       is what made it shareable: the old binding cast the list's DataContext to AssetTab. -->
  <Window.Resources>
    <DataTemplate x:Key="PropRowTemplate" x:DataType="local:PropRow">
      <!-- HALVES, and a rule down the middle, as the reference has it. A fixed 360px value
           column sat against the right edge of a wide window with a field of empty between
           every name and its value. -->
      <!-- ONE HEIGHT FOR EVERY ROW. A checkbox and a dropdown are taller than a line of text,
           so a list that sized each row to its contents stepped up and down wherever a bool or an
           enum appeared. Giving the row a floor as tall as the tallest widget makes them uniform
           without clipping anything, which is what five attempts at shrinking the widgets could
           not do. -->
      <Grid ColumnDefinitions="1.2*,1,*" MinHeight="22">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}"
                    ClipToBounds="True">
          <!-- THE WIDTH IS RESERVED WHETHER OR NOT THERE IS A CHEVRON. Hiding the button takes
               its 16px with it, so a row with no children sat a notch to the left of its own
               siblings.

               SIXTEEN SQUARE, and it was seven by twelve: Padding 2,0 with no Width, no Height
               and no minimum of either, which made it the smallest control in the application and
               under half of any sane target. The name beside it is deliberately NOT the toggle
               here, unlike every other fold: this list's context menu acts on SelectedRow, so a
               name that folded instead of selecting would point Edit value at the wrong row. That
               is the same fault this batch is fixing in the section list, and it is not worth
               introducing here to gain a wider target. -->
          <Panel Width="16">
            <Button Click="OnTogglePropRow" Background="Transparent"
                    BorderThickness="0" CornerRadius="0" Padding="0"
                    Width="16" Height="16" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    IsVisible="{Binding ShowChevron}">
              <Path Classes="chev" Data="{Binding Chevron}"/>
            </Button>
          </Panel>
          <TextBlock Text="{Binding Label}" FontSize="13" Margin="2,0,0,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Name}"
                     Foreground="{DynamicResource Fore}"/>
          <TextBlock Text="{Binding Tag}" Classes="faint" FontSize="11.5"
                     Margin="6,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Trail}" Classes="faint" FontSize="11"
                     Margin="8,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding ShowTrail}"/>
          <!-- WHERE IT COMES FROM, on inherited rows only. The properties are ordered own-class
               first and then up the chain, so this marks where each run begins without a header
               row and without pushing every property a level deeper. -->
          <TextBlock Text="{Binding DeclaredBy}" Classes="faint" FontSize="11"
                     Margin="10,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding ShowDeclaredBy}"
                     ToolTip.Tip="declared by this class"/>
          <!-- WHAT THIS MOD DID TO THE ARRAY. The count beside it is the FILE's and stays the
               file's; this is the part that is ours, in the accent colour the rest of the panel
               uses for a change. -->
          <TextBlock Text="{Binding Pending}" FontSize="11.5"
                     Margin="10,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding ShowPending}"
                     Foreground="{DynamicResource Accent}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Line}" Opacity="0.6"/>
        <Panel Grid.Column="2">
          <!-- Double-click a value to edit it. Enter commits, Escape cancels. A row this mod has
               changed is drawn in the accent colour, as the reference marks its own. -->
          <TextBlock Text="{Binding Shown}" FontSize="13" IsVisible="{Binding ShowPlain}"
                     Margin="8,0,4,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" DoubleTapped="OnBeginPropEdit"
                     FontFamily="Consolas,Cascadia Mono,monospace"
                     Foreground="{DynamicResource Muted}"/>
          <TextBlock Text="{Binding Shown}" FontSize="13" Margin="8,0,4,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     DoubleTapped="OnBeginPropEdit" IsVisible="{Binding ShowEdited}"
                     FontFamily="Consolas,Cascadia Mono,monospace"
                     Foreground="{DynamicResource Accent}"/>
          <TextBox Text="{Binding Draft, Mode=TwoWay}" FontSize="13"
                   IsVisible="{Binding Editing}" Margin="6,0,4,0" Padding="3,0"
                   CornerRadius="0" KeyDown="OnPropEditKey"
                   FontFamily="Consolas,Cascadia Mono,monospace"/>
          <!-- A BOOL IS A CHECKBOX. It writes through the same numbers path a typed box would,
               because a true bool is one byte on disk and always has been, so this needed no new
               kind of change: only somewhere to click.

               ITS NATURAL SIZE, and a bool row is a pixel or two taller than its neighbours
               because of it. Constraining the Height CLIPS a CheckBox rather than shrinking it:
               the glyph border is part of the template and keeps its own size, and a panel that
               measures short does not help, because something above clips anyway. A whole box in
               a slightly tall row beats a box with its bottom edge missing. -->
          <CheckBox IsChecked="{Binding Ticked}" IsVisible="{Binding IsBool}"
                    Click="OnPropBoolToggled" Margin="8,0,0,0" Padding="0"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    MinWidth="0" MinHeight="0" Classes="prop"/>
          <!-- AN ENUM IS A DROPDOWN, filled from the enum's own value table. -->
          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Chosen}"
                    IsVisible="{Binding IsEnum}" SelectionChanged="OnPropEnumChanged"
                    FontSize="13" Margin="6,0,0,0" Padding="6,0" MinHeight="0"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    MinWidth="200" MaxWidth="340" CornerRadius="0"/>
          <!-- THE ROW'S BUTTONS, IN ONE RUN. Right-aligned so they do not move with the
               value's length. They share a strip because an array ENTRY carries both a remove
               and a follow, and two controls each anchored to the right edge sit on top of one
               another, which is not visible until a row happens to want both. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,4,0" Spacing="2">
            <!-- ADD AN ENTRY, on arrays of soft references only. See PropRow.IsRefArray for why
                 that is the only array shape offered one. -->
            <Button Click="OnAddRefEntry" IsVisible="{Binding IsRefArray}"
                    Content="+" FontSize="14" Padding="5,0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="add an entry to this array"/>
            <!-- COPY THE LAST ELEMENT. A struct array gets no picker: see PropRow.IsStructArray
                 for why an element is copied rather than created. -->
            <Button Click="OnDupStructEntry" IsVisible="{Binding IsStructArray}"
                    Content="+" FontSize="14" Padding="5,0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="copy the last entry, then edit the copy"/>
            <!-- DROP ONE ELEMENT of a struct array. -->
            <Button Click="OnDropStructEntry" IsVisible="{Binding IsStructEntry}"
                    Content="✕" FontSize="11" Padding="5,0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="take this entry out of the array"/>
            <!-- TAKE ONE OUT. On the entry itself, because that is the thing being removed and
                 the thing the person is looking at when they decide to. -->
            <Button Click="OnDropRefEntry" IsVisible="{Binding IsRefEntry}"
                    Content="✕" FontSize="11" Padding="5,0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="take this entry out of the array"/>
            <!-- FOLLOW THE REFERENCE, on rows whose value actually names a package. -->
            <Button Click="OnFollowProp" IsVisible="{Binding CanFollow}"
                    Content="→" FontSize="13" Padding="4,0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Target}"/>
          </StackPanel>
        </Panel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- A PROPERTY ROW'S CHECKBOX, shrunk in the TEMPLATE rather than by Height.
         Constraining a CheckBox's Height CLIPS it: the glyph border is part of the template and
         keeps its own size, so the box came out with its bottom edge missing. Setting the part's
         size is what actually makes it smaller, and it keeps the row the same height as every
         other row in the list. -->
    <Style Selector="CheckBox.prop">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="CheckBox.prop /template/ Border#NormalRectangle">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
    </Style>

    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Fore}"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
    </Style>
    <!-- A column heading in the list under the tree: Name and Type, as the Data Explorer has it. -->
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tiny">
      <Setter Property="Padding" Value="7,1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <!-- A ROW THAT FOLDS, inside a list.

         Invisible on purpose: it has to read as the row it sits in, not as a button drawn on top
         of one. Stretched both ways so the whole width folds, which is what stops the arrow from
         being the only target.

         A BUTTON RATHER THAN THE LIST SELECTION. A ListBox raises SelectionChanged only when the
         selection CHANGES, so a fold routed through it dies the moment the row it sits on is
         already selected. Click has no such rule. -->
    <!-- EVERY FOLD ARROW IN THE APPLICATION, in one place.

         It was fifty sites each carrying its own FontSize, in four different sizes, across two
         incompatible glyph pairs, every one of them a codepoint Segoe UI does not contain and so
         drawn by font fallback at a size this application did not control. See Chevrons.cs for
         the measurements. A drawn path cannot regress into any of that.

         THE SIZE LIVES HERE AND NOWHERE ELSE, which is the half that matters: a local value beats
         a style setter in Avalonia, so those FontSize attributes had to be deleted before this
         could reach anything. They are gone; do not put one back. Width is left at the call sites
         on purpose, because it reserves layout rather than describing the arrow. -->
    <Style Selector="Path.chev">
      <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- The section list draws its headings in the accent, and did before this. -->
    <Style Selector="Path.chev.accent">
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.foldrow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <!-- CANCELS THE ListBoxItem PADDING, which is 5,2 and sits OUTSIDE this button.

           Stretch only fills the container's CONTENT area, so the row's own padding stayed a dead
           strip: five pixels down each side and two along the top and bottom that selected the row
           instead of folding it. The author found it by the hover overlay, which is drawn to the
           button's real bounds and so was showing exactly where the target stopped. A negative
           margin is the one thing that reaches outside a content area, and it keeps the padding
           for every other kind of row, which does want it. -->
      <Setter Property="Margin" Value="-5,-2"/>
    </Style>
    <!-- Square, because it spans a list row now and a rounded pill inside a flat list reads as a
         button floating on it. The setter above does not reach here on its own. -->
    <Style Selector="Button.foldrow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- Square and flush, because that is what the reference is. A stack of rounded cards down
         the side reads as several panels; the Data Explorer is ONE. -->
    <Style Selector="Border.pane">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- THE EDITOR'S FURNITURE.

         A SECTION IS A CARD, not a line of small caps with everything after it. The border is
         what says where a section stops, which is the whole reason the flat first version bled
         into the read sheet under it — "Hides from the menu" ended up sitting below Save. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <!-- The head is a BUTTON because it folds the card. Styled flat so it reads as a heading
         and not as a control somebody has to notice before they can read the word on it. -->
    <Style Selector="Button.cardhead">
      <Setter Property="Background" Value="{DynamicResource Chrome}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.sechead">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LetterSpacing" Value="1.1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Fore}"/>
    </Style>
    <!-- One editable thing is a ROW with its own ground, so its buttons sit ON it instead of
         drifting to the far edge of a two-thousand-pixel window. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
    </Style>
    <!-- Changed by this mod. The accent edge is the same mark the Data Explorer puts on a
         modified asset, so one colour means one thing across the application. -->
    <Style Selector="Border.row.mine">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="2,1,1,1"/>
    </Style>
    <Style Selector="Border.rail">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.rail.on">
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- x:DataType IS LOAD BEARING. Without it the setter below is compiled against the WINDOW's
         data type and the build fails with "no property IsExpanded on StudioVm" — a row's binding
         is resolved against the row, not against the thing that owns the list. -->
    <Style Selector="TreeViewItem" x:DataType="local:GameNode">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="1"/>
      <!-- Two way, so opening a folder by hand and opening one in code are the same act. -->
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
    </Style>
    <!-- THE EXPANDER WAS TWELVE SQUARE, in a row twenty tall, with dead space on both sides of
         it. Measured rather than guessed: the theme part names here are real ones, read off the
         running control, because a /template/ selector that names a part which does not exist
         matches nothing and says nothing, so a wrong guess looks exactly like a right one.

         Before: chevron x12 w12 h12, expanding only across x15 to x22, then thirteen more dead
         pixels before the header content begins at x37. -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="18"/>
    </Style>
    <!-- AND THE BOX IS RESERVED WHETHER OR NOT THERE IS AN ARROW IN IT.

         Sizing the button alone widened the box only on rows that HAVE one, so a folder with no
         children kept the template's 12 and its name started eight pixels to the left of every
         sibling that could be opened. Measured: branch header x45, leaf header x37. The author
         saw it immediately, and it was the widening above that caused it. -->
    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <!-- MinWidth, NOT Width. The template sets this box's Width to 12 as a LOCAL value and a
           local value beats a style setter, so a Width setter here is ignored and says nothing
           about being ignored: measured, the leaf box stayed 12 while the branch grew to 20.
           MinWidth is applied as a CLAMP after Width, so it wins where Width cannot. The same
           local-beats-style rule is why the chevron sweep has to delete before it styles. -->
      <Setter Property="MinWidth" Value="20"/>
    </Style>
    <Style Selector="Border.tab">
      <Setter Property="Background" Value="{DynamicResource Chrome}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1,1,1,0"/>
    </Style>
    <!-- The section the left column is showing. An accent rule along the top, so the strip says
         which one you are in without any tab changing size. -->
    <Style Selector="Border.tab.on">
      <Setter Property="Background" Value="{DynamicResource Raised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="1,2,1,0"/>
    </Style>
    <!-- Every other row of a sheet, which is what makes a long one scannable. -->
    <Style Selector="Border.band">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
    </Style>
    <!-- SMALLER TABS, on the author's ask. Avalonia's default TabItem header is ~20pt with
         generous padding, which is a third of a side panel's width per tab; the reference's
         Properties/Variations/Mesh/Scene strip is barely taller than its text. -->
    <Style Selector="TabControl.side > TabItem">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="TabControl.side > TabItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <!-- R G B A, the reference's own shape: small, square, and lit when the channel is on. -->
    <Style Selector="ToggleButton.chan">
      <Setter Property="Width" Value="21"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0,1"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="5,2"/>
    </Style>
  </Window.Styles>

  <DockPanel Name="Root">

    <!-- ============================================================ THE BUILD BAR
         Across the whole window and pinned to the bottom, as the old studio has it: the state on
         the left, where it goes on the right, and the thing that sends it hard right of that. It
         is the one control in this application that writes outside the project file, so it is
         never inside a panel that can be scrolled away from.

         Every reason the button might not work is SAID beside it. A greyed control with no
         explanation is the shape of thing that makes somebody think the tool is broken. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6"
            IsVisible="{Binding HasMod}">
      <!-- COLUMN 3 (the address) IS CAPPED, and its text trims: a 40-character mod name made it wide enough
           to push Build and install off a 900 px window. The whole address is on its tooltip. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto" MaxWidth="340"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- THE LAMP. Three of them rather than a converter, which is the pattern the rest of
             this markup already uses for an accent-or-faint pair. -->
        <Panel Grid.Column="0" Width="9" Height="9" Margin="2,0,9,0"
               VerticalAlignment="Center">
          <Ellipse Fill="{DynamicResource Accent}" IsVisible="{Binding BuildBusy}"/>
          <Ellipse Fill="#4ADE80" IsVisible="{Binding BuildReady}"/>
          <Ellipse Fill="#F87171" IsVisible="{Binding BuildBlocked}"/>
        </Panel>

        <TextBlock Grid.Column="1" Text="{Binding BuildSays}" FontSize="11.5"
                   VerticalAlignment="Center" Classes="dim"/>

        <!-- WHAT JUST HAPPENED. The problems themselves are SAID IN THE LOG, in red, rather
             than crowded in here: three of them shared one trimmed line and the rest were a
             tooltip, which is no way to read a sentence naming an asset path. The count and the
             red dot stay, because those are a status and belong on a status bar. -->
        <Panel Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding BuildStatus}" FontSize="11" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding BuildStatus}" Classes="faint"/>
        </Panel>

        <TextBlock Grid.Column="3" Text="{Binding BuildWhere}" FontSize="11" Classes="faint"
                   VerticalAlignment="Center" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"
                   FontFamily="Consolas,monospace" ToolTip.Tip="{Binding BuildWhereTip}"/>

        <!-- The two things that follow a build: pack what was installed so somebody else can use
             it, and send the mod to the game. The first is live only once the mod IS installed;
             while it is not, its tooltip says why (ShowOnDisabled) rather than leaving a grey
             button to be wondered at. -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
          <Button Name="ShareButton" Content="{Binding ShareLabel}" Click="OnShare"
                  IsEnabled="{Binding CanShare}" Padding="14,5" FontSize="12"
                  ToolTip.ShowOnDisabled="True" ToolTip.Placement="TopEdgeAlignedRight"
                  ToolTip.VerticalOffset="-6">
            <!-- A text block of its own, so the tip can be wider than the theme's 320 px and the
                 paragraphs wrap where the window says rather than where the source did. -->
            <ToolTip.Tip>
              <ToolTip MaxWidth="520">
                <TextBlock Text="{Binding ShareTip}" TextWrapping="Wrap"/>
              </ToolTip>
            </ToolTip.Tip>
          </Button>
          <Button Content="{Binding BuildLabel}" Click="OnBuildAndInstall"
                  IsEnabled="{Binding CanBuild}" Padding="14,5" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- THE MENU BAR IS TWO MENUS IN ONE STRIP: the Studio's own on the left, and on the right
         the notice and the credit - the same arrangement the ImGui Studio draws with
         SetCursorPosX, because the credit is anchored to the right edge and is the one thing
         that must not move when something is added beside it. Auto, *, Auto: the left menu
         takes what it needs, the gap takes the rest, and the right menu takes what it needs, so
         a window too narrow for all three squeezes the gap first and never the credit. -->
    <Grid DockPanel.Dock="Top" Background="{DynamicResource Chrome}" Height="30"
          ColumnDefinitions="Auto,*,Auto">
    <Menu Grid.Column="0" Background="Transparent" Height="30">
      <MenuItem Header="_Project">
        <MenuItem Header="Create New Mod" Click="OnCreateNew"/>
        <MenuItem Header="The mod's own details" Click="OnModDetails"
                  IsEnabled="{Binding HasMod}"/>
        <MenuItem Header="A character of your own…" Click="OnNewCharacter"
                  IsEnabled="{Binding HasMod}"/>
        <MenuItem Header="Unload existing mod" Click="OnUnload" IsEnabled="{Binding HasMod}"/>
        <Separator/>
        <MenuItem Header="Build and install" Click="OnBuildAndInstall"
                  IsEnabled="{Binding CanBuild}"/>
        <MenuItem Header="Take it back out of the game" Click="OnUninstall"
                  IsEnabled="{Binding HasMod}"/>
        <MenuItem Header="Zip it for sharing" Click="OnShare" IsEnabled="{Binding CanShare}"
                  ToolTip.Tip="{Binding ShareTip}" ToolTip.ShowOnDisabled="True"/>
        <Separator/>
        <MenuItem Header="Open Create a Mod window" Click="OnOpenProjects"/>
        <!-- APP-LEVEL, not about the mod: tells the Studio where the game is. Where a person goes
             when the game moved, was never found, or the wrong one was picked - and what a failed
             mount's message points at. -->
        <MenuItem Header="Find the game again…" Click="OnFindGame"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="OnUndo" IsEnabled="False"/>
        <MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="OnRedo" IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="Revert all changes" Click="OnRevertAll" IsEnabled="{Binding HasMod}"/>
      </MenuItem>
      <!-- "add the button to the mod studio by the project and edit buttons". The two guides the
           ImGui Studio offers, from the same files, so there is one handbook and not two. -->
      <MenuItem Header="_Handbook">
        <MenuItem Header="Your First Mod — start here" Click="OnOpenGuide" Tag="first-mod.html"/>
        <MenuItem Header="The Complete Handbook" Click="OnOpenGuide" Tag="handbook.html"/>
      </MenuItem>
      <!-- WHO MADE IT AND WHAT MAY BE DONE WITH IT, and where the next version is. The ImGui
           Studio had the same menu with the same three entries. -->
      <!-- PLUGINS, beside Handbook because that is where the guides send people: the Blender
           add-on's installer, and the two presets that ship beside the program. Absent when this
           build carries none of them, rather than a menu that opens onto nothing (the ImGui
           Studio's rule). -->
      <MenuItem Header="_Plugins" IsVisible="{Binding HasPlugins}">
        <MenuItem Name="PluginsItem" Header="Add-ons and presets…" Click="OnOpenPlugins"
                  ToolTip.Tip="The Blender add-on: browse and import this game's models from inside Blender. The Substance preset: export texture maps the way this game wants them. The 3ds Max script: retarget a Battlefront II character onto this game's rig."/>
      </MenuItem>
      <MenuItem Header="_About">
        <MenuItem Name="AboutItem" Header="About Zero Company Mod Studio…" Click="OnAbout"/>
        <MenuItem Name="DownloadsItem" Header="Downloads and updates" Click="OnOpenDownloads"/>
        <!-- The notice again, where somebody who dismissed the bar would look for it. Absent
             unless a newer release has been found. -->
        <Separator IsVisible="{Binding HasUpdate}"/>
        <MenuItem Name="GetUpdateItem" Header="{Binding UpdateGetText}" Click="OnGetUpdate" Foreground="{DynamicResource Accent}"
                  IsVisible="{Binding HasUpdate}"/>
      </MenuItem>
    </Menu>

    <!-- NOTICE, THEN CREDIT, right-aligned. The notice is only there when a newer release has
         been found, and opens what changed in it rather than the download page; the credit is
         always there, and is a menu item as well as a label so clicking it opens About - one
         place, two ways in. -->
    <Menu Grid.Column="2" Background="Transparent" Height="30" HorizontalAlignment="Right">
      <MenuItem Name="UpdateNoticeItem" Header="{Binding UpdateText}" Click="OnUpdateNotice"
                Foreground="{DynamicResource Accent}" FontSize="12.5"
                IsVisible="{Binding HasUpdate}"
                ToolTip.Tip="{Binding UpdateTip}"/>
      <MenuItem Name="CreditItem" Header="{Binding CreditText}" Click="OnAbout" FontSize="12.5"
                Foreground="{DynamicResource Muted}" IsVisible="{Binding HasCredit}"
                ToolTip.Tip="About this tool"/>
    </Menu>
    </Grid>

    <!-- THE OLD BLENDER ADD-ON, said once and offered ONE click. Shown only when an add-on
         installed for some Blender is older than the one this Studio ships (an add-on from 1.6.x
         runs a program 2.0 no longer includes, and every import from Blender then fails). Looking
         changes nothing; the button is the installer run again. "Not now" hides it for this run. -->
    <Border Name="AddonOffer" DockPanel.Dock="Top" IsVisible="{Binding HasAddonOffer}"
            Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Accent}"
            BorderThickness="0,0,0,2" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="{Binding AddonOfferText}" FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource Fore}"/>
        <Button Grid.Column="1" Name="AddonUpdateButton" Content="Update the Blender add-on"
                Click="OnUpdateAddon" IsVisible="{Binding CanUpdateAddon}" Padding="14,6" FontSize="12"
                VerticalAlignment="Center"/>
        <Button Grid.Column="2" Name="AddonDismissButton" Content="{Binding AddonDismissText}" Click="OnDismissAddon"
                Padding="12,6" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding ModTitle}" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fore}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Classes="faint" FontSize="11.5" Margin="12,0,0,0"
                   VerticalAlignment="Center" Text="{Binding ModPath}"/>
        <!-- WHERE SOMEBODY LOOKING AT THE MOD'S NAME ALREADY IS. The menu has it too; this is
             the one place the name and the author are read, so it is where the press to change
             them belongs. -->
        <Button Grid.Column="2" Content="Details…" Click="OnModDetails" Padding="10,3"
                FontSize="11.5" IsVisible="{Binding HasMod}"/>
      </Grid>
    </Border>

    <!-- ============================================================ THE TAB STRIP
         Full width and above everything, as the reference has it. Hidden while nothing is open,
         because an empty strip is a row of chrome that explains nothing. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Ground}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
       <StackPanel Orientation="Horizontal">

        <!-- HOME PAGE AND THE NINE SECTIONS, always there. These are what replaced the row of
             nine buttons: the same choices, in the strip, beside whatever assets are open. -->
        <ItemsControl ItemsSource="{Binding SectionTabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:SectionTab">
              <Border Classes="tab" Classes.on="{Binding IsActive}" Margin="0,0,1,0">
                <Button Click="OnPickSection" Background="Transparent" BorderThickness="0"
                        CornerRadius="0" Padding="10,5">
                  <TextBlock Text="{Binding Title}" FontSize="12"/>
                </Button>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:StudioTab">
              <Border Classes="tab" Classes.on="{Binding IsActive}" Margin="0,0,1,0" Padding="0">
                <StackPanel Orientation="Horizontal">
                  <!-- A TEXTBLOCK, NOT A STRING CONTENT. A Button renders string content
                       through AccessText, which swallows the first underscore as an access-key
                       marker: CPD_H_Outfit_Clo001_ARMS appeared on the tab as CPDH_Outfit_...
                       Asset names here are mostly underscores, so every tab would have been
                       subtly misnamed. -->
                  <Button Click="OnPickTab" Background="Transparent" BorderThickness="0"
                          CornerRadius="0" Padding="10,5" ToolTip.Tip="{Binding Tooltip}">
                    <TextBlock Text="{Binding Title}" FontSize="12"/>
                  </Button>
                  <Button Click="OnCloseTab" Background="Transparent" BorderThickness="0"
                          CornerRadius="0" Padding="4,5,8,5" FontSize="11" Content="✕"
                          ToolTip.Tip="Close this tab"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ================================================================== THE BODY
         The left column runs the FULL height of the window and the log begins where it ends,
         which is the arrangement in the reference: the explorer is the spine of the window, not
         something sharing the top half with it. -->
    <Grid Name="BodyGrid">
      <!-- NAMED, because collapsing has to take the WIDTH to zero and not merely hide what is in
           it. IsVisible on the contents left the 330 reserved and the editing side did not grow
           into it: the column was empty rather than gone. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="180"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============================================================ DATA EXPLORER -->
      <Border Grid.Column="0" Classes="pane" BorderThickness="0,0,1,0"
              IsVisible="{Binding PanelOpen}">
       <Panel>

        <!-- ===================================================== A SECTION
             Home Page shows the Data Explorer; any other tab turns this column into that
             section's list. His words: "it would turn the data explorer into that section you
             select ... and if we hit Home page it'd take us back to what we see now". -->
        <DockPanel IsVisible="{Binding InSection}">
          <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="3" Height="13" CornerRadius="1" Margin="0,0,7,0"
                      Background="{DynamicResource Accent}"/>
              <TextBlock Grid.Column="1" Text="{Binding SectionTitle}" FontSize="12.5"
                         Foreground="{DynamicResource Fore}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="tiny" Content="«" Click="OnTogglePanel"
                      ToolTip.Tip="Collapse this column"/>
            </Grid>
          </Border>

          <!-- The section's own toolbar: the ImGui browser's "only duplicatable" test, and a
               box over this list rather than over the game. -->
          <Border DockPanel.Dock="Top" Padding="6,4"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <CheckBox Grid.Column="0" IsChecked="{Binding OnlyUsable, Mode=TwoWay}" FontSize="12"
                        IsVisible="{Binding HasUnusable}"
                        Content="Only what a mod can use" VerticalAlignment="Center"
                        ToolTip.Tip="Hides entries a mod cannot start from — a weapon whose chain belongs to another, or a part with no geometry"/>
              <Button Grid.Column="1" Classes="tiny" Content="Collapse all" Click="OnCollapseGroups"
                      Margin="6,0,0,0"/>
              <Button Grid.Column="2" Classes="tiny" Content="Expand all" Click="OnExpandGroups"
                      Margin="4,0,0,0"/>
            </Grid>
          </Border>

          <TextBox DockPanel.Dock="Top" FontSize="12" CornerRadius="0" BorderThickness="0,0,0,1"
                   Padding="6,3" Watermark="Filter" Text="{Binding SectionFilter, Mode=TwoWay}"/>

          <Border DockPanel.Dock="Bottom" Padding="7,4"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                         IsVisible="{Binding SectionLoading}" Text="reading the game…"/>
              <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5"
                         Text="{Binding SectionCount}"/>
            </Grid>
          </Border>

          <ListBox ItemsSource="{Binding SectionRows}" Background="Transparent" BorderThickness="0"
                   SelectedItem="{Binding SectionPick, Mode=TwoWay}" Padding="0,2"
                   DoubleTapped="OnOpenSectionItem"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- His menu, in his order. Export and Import are deliberately absent: "Export and
                 Import we don't really need". -->
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Click="OnOpenSectionItem"/>
                <MenuItem Header="Edit" Click="OnEditSectionItem"
                          IsEnabled="{Binding EditOffered}"
                          ToolTip.Tip="{Binding EditTip}"
                          ToolTip.ShowOnDisabled="True"/>
                <MenuItem Header="Revert" Click="OnRevertSectionItem"
                          IsEnabled="{Binding RevertOffered}"
                          ToolTip.Tip="{Binding RevertTip}"
                          ToolTip.ShowOnDisabled="True"/>
                <Separator/>
                <MenuItem Header="Duplicate" Click="OnDuplicateSectionItem"
                          IsEnabled="{Binding DuplicateOffered}"
                          ToolTip.Tip="{Binding DuplicateTip}"
                          ToolTip.ShowOnDisabled="True"/>
                <!-- A MISSION ONLY. Editing the game's own in place is the quickest thing to
                     test, because it is already on the galaxy map and needs no roll to appear;
                     a new mission has to be drawn from a weighted table before anyone can look
                     at it, which is four suspects and a campaign turn per attempt. -->
                <MenuItem Header="Edit the game's own in place" Click="OnEditInPlace"/>
                <!-- A RECRUIT ONLY. Duplicate beside it takes the character that row already
                     names; this one is for somebody who is in no pool at all — a B2, a
                     Magnaguard — where the row is only being borrowed for its table and pawn. -->
                <MenuItem Header="Add somebody to this pool…" Click="OnAddToPool"/>
                <!-- THE SAME ACT MINUS A ROW. Add leaves the roster one longer and displaces
                     nobody; this re-points the row under the cursor, so the person who was in
                     it stops being offered. Listed second on purpose — add is the one to reach
                     for, and this is the one that costs somebody. -->
                <MenuItem Header="Take their place…" Click="OnTakeTheirPlace"/>
                <!-- The undo, and it has to be its own item: the re-point lives on the mod's
                     POOL TABLE, so "remove from this mod" would take every added row with it. -->
                <MenuItem Header="Put this row back" Click="OnPutRowBack"/>
                <Separator/>
                <!-- The join between the two routes: find the piece on the guided side, land on
                     it in the raw one without having to know the path. -->
                <MenuItem Header="Find in Data" Click="OnFindInData"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SectionItem">
                <Grid ColumnDefinitions="*,Auto">

                  <!-- A HEADING IS A ROW, drawn as a heading and clickable. The class names in
                       his drawing sit inline above their weapons, which is what this is — and
                       with 1,178 wearable parts across a few dozen slots, being able to shut the
                       ones you are not working on is what makes the list readable at all. -->
                  <!-- OUT THROUGH THE ListBoxItem PADDING, which is 5,2 and sits outside
                       this button: Stretch fills a container's CONTENT area only, so those five
                       pixels down each side selected the row instead of folding it. The padding
                       below carries the same numbers back so the heading has not moved. Same
                       fault, same fix, as the animation list. -->
                  <Button Grid.Column="0" Click="OnToggleGroup" IsVisible="{Binding IsHeader}"
                          Background="Transparent" BorderThickness="0" CornerRadius="0"
                          Margin="-5,-2" Padding="7,5,5,3" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <Path Classes="chev accent" Width="14" Data="{Binding Chevron}"/>
                      <TextBlock Text="{Binding Name}" FontSize="12"
                                 Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                  </Button>

                  <DockPanel Grid.Column="0" Margin="16,0,0,0" IsVisible="{Binding !IsHeader}">
                    <!-- The picture, where there is one. The 22px box is reserved either way, so
                         a row whose icon has not arrived yet does not shuffle its neighbours
                         sideways when it does. -->
                    <Border DockPanel.Dock="Left" Width="26" Height="20" Margin="0,0,7,0"
                            VerticalAlignment="Center" IsVisible="{Binding $parent[ListBox].((local:StudioVm)DataContext).SectionHasIcons}"
                            Background="{DynamicResource Raised}">
                      <Image Source="{Binding Icon}" Stretch="Uniform"/>
                    </Border>
                    <!-- A GRID, NOT A STACKPANEL. A horizontal StackPanel gives every child its
                         desired width, so TextTrimming never fires and a long name runs straight
                         over the id beside it — which is what the mission list did, drawing two
                         strings on top of each other. Shared columns trim instead. -->
                    <!-- The NAME gets the larger share: it is what somebody is reading, and the
                         id beside it only has to be enough to tell two rows apart. -->
                    <!-- A BAR AND THE ACCENT COLOUR where this mod changes it, exactly as the
                         Data Explorer marks an asset — "have I done anything with this?" is
                         asked in both lists and should be answered the same way in both. A
                         duplicate counts: the game's part is untouched, but the honest answer
                         after copying it is still yes. -->
                    <Border DockPanel.Dock="Left" Width="3" Margin="0,1,5,1"
                            IsVisible="{Binding Changed}"
                            Background="{DynamicResource Accent}"/>
                    <Grid ColumnDefinitions="3*,2*">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 IsVisible="{Binding !Changed}"
                                 Foreground="{DynamicResource Fore}"/>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 IsVisible="{Binding Changed}"
                                 Foreground="{DynamicResource Accent}"/>
                      <!-- The game's own id, for the twenty consecutive rows that all read
                           "Gloves". The name is what somebody reads; this tells them apart. -->
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="faint"
                                 FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DockPanel>

                  <!-- CAPPED, because a note is a hint and the row is a name. "not a wearable
                       outfit slot" is the conversion's own wording and it is longer than most of
                       the names it sits beside; the whole of it is on the tooltip and on the
                       sheet. -->
                  <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="faint" FontSize="10.5"
                             Margin="10,0,6,0" VerticalAlignment="Center" MaxWidth="118"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- ===================================================== THE DATA EXPLORER -->
        <DockPanel IsVisible="{Binding OnHome}">

          <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="3" Height="13" CornerRadius="1" Margin="0,0,7,0"
                      Background="{DynamicResource Accent}"/>
              <TextBlock Grid.Column="1" Text="Data Explorer" FontSize="12.5"
                         Foreground="{DynamicResource Fore}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="tiny" Content="«" Click="OnTogglePanel"
                      ToolTip.Tip="Collapse this column"/>
            </Grid>
          </Border>

          <!-- THE TOOLBAR. Both controls do something: the first flattens the list to everything
               beneath the selected folder, and the second turns the list into what this mod
               changes, which is why there is no separate Mod Content panel any more. -->
          <Border DockPanel.Dock="Top" Padding="6,4"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ToggleButton IsChecked="{Binding Flat, Mode=TwoWay}" Padding="6,3"
                            ToolTip.Tip="List everything beneath the folder, not only what is directly in it">
                <Path Data="M0,1 L4.2,1 L5.6,2.8 L12,2.8 L12,10 L0,10 Z"
                      Fill="{DynamicResource Fore}" Width="12" Height="11" Stretch="Uniform"/>
              </ToggleButton>
              <CheckBox IsChecked="{Binding OnlyModified, Mode=TwoWay}" FontSize="12"
                        Content="Show only modified" VerticalAlignment="Center"
                        ToolTip.Tip="List what this mod changes or adds"/>
            </StackPanel>
          </Border>

          <!-- FULL WIDTH. The match count went beside it for one build and ate a third of the
               box; it belongs in the log, which is where a record of what a search did belongs. -->
          <TextBox DockPanel.Dock="Top" FontSize="12" CornerRadius="0" BorderThickness="0,0,0,1"
                   Padding="6,3" Text="{Binding GameFilter, Mode=TwoWay}"
                   Watermark="Filter — or Type: DataAsset"
                   ToolTip.Tip="A name, or Type: DataAsset / Type: SkeletalMesh / Type: Texture2D. Both together also work."/>

          <TextBlock DockPanel.Dock="Bottom" Classes="faint" Margin="7,4" TextWrapping="Wrap"
                     FontSize="10.5" Text="{Binding GameStatus}"/>

          <Grid RowDefinitions="*,4,270">

            <!-- FOLDERS ONLY. A tree carrying both makes somebody scroll past 900 files to reach
                 the next folder, which is the thing the pane underneath exists to stop. Each
                 folder materialises its own children the first time it is opened, so 179,966
                 files cost nothing until asked for. -->
            <TreeView Grid.Row="0" ItemsSource="{Binding Tree}"
                      SelectedItem="{Binding Folder, Mode=TwoWay}"
                      Background="Transparent" BorderThickness="0" Padding="0,2">
              <!-- ON THE FOLDER, which is the thing the author asked to right click. The menu
                   acts on whatever the tree has SELECTED rather than on what was clicked: a
                   right click selects the row first, so the two are the same row, and taking it
                   from the selection means the handler cannot act on one folder while another
                   is lit. That exact disagreement was a real bug in the section list today. -->
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Extract this folder…" Click="OnExtractFolder"/>
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Folders}" x:DataType="local:GameNode">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Data="M0,1 L4.2,1 L5.6,2.8 L12,2.8 L12,10 L0,10 Z"
                          Fill="{DynamicResource Muted}" Width="12" Height="11" Stretch="Uniform"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                               Foreground="{DynamicResource Fore}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Classes="faint" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,4,0" Text="{Binding Detail}"/>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Row="1" Background="{DynamicResource Line}" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"/>

            <!-- ==================================================== THE CONTENTS -->
            <DockPanel Grid.Row="2">

              <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0">
                <Grid ColumnDefinitions="*,1,88">
                  <Button Grid.Column="0" Click="OnSortByName" Background="Transparent"
                          BorderThickness="0" CornerRadius="0" Padding="6,3"
                          HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Sort by name">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="colhead" Text="Name"/>
                      <TextBlock Grid.Column="1" Classes="colhead" FontSize="9"
                                 Text="{Binding SortArrow}"/>
                    </Grid>
                  </Button>
                  <Border Grid.Column="1" Background="{DynamicResource Line}"/>
                  <TextBlock Grid.Column="2" Classes="colhead" Margin="6,3" Text="Type"/>
                </Grid>
              </Border>

              <Border DockPanel.Dock="Bottom" Padding="7,3"
                      BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                             TextTrimming="CharacterEllipsis" Text="{Binding Where}"/>
                  <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5" Margin="8,0,0,0"
                             Text="{Binding ListCount}"/>
                </Grid>
              </Border>

              <Panel>
                <TextBlock Classes="faint" FontSize="11" Margin="8,10" TextWrapping="Wrap"
                           IsVisible="{Binding ListEmpty}" Text="{Binding EmptyBecause}"/>

                <!-- HORIZONTAL SCROLLING OFF, deliberately. With it on the ListBox hands each row
                     its natural width, the star column grows to the longest name in the folder,
                     and the Type column is pushed off the right edge of the panel entirely. It
                     was: fifteen rows of names and not one type. -->
                <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0,1"
                         DoubleTapped="OnOpenAsset"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <!-- REPLACING A TEXTURE IS AN IMPORT AND UNDOING IT IS A REVERT, and neither
                       one mentions an override: the author's words were "they just simply import
                       a new one over an existing one and it's all handled on the backend". The
                       override is how the build represents it, not something to make anybody
                       think about. -->
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Open" Click="OnOpenAsset"/>
                      <MenuItem Header="Import texture…" Click="OnImportOverAsset"/>
                      <MenuItem Header="Revert" Click="OnRevertAsset"/>
                      <Separator/>
                      <!-- HIS ASK: "So if i want to say delete a part or something i made i
                           can?" Under Show only modified this list is exactly the things he
                           made, so this is where it belongs. It asks first and it asks by name,
                           because there is no undo here. -->
                      <MenuItem Header="Remove from this mod…" Click="OnRemoveFromMod"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AssetRow">
                      <!-- A ROW THIS MOD CHANGES IS DRAWN AS CHANGED. AssetRow.Modified has
                           existed since the explorer did, with a comment saying "Modified rows
                           are drawn in the accent colour" — and nothing ever
                           bound it, so the flag was computed on every rebuild and thrown away.
                           His report: "When a game asset is modified it should be highlighted
                           that it's been modified." -->
                      <Grid ColumnDefinitions="Auto,*,88">
                        <Border Grid.Column="0" Width="3" Margin="0,1,5,1"
                                IsVisible="{Binding Modified}"
                                Background="{DynamicResource Accent}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !Modified}"
                                   Foreground="{DynamicResource Fore}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Modified}"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="11"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Muted}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </DockPanel>
          </Grid>
        </DockPanel>
       </Panel>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"
                    IsVisible="{Binding PanelOpen}"/>

      <!-- ====================================== THE EDITING SIDE, AND THE LOG UNDER IT
           The log is in THIS column, not across the foot of the window, so it begins where the
           explorer ends. -->
      <Grid Grid.Column="2" RowDefinitions="*,5,200">

        <Border Grid.Row="0" Classes="pane" BorderThickness="0">
          <DockPanel>
            <!-- The way back when the column is collapsed. Without it, collapsing is one way. -->
            <Border DockPanel.Dock="Top" Padding="6,4" IsVisible="{Binding !PanelOpen}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <Button Classes="tiny" Content="»" Click="OnTogglePanel"
                      HorizontalAlignment="Left" ToolTip.Tip="Show the Data Explorer"/>
            </Border>

            <Panel>
              <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="13" TextAlignment="Center" IsVisible="{Binding !HasTab}"
                         Text="{Binding EmptyPaneHint}"/>

              <!-- ================================================ THE PROPERTIES PANEL
                   The visibility is decided by the STUDIO and the contents by the TAB, so they
                   sit on different elements: x:DataType applies to the element it is written on,
                   and one that re-points DataContext cannot also read the studio's own state. -->
              <!-- WHAT THE PANE DRAWS IS DECIDED BY THE TAB'S TYPE, not by a flag on the view
                   model. Adding a section's editor is then a DataTemplate rather than another
                   branch in something that already had two. -->
              <ContentControl Content="{Binding Tab}" IsVisible="{Binding HasTab}">
                <ContentControl.DataTemplates>

                  <DataTemplate DataType="local:AssetTab" x:DataType="local:AssetTab">
                  <DockPanel>

                <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="3" Height="13" CornerRadius="1" Margin="0,0,7,0"
                            Background="{DynamicResource Accent}"/>
                    <TextBlock Grid.Column="1" Text="Properties" FontSize="12.5"
                               Foreground="{DynamicResource Fore}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                               VerticalAlignment="Center" Text="{Binding Type}"/>
                  </Grid>
                </Border>

                <TextBox DockPanel.Dock="Top" FontSize="12" CornerRadius="0"
                         BorderThickness="0,0,0,1" Padding="6,3" Watermark="Filter"
                         Text="{Binding Filter, Mode=TwoWay}"/>

                <!-- WHERE IT CAME FROM, always on screen. With a mod installed there are two
                     packages at one id, and a panel that shows properties without saying which
                     copy they came from is how an evening went missing once already. -->
                <Border DockPanel.Dock="Bottom" Padding="8,4"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                               FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"
                               Text="{Binding Provenance}"/>
                    <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5" Margin="10,0,0,0"
                               Text="{Binding Status}"/>
                  </Grid>
                </Border>

                <Panel>
                  <TextBlock Classes="dim" FontSize="12" Margin="12,14" IsVisible="{Binding Loading}"
                             Text="reading the package…"/>

                  <TextBlock Classes="dim" FontSize="12" Margin="12,14" TextWrapping="Wrap"
                             IsVisible="{Binding Failed}" Text="{Binding Error}"/>

                  <ListBox Name="PropList" ItemsSource="{Binding Rows}" Background="Transparent"
                           SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                           BorderThickness="0" Padding="0,2"
                           ItemTemplate="{StaticResource PropRowTemplate}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Edit value" Click="OnBeginPropEdit"/>
                        <MenuItem Header="Revert" Click="OnRevertProp"/>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>
                </Panel>
                  </DockPanel>
                  </DataTemplate>

                  <!-- ======================================= ANY SHEET: PART, WEAPON,
                       UTILITY OR TABLE. One template, because they answer the same four
                       questions and differ only in the blocks they emit. -->
                  <DataTemplate DataType="local:SheetTab" x:DataType="local:SheetTab">
                    <DockPanel>

                      <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                              Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <!-- No empty frame for the things that have no picture: a weapon and
                               a table have none, and a 92-pixel blank beside a title is a hole
                               where the eye expects something. -->
                          <Border Grid.Column="0" Width="92" Height="92" Margin="0,0,14,0"
                                  IsVisible="{Binding HasPicture}"
                                  Background="{DynamicResource Panel}"
                                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <!-- YOUR picture once the card above has one. The header is the same
                                 picture, so leaving it on the game's after a replacement is the
                                 same small lie in a second place. -->
                            <Panel>
                              <Image Stretch="Uniform" Margin="3"
                                     IsVisible="{Binding HasIconPreview}"
                                     Source="{Binding IconPreview}"/>
                              <Image Stretch="Uniform" Margin="3"
                                     IsVisible="{Binding !HasIconPreview}"
                                     Source="{Binding Icon}"/>
                            </Panel>
                          </Border>

                          <!-- The part never stops identifying itself while it is being edited:
                               his words were "a completely new area UNDER the clone helmet icon,
                               name and where it says test mod overrides this part". -->
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center" IsVisible="{Binding Editing}">
                            <Button Classes="tiny" Content="{Binding SheetToggle}"
                                    Click="OnToggleEditSheet"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                         TextWrapping="Wrap" Foreground="{DynamicResource Fore}"/>
                              <Border Background="{DynamicResource Accent}" Padding="6,1"
                                      VerticalAlignment="Center" IsVisible="{Binding Editing}">
                                <TextBlock Text="{Binding EditBadge}" FontSize="9.5"
                                           LetterSpacing="0.8" Foreground="#12151A"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="12"
                                       IsVisible="{Binding HasSubtitle}"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="Consolas,monospace"/>
                            <TextBlock Text="{Binding Aside}" Classes="faint" FontSize="11.5"
                                       IsVisible="{Binding HasAside}"/>
                            <TextBlock Text="{Binding Description}" Classes="dim" FontSize="12"
                                       TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                            <TextBlock Text="{Binding Headline}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Accent}"
                                       IsVisible="{Binding HasHeadline}"/>
                            <TextBlock Text="{Binding ModNote}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding HasModNote}"
                                       Foreground="{DynamicResource Accent}"/>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border DockPanel.Dock="Top" Padding="14,9" IsVisible="{Binding HasProblem}"
                              Background="{DynamicResource Panel}"
                              BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Accent}"/>
                      </Border>

                      <!-- EDITING THE GAME'S OWN PART. Shown only after Edit is chosen, because
                           this is not the same act as duplicating: the mod ships a rewritten copy
                           of the game's package, so every character already wearing the part
                           changes, and two mods editing it conflict. -->
                      <Border DockPanel.Dock="Top" Padding="14,7" IsVisible="{Binding Editing}"
                              Background="{DynamicResource Panel}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding EditWarning}"/>
                      </Border>

                      <!-- THE SAVE BAR IS PINNED, not the last thing at the bottom of a long
                           scroll. The count answers "what have I actually changed?" — the
                           question a panel this size is asked constantly — and it counts THIS
                           SITTING, so a part carrying an override from last week opens quiet. -->
                      <Border DockPanel.Dock="Bottom" IsVisible="{Binding Editing}" Padding="12,7"
                              Background="{DynamicResource Chrome}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                      VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     IsVisible="{Binding HasDirty}"
                                     Fill="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding DirtyCount}" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}"
                                       IsVisible="{Binding HasDirty}"/>
                            <TextBlock Text="{Binding DirtyCount}" FontSize="11.5" Classes="faint"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasDirty}"/>
                            <TextBlock Text="{Binding DirtyNote}" FontSize="11.5" Classes="faint"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="tiny" Content="Undo all of it" Click="OnUndoPartEdit"
                                    IsEnabled="{Binding HasDirty}"/>
                            <Button Classes="tiny" Content="Stop editing" Click="OnStopPartEdit"/>
                            <Button Classes="tiny" Content="Save changes" FontSize="11.5"
                                    Padding="12,2" Click="OnSavePartEdit"/>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <!-- The sheet is a list of BLOCKS drawn by their type, so a part with
                           nothing to hide contributes no "Hides from the menu" heading at all. -->
                      <TextBlock DockPanel.Dock="Top" Classes="faint" FontSize="11.5"
                                 Margin="14,8" IsVisible="{Binding Loading}"
                                 Text="reading its rows…"/>

                      <!-- rail | the sections | what it is now.
                           Columns 0-3 are Auto and collapse to nothing when nobody is editing,
                           and the read sheet moves from column 2 (spanning the lot) to column 4
                           on the same flag. One sheet, two places — see SheetTab.SheetColumn. -->
                      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">

                        <!-- THE RAIL. What lets this keep growing: the textures, the numbers and
                             the deeper changes still owed are each another LINE here rather than
                             another screenful of scroll. A dot marks a section holding a change
                             that is not saved; a section a part hasn't got is absent, not empty. -->
                        <ScrollViewer Grid.Column="0" IsVisible="{Binding Editing}" Width="190"
                                      Background="{DynamicResource Chrome}">
                          <StackPanel Margin="0,8" Spacing="1">
                            <TextBlock Text="WHAT YOU CAN CHANGE" FontSize="9.5" LetterSpacing="1"
                                       Classes="faint" Margin="12,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding EditSections}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="local:SheetTab+EditSection">
                                  <Border Classes="rail" Tag="{Binding Key}"
                                          Classes.on="{Binding Selected}"
                                          IsVisible="{Binding Present}"
                                          PointerPressed="OnEditRail">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                      <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Fore}"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Count}"
                                                 FontSize="10.5" Classes="faint" Margin="0,0,5,0"
                                                 IsVisible="{Binding HasCount}"
                                                 VerticalAlignment="Center"/>
                                      <Ellipse Grid.Column="2" Width="6" Height="6"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding Changed}"
                                               Fill="{DynamicResource Accent}"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="1" Width="1" IsVisible="{Binding Editing}"
                                Background="{DynamicResource Line}"/>

                        <!-- Horizontal scrolling ON, because the column is a FIXED 880: a card that is
                             the same width whatever the window does is the point, and on a narrow
                             one the alternative to a scrollbar is buttons clipped off the edge
                             where nothing says they exist. -->
                        <ScrollViewer Grid.Column="2" IsVisible="{Binding Editing}"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="14,12,14,4">
                          <!-- CAPPED. A name box has no business being 1,400 pixels wide, and the
                               buttons at the end of a row that wide end up an arm's length from
                               the thing they act on.

                               EVERY CARD BINDS TO THE TAB, not to its section — the head reads
                               SecX.Chevron and hands the section to the handler on its Tag. A
                               card whose DataContext was its section could not reach the fields
                               it holds, which are the tab's. -->
                          <StackPanel Width="880" HorizontalAlignment="Left">

                            <!-- ============================== WHAT IT IS CALLED -->
                            <Border Classes="card" Tag="Identity"
                                    IsVisible="{Binding SecIdentity.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecIdentity}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecIdentity.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="NAME"/>
                                    <TextBlock Grid.Column="2" Text="what the menu shows"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecIdentity.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecIdentity.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <Grid Margin="12" ColumnDefinitions="118,*"
                                      RowDefinitions="Auto,Auto,Auto"
                                      IsVisible="{Binding SecIdentity.Open}">
                                  <TextBlock Text="Name" FontSize="11.5" Classes="dim"
                                             VerticalAlignment="Center"/>
                                  <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                           CornerRadius="0" Width="420" HorizontalAlignment="Left"
                                           Text="{Binding EditName, Mode=TwoWay}"/>
                                  <TextBlock Grid.Row="1" Text="Description" FontSize="11.5"
                                             Classes="dim" Margin="0,8,0,0"
                                             VerticalAlignment="Top"/>
                                  <TextBox Grid.Row="1" Grid.Column="1" FontSize="12" Padding="6,3"
                                           CornerRadius="0" Margin="0,8,0,0" AcceptsReturn="True"
                                           TextWrapping="Wrap" MinHeight="52" Width="600"
                                           HorizontalAlignment="Left"
                                           Text="{Binding EditDescription, Mode=TwoWay}"/>
                                  <TextBlock Grid.Row="2" Text="Long description" FontSize="11.5"
                                             Classes="dim" Margin="0,8,0,0"
                                             VerticalAlignment="Top"
                                             IsVisible="{Binding ShowsLongDescription}"/>
                                  <TextBox Grid.Row="2" Grid.Column="1" FontSize="12" Padding="6,3"
                                           CornerRadius="0" Margin="0,8,0,0" AcceptsReturn="True"
                                           TextWrapping="Wrap" MinHeight="76" Width="600"
                                           HorizontalAlignment="Left"
                                           PlaceholderText="Empty keeps the game's own text"
                                           IsVisible="{Binding ShowsLongDescription}"
                                           Text="{Binding EditLongDescription, Mode=TwoWay}"/>
                                </Grid>
                              </StackPanel>
                            </Border>


                            <!-- ============================== WHO MADE IT
                                 THE MOD'S OWN, and shipped: the author goes into the .uplugin as
                                 CreatedBy, which is what the game's plugin list shows a player.
                                 The version is the project's own bookkeeping and the game never
                                 reads it, which the caption says so nobody hunts for it in a
                                 menu. -->
                            <Border Classes="card" Tag="Made"
                                    IsVisible="{Binding SecMade.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecMade}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecMade.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHO MADE IT"/>
                                    <TextBlock Grid.Column="2" Text="shipped in the plugin"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecMade.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecMade.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecMade.Open}">
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Author" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="300"
                                             HorizontalAlignment="Left"
                                             Text="{Binding EditAuthor, Mode=TwoWay}"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Version" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="110"
                                             HorizontalAlignment="Left"
                                             Text="{Binding EditVersion, Mode=TwoWay}"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="The name above and the description go into the plugin descriptor as FriendlyName and Description; the author becomes CreatedBy. That is what the game's own mod list shows. The version is yours to keep track with — nothing reads it."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS PICTURE
                                 THE SHELF LABEL, and nothing more. Never shipped and the game
                                 never sees it — which is stated, because the author went looking
                                 for exactly this and then for where it appeared in the game. -->
                            <Border Classes="card" Tag="Picture"
                                    IsVisible="{Binding SecPicture.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPicture}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPicture.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="PICTURE"/>
                                    <TextBlock Grid.Column="2" Text="its card on your shelf"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecPicture.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecPicture.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecPicture.Open}">
                                  <Border Classes="row" Classes.mine="{Binding HasModPicture}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <Border Grid.Column="0" Width="60" Height="60"
                                              Background="{DynamicResource Chrome}"
                                              BorderBrush="{DynamicResource Line}"
                                              BorderThickness="1">
                                        <Image Stretch="Uniform" Margin="3"
                                               IsVisible="{Binding HasModPicture}"
                                               Source="{Binding ModPicture}"/>
                                      </Border>
                                      <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="2"
                                                  VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PictureShown}" FontSize="12"
                                                   FontFamily="Consolas,monospace"
                                                   IsVisible="{Binding HasModPicture}"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="{Binding PictureShown}" FontSize="12"
                                                   IsVisible="{Binding !HasModPicture}"
                                                   Classes="faint"/>
                                        <!-- CAPPED, so a wrapped line cannot run up to the
                                             buttons on the right and be read straight through
                                             one of them. The star column ends where they begin
                                             and that is correct; it does not READ correctly. -->
                                        <TextBlock FontSize="10.5" Classes="faint"
                                                   TextWrapping="Wrap" MaxWidth="540"
                                                   HorizontalAlignment="Left"
                                                   Text="Shown on this mod's card under My mods. Without one, the card borrows a picture from something in the mod."/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                  Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tiny" Content="Import…"
                                                Click="OnPickModPicture"/>
                                        <Button Classes="tiny" Content="Use…"
                                                Click="OnUseModPicture"
                                                IsVisible="{Binding $parent[Window].((local:StudioVm)DataContext).HasMyImages}"/>
                                        <Button Classes="tiny" Content="Clear"
                                                Click="OnClearModPicture"
                                                IsVisible="{Binding HasModPicture}"
                                                Foreground="{DynamicResource Accent}"/>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHERE IT SHIPS
                                 THE TWO FIELDS THAT REACH OUTSIDE THE PROJECT FILE, in one card
                                 because they tell one story: the name decides the container, the
                                 pak and the folder the game reads it out of; the asset folder
                                 decides whether the game scans the parts at all.

                                 Both are said in RESOLVED form under the box, because neither is
                                 checkable by reading it back — a wrong folder is a mod that
                                 builds, installs, mounts and is never looked at. -->
                            <Border Classes="card" Tag="Ships"
                                    IsVisible="{Binding SecShips.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecShips}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecShips.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHERE IT SHIPS"/>
                                    <TextBlock Grid.Column="2" Text="the files it builds"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecShips.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecShips.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecShips.Open}">
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Ships as" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="300"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditShipsAs, Mode=TwoWay}"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint"
                                             FontFamily="Consolas,monospace" Margin="118,0,0,0"
                                             Text="{Binding ShipsAsFiles}"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Unique among every mod installed at once — the container id comes from this, so two mods sharing a name cannot sit in a game together. Renaming does not move a copy already installed: take it back out of the game first."/>

                                  <Grid ColumnDefinitions="118,*" Margin="0,6,0,0">
                                    <TextBlock Text="Assets under" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="420"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditFolder, Mode=TwoWay}"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint"
                                             FontFamily="Consolas,monospace" Margin="118,0,0,0"
                                             IsVisible="{Binding !FolderBad}"
                                             Text="{Binding FolderIs}"/>
                                  <TextBlock FontSize="10.5" TextWrapping="Wrap"
                                             Margin="118,0,0,0" Foreground="#F87171"
                                             IsVisible="{Binding FolderBad}"
                                             Text="{Binding FolderWhy}"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="The one lever against two mods colliding: both taking the shared default file their parts at the same package paths, and an id used by both is then a coin toss in the game."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== RECRUIT BY SCRIPT
                                 ONLY FOR A MOD WITH CHARACTERS ON AN ENEMY PAWN. The hiring pool
                                 rolls a recruit's class, tactical spec and weapon spec away
                                 whatever the data says — measured twice in game — and the one
                                 route that keeps them is a UE4SS script recruiting straight from
                                 the pawn class. Absent everywhere else, because a tick that
                                 ships a script with nothing to recruit is a setting somebody
                                 turns on and then cannot explain. -->
                            <Border Classes="card" Tag="Recruit"
                                    IsVisible="{Binding SecRecruit.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecRecruit}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecRecruit.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="RECRUIT BY SCRIPT"/>
                                    <TextBlock Grid.Column="2" Text="needs UE4SS"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecRecruit.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecRecruit.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecRecruit.Open}">
                                  <CheckBox IsChecked="{Binding EditByScript, Mode=TwoWay}"
                                            FontSize="11.5"
                                            Content="Ship a UE4SS script that recruits past the recruitment screen and its roll"/>
                                  <StackPanel Spacing="6" IsVisible="{Binding EditByScript}">
                                    <Grid ColumnDefinitions="118,Auto,20,Auto,Auto,*">
                                      <TextBlock Text="Recruit key" FontSize="11.5" Classes="dim"
                                                 VerticalAlignment="Center"/>
                                      <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                               CornerRadius="0" Width="70"
                                               Text="{Binding EditRecruitKey, Mode=TwoWay}"/>
                                      <TextBlock Grid.Column="3" Text="Repair key" FontSize="11.5"
                                                 Classes="dim" VerticalAlignment="Center"
                                                 Margin="0,0,10,0"/>
                                      <TextBox Grid.Column="4" FontSize="12" Padding="6,3"
                                               CornerRadius="0" Width="70"
                                               Text="{Binding EditRepairKey, Mode=TwoWay}"/>
                                      <TextBlock Grid.Column="5" Text="F1–F12 or one letter"
                                                 FontSize="10.5" Classes="faint" Margin="12,0,0,0"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               Text="{Binding RecruitBlurb}"/>
                                  </StackPanel>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="The Playable Droideka mod's recipe: the script is installed beside the game's exe and adds the character from its pawn class, the way the game adds a story character — so a droid keeps its animations and its action points. UE4SS itself is not installed by this; the install log says whether it is there."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHO THEY ARE
                                 The name and the story, which live on the character's NAME PART
                                 one copy over. They are edited here because this is where a
                                 person looks for them, not on a second tab for an asset whose
                                 existence is a detail of how the game stores a name. -->
                            <Border Classes="card" Tag="Person"
                                    IsVisible="{Binding SecPerson.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPerson}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPerson.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHO THEY ARE"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecPerson.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecPerson.Open}">

                                  <TextBlock Text="{Binding CharNameWarn}" FontSize="11"
                                             TextWrapping="Wrap" MaxWidth="600"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding HasCharNameWarn}"
                                             Foreground="#FBBF24"/>

                                  <Grid ColumnDefinitions="118,Auto,10,Auto">
                                    <TextBlock Text="Name" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="210"
                                             Watermark="First name"
                                             Text="{Binding CharFirst, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="3" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="210"
                                             Watermark="Last name"
                                             Text="{Binding CharLast, Mode=TwoWay}"/>
                                  </Grid>

                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Their story" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Top"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="84" Width="430"
                                             HorizontalAlignment="Left"
                                             Text="{Binding CharStory, Mode=TwoWay}"/>
                                  </Grid>

                                  <TextBlock FontSize="10.5" TextWrapping="Wrap" MaxWidth="600"
                                             Margin="118,0,0,0" HorizontalAlignment="Left"
                                             IsVisible="{Binding NoStoryYet}"
                                             Foreground="#FBBF24"
                                             Text="No story yet. The databank prints an empty biography until you write one."/>

                                  <StackPanel Orientation="Horizontal" Spacing="10"
                                              Margin="118,2,0,0">
                                    <Button Classes="tiny" Content="Save their name"
                                            Click="OnSaveCharacterName"/>
                                    <TextBlock Text="{Binding CharFrom}" FontSize="10.5"
                                               Classes="faint" VerticalAlignment="Center"/>
                                  </StackPanel>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,5"/>

                                  <TextBlock Text="{Binding CharOffered}" FontSize="11"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left" Classes="faint"
                                             IsVisible="{Binding !CharOfferedWarn}"/>
                                  <StackPanel Spacing="3"
                                              IsVisible="{Binding CharOfferedWarn}">
                                    <TextBlock Text="{Binding CharOffered}" FontSize="11.5"
                                               TextWrapping="Wrap" MaxWidth="640"
                                               HorizontalAlignment="Left" Foreground="#F87171"/>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" HorizontalAlignment="Left"
                                               Text="A character nobody is offered is a character nobody meets. The definition builds, the mod installs, and they are simply never in the hiring pool."/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT THEY LOOK LIKE
                                 Every slot the template declares, and what sits in each one.
                                 Choose picks another of the game's parts, Reset puts the
                                 template's back, Empty leaves the slot bare. -->
                            <Border Classes="card" Tag="Look"
                                    IsVisible="{Binding SecLook.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecLook}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecLook.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHAT THEY LOOK LIKE"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecLook.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecLook.Open}">

                                  <TextBlock Text="{Binding LookProblem}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding HasLookProblem}"
                                             Foreground="#F87171"/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             Text="Each slot holds one of the game's parts. Parts of the template's own species are listed first; a face from another species may not fit the body."/>

                                  <TextBlock FontSize="10.5" TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding Bespoke}"
                                             Text="A one piece body, so the game's own databank shows them as NOT EDITABLE with empty headwear and tops. That is the game, not the mod. This card is where their look changes."/>

                                  <CheckBox FontSize="11.5" Click="OnShowEverySlot"
                                            IsChecked="{Binding ShowEverySlot, Mode=TwoWay}"
                                            Content="Show every slot, including the ones that decide species and rig"/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             IsVisible="{Binding ShowEverySlot}"
                                             Text="Changing Species without changing Head, Face, FacialDetails and BodyArt to match is a character that does not load, and filling a Tactical slot is what broke somebody else's mod."/>

                                  <TextBlock FontSize="11" TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Classes="faint"
                                             IsVisible="{Binding PartsWaiting}"
                                             Text="Reading the game's parts so they can be chosen from. Choose turns on when they are there."/>

                                  <TextBlock Text="{Binding SlotNote}" FontSize="11"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#4ADE80"
                                             IsVisible="{Binding HasSlotNote}"/>

                                  <ItemsControl ItemsSource="{Binding LookRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+LookRow">
                                        <StackPanel>
                                          <TextBlock Text="{Binding Shown}" Classes="colhead"
                                                     Margin="0,7,0,3"
                                                     IsVisible="{Binding IsHeader}"/>
                                          <Border Classes="row" Margin="0,0,0,3"
                                                  IsVisible="{Binding IsSlot}">
                                            <Grid ColumnDefinitions="176,*,Auto">
                                              <TextBlock Text="{Binding Shown}" FontSize="11"
                                                         Classes="dim" VerticalAlignment="Center"
                                                         ToolTip.Tip="{Binding Tip}"
                                                         TextTrimming="CharacterEllipsis"/>
                                              <StackPanel Grid.Column="1" Spacing="1"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="{Binding Path}">
                                                <TextBlock Text="{Binding Value}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !Bare}"
                                                           Foreground="{DynamicResource Fore}"/>
                                                <TextBlock Text="(empty)" FontSize="12"
                                                           Classes="faint"
                                                           IsVisible="{Binding Bare}"/>
                                              </StackPanel>
                                              <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                          Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="yours" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding Mine}"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <Button Classes="tiny" Content="Choose"
                                                        Click="OnChooseSlot"
                                                        IsEnabled="{Binding Ready}"/>
                                                <Button Classes="tiny" Content="Reset"
                                                        Click="OnResetSlot"
                                                        IsVisible="{Binding Mine}"/>
                                                <Button Classes="tiny" Content="Empty"
                                                        Click="OnEmptySlot"
                                                        IsVisible="{Binding CanEmpty}"/>
                                              </StackPanel>
                                            </Grid>
                                          </Border>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== HOW THEY PLAY
                                 Seven measured recipes, several still untested in game. The
                                 hiring pool ROLLS a recruit's class, tactical spec and weapon
                                 spec away whatever the data says, so a droid recruited through
                                 it arrives with hero animations and no action points. Each box
                                 is one attempt at getting some of that back, and the line under
                                 each says what was observed rather than what was hoped. -->
                            <Border Classes="card" Tag="Plays"
                                    IsVisible="{Binding SecPlays.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPlays}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPlays.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="HOW THEY PLAY"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecPlays.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="11"
                                            IsVisible="{Binding SecPlays.Open}">

                                  <TextBlock FontSize="11" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="640" HorizontalAlignment="Left"
                                             IsVisible="{Binding NoPlays}"
                                             Text="Nothing here applies to them. They ride a rig the hero pawns already animate and their template carries no enemy kit, so the hiring pool gives them everything they need."/>

                                  <TextBlock Text="{Binding RigWarn}" FontSize="11"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasRigWarn}"/>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowEnemyKit}">
                                    <CheckBox FontSize="11.5" Click="OnPlayEnemyKit"
                                              IsChecked="{Binding PlayEnemyKit, Mode=TwoWay}"
                                              Content="Keep their own class, tactical spec, weapon spec and gear kit"/>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="An enemy's four kit parts are all tagged AuthoredOnly, and its tactical spec sits in a pseudo slot. A recruit is not authored, so the game throws them out and rolls hero ones: hero animations on this rig, and no action points. Seen in game. This is the Playable Droideka mod's fix, done on COPIES so nothing of the game's is written over. Turning it on turns the two experiments below off."/>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowEnemyPawn}">
                                    <CheckBox FontSize="11.5" Click="OnPlayEnemyPawn"
                                              IsChecked="{Binding PlayEnemyPawn, Mode=TwoWay}"
                                              >
                                      <TextBlock Text="{Binding PawnBox}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="The game picks a character's pawn by which definition that pawn declares as its default, so a copy of the enemy's pawn wearing THIS definition puts their own body under them. Sets the row's pawn to the copy and the Faction slot to Zero Company. What the Droideka mod does; its droideka sometimes needed a team fix after spawning, which nothing here can do."/>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowStory}">
                                    <CheckBox FontSize="11.5" Click="OnPlayStory"
                                              IsChecked="{Binding PlayStory, Mode=TwoWay}"
                                              Content="Join by story recipe, no UE4SS"/>
                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" MaxWidth="640"
                                               Margin="26,0,0,0" HorizontalAlignment="Left"
                                               Foreground="#F87171"
                                               Text="UNTESTED, AND IT EDITS NINE OF THE GAME'S OWN CAMPAIGN ASSETS. No campaign cycle has ever ended on a build that was not carrying a known bug, so this has never been seen through. Turn it on only to try it."/>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="A story character never goes through the hiring roll: a RECIPE recruits a pawn class outright, and the campaign draws recipes every cycle from chapter two to six. Ships a pawn class of the mod's own, a copy of Jae's recruit recipe aimed at it, and that recipe added to every scripted turn and each chapter's draw table. They join with their own class, animations, weapon and action points. Not in the tutorial. The hiring pool row stays, so a rolled twin can still turn up."/>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                Margin="26,3,0,0"
                                                IsVisible="{Binding ShowStoryCount}">
                                      <TextBlock Text="How many can join" FontSize="11"
                                                 Classes="dim" VerticalAlignment="Center"/>
                                      <TextBox Width="58" FontSize="12" Padding="6,3"
                                               CornerRadius="0"
                                               Text="{Binding StoryCount, Mode=TwoWay}"
                                               LostFocus="OnStoryCount"/>
                                      <TextBlock FontSize="10.5" Classes="faint"
                                                 VerticalAlignment="Center"
                                                 Text="each one is a recipe of its own, drawn on its own turn. Up to 20."/>
                                    </StackPanel>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowRifle}">
                                    <CheckBox FontSize="11.5" Click="OnPlayRifle"
                                              IsChecked="{Binding PlayRifle, Mode=TwoWay}"
                                              >
                                      <TextBlock Text="{Binding RifleBox}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="A copy of the hero Blaster Rifle specialization keyed to this rig's tag instead, pointing at the rig's own animation table and set. Anyone can equip it in the Armoury; a droid then moves like itself for the basic moves. Meant for a recruit the hiring pool rolled: give them this rifle and the roll's weapon stops mattering. Action points still need the class part."/>
                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" MaxWidth="640"
                                               Margin="26,3,0,0" HorizontalAlignment="Left"
                                               Foreground="#4ADE80"
                                               Text="CONFIRMED IN GAME, and this box is only half of it: the weapon also has to be made SELECTABLE in the Armoury, from the Weapons tab's 'make this playable', and then equipped on them in game. Do both and the droid gets its own animations. Neither half does it on its own."/>

                                    <StackPanel Spacing="2" Margin="26,6,0,0"
                                                IsVisible="{Binding ShowOwnGun}">
                                      <CheckBox FontSize="11.5" Click="OnPlayOwnGun"
                                                IsChecked="{Binding PlayOwnGun, Mode=TwoWay}"
                                                >
                                        <TextBlock Text="{Binding OwnGunBox}" TextWrapping="Wrap"/>
                                      </CheckBox>
                                      <TextBlock FontSize="10.5" Classes="faint"
                                                 TextWrapping="Wrap" MaxWidth="614"
                                                 Margin="26,0,0,0" HorizontalAlignment="Left"
                                                 Text="The blaster is a copy of the game's rifle CLASS, and a class lists every gear kit tagged for it, so it listed every rifle. This gives the blaster a class tag of its own and ships one gear kit carrying it: the gun the rig's own kit spawns, made equippable. Same recipe as a custom weapon class, which is proven in game."/>
                                    </StackPanel>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowTactical}">
                                    <CheckBox FontSize="11.5" Click="OnPlayTactical"
                                              IsChecked="{Binding PlayTactical, Mode=TwoWay}"
                                              >
                                      <TextBlock Text="{Binding TacticalBox}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="An enemy's move, turn and action point basics ride on its tactical spec. Measured in game on fresh recruits: with a legal copy of it a droid had action points; with the hero class part instead, none. Read off a save, the hiring roll REPLACES the Tactical slot on a pool recruit, so only a story recruit keeps this. For a pool recruit, the spare slot box below carries it where the roll cannot reach."/>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowRigAnim}">
                                    <CheckBox FontSize="11.5" Click="OnPlayRigAnim"
                                              IsChecked="{Binding PlayRigAnim, Mode=TwoWay}"
                                              >
                                      <TextBlock Text="{Binding RigAnimBox}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="Their name part is copied from one that carries an animation table, and the table is repointed at this rig's rifle table, which maps the same 41 keys the hero one does. In game: he flickers into his own clips and back. The table is read; the animation SET is still the hero weapon spec's. Rifles only. The weapon route above is the one that works, so try that first."/>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding ShowSpareSpec}">
                                    <CheckBox FontSize="11.5" Click="OnPlaySpareSpec"
                                              IsChecked="{Binding PlaySpareSpec, Mode=TwoWay}"
                                              Content="Also carry that tactical spec in a spare slot (experimental)"/>
                                    <TextBlock Text="{Binding SpareSays}" FontSize="10.5"
                                               Classes="faint" TextWrapping="Wrap" MaxWidth="640"
                                               Margin="26,0,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" Margin="26,0,0,0"
                                               HorizontalAlignment="Left"
                                               Text="Read off a save of a fresh recruit with no action points: nothing left on him granted the basics. Confirmed in game: the game does apply a part's fragments from a slot it was not meant for, and a recruit hired with this ticked arrives with action points. A story recruit would carry the basics twice."/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== MAKE THEM AGAIN
                                 Shown only when one of their features was built by an older
                                 recipe. A button offering to rebuild what is already current is
                                 a button whose only possible outcome is doubt. -->
                            <Border Classes="card" Tag="Remake"
                                    IsVisible="{Binding SecRemake.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecRemake}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecRemake.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="MAKE THEM AGAIN"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecRemake.Open}">

                                  <TextBlock Text="{Binding RemakeSays}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="640" HorizontalAlignment="Left"
                                             Text="Takes each of these away and builds it again with the recipe this version ships. What is ticked stays ticked, and nothing else is touched: not their name, their outfit, the slots you set by hand, or any other character. A copy with no version recorded counts as older, because it was made before the tool kept track and there is no way to show it matches what the boxes build now."/>

                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="tiny" Content="Make them again"
                                            Click="OnRemakeCharacter"
                                            IsEnabled="{Binding RemakeReady}"/>
                                    <TextBlock FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !RemakeReady}"
                                               Text="still reading the game…"/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IT CHANGES
                                 AN OVERRIDE ONLY. A copy cooks to an asset name of its own and
                                 replaces nothing, so it has no target to show. The clash line is
                                 the reason this card exists: two installed mods claiming one
                                 package both build, both verify, and the game reads whichever it
                                 mounted last — which is invisible from inside one project and
                                 cost most of a day when two mods claimed the character pool. -->
                            <Border Classes="card" Tag="Changes"
                                    IsVisible="{Binding SecChanges.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecChanges}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecChanges.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHAT IT CHANGES"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecChanges.Open}">

                                  <TextBlock Text="{Binding ChangesSays}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left"/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="640" HorizontalAlignment="Left"
                                             Text="The game package this replaces, by full package name — for example /Game/Game/Customizations/Characters/Humanoid/Outfit/01/CPD_H_Outfit_01A_HELM. Change it to point this override at a different asset; the panel goes on showing the one you opened, so open the new asset to edit it here. A build refuses a name the game has no file at, so a typo cannot ship."/>

                                  <TextBox Text="{Binding EditTarget, Mode=TwoWay}"
                                           FontSize="11" MaxWidth="640"
                                           HorizontalAlignment="Stretch"/>

                                  <TextBlock Text="{Binding ChangesClash}" FontSize="11"
                                             IsVisible="{Binding HasChangesClash}"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== OFFER THEM AGAIN
                                 A RECRUIT THAT HAS GONE QUIET, given a new identity.
                                 Measured in game 2026-09-20: a pool row can stop being drawn
                                 while everything about it is still correct, and no edit to its
                                 data brings it back — the same character under a new asset name
                                 and a new row name is offered immediately. Present for any
                                 character this mod offers in a pool, because there is no way to
                                 detect the condition from here; the author is the one who can
                                 see that they never come up. -->
                            <Border Classes="card" Tag="Offer"
                                    IsVisible="{Binding SecOffer.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecOffer}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecOffer.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="OFFER THEM AGAIN"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecOffer.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="640" HorizontalAlignment="Left"
                                             Text="Use this if they have stopped appearing in the recruitment pool. A row can go quiet while everything about it is still right, and changing their data does not bring it back — the same character under a new asset name and a new row name is offered again straight away. Nothing about them changes: their name, look, class, weapon, animations and the pawn they spawn on are all kept exactly as they are. Build and install afterwards. Why it happens is not known, so this is a remedy rather than a fix."/>

                                  <TextBlock Text="{Binding OfferSays}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="640"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"/>

                                  <Button Classes="tiny" Content="Offer them again"
                                          Click="OnOfferAgain" HorizontalAlignment="Left"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHERE IT GOES
                                 A COPY ONLY. An override changes the game's own part in place —
                                 it cannot move it to another slot, hide a different head, or
                                 hand it to another character. Absent there rather than present
                                 and inert. -->
                            <Border Classes="card" Tag="Where"
                                    IsVisible="{Binding SecWhere.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecWhere}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecWhere.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="SLOT"/>
                                    <TextBlock Grid.Column="2" Text="the slot, and who may wear it"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="8"
                                            IsVisible="{Binding SecWhere.Open}">

                                  <Grid ColumnDefinitions="118,Auto,Auto" >
                                    <TextBlock Text="Slot" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}"
                                              SelectedItem="{Binding EditSlot, Mode=TwoWay}"
                                              MinWidth="170" MinHeight="0" FontSize="12"
                                              Padding="6,2" CornerRadius="0"/>
                                    <!-- Only in an OUTFIT slot (SheetTab.ShowsHidesHead): a head
                                         is the face, and hair, brows, horns and the rest are drawn
                                         on it, so the box means nothing there. -->
                                    <CheckBox Grid.Column="2" Margin="14,0,0,0" FontSize="11.5"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding ShowsHidesHead}"
                                              IsChecked="{Binding EditHidesHead, Mode=TwoWay}"
                                              Content="Hides the head"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding ShowsHidesHead}"
                                             Text="A helmet needs the head hidden. Without it the character's face and hair render through the visor."/>
                                  <!-- A limit of the CHOSEN slot, said before the build rather
                                       than found on the wrong head afterwards. Empty (and so
                                       hidden) for every slot but the one that has one. -->
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="{Binding SlotLimit}"
                                             IsVisible="{Binding HasSlotLimit}"/>

                                  <Grid ColumnDefinitions="118,Auto">
                                    <TextBlock Text="For character" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Characters}"
                                              SelectedItem="{Binding EditForCharacter, Mode=TwoWay}"
                                              PlaceholderText="everyone"
                                              MinWidth="230" MinHeight="0" FontSize="12"
                                              Padding="6,2" CornerRadius="0"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="“everyone” is almost always right. Choosing a name writes that character's tag onto the part and takes any other one off, so it means exactly that character — and note it does not un-restrict anything by itself: a copy of a hero's gear inherits their name tag."/>

                                  <!-- WHAT IT TAKES OVER. The clone legs replace the wearer's
                                       boots, and a duplicate of them inherits that — an author
                                       who wanted the legs got a part that silently deletes
                                       whatever boots the player picked, with no way to say
                                       otherwise. Ticked means "as the template has it". -->
                                  <StackPanel Spacing="4" IsVisible="{Binding HasTakeovers}"
                                              Margin="0,4,0,0">
                                    <TextBlock Classes="faint" FontSize="11"
                                               Text="It takes these slots over"/>
                                    <ItemsControl ItemsSource="{Binding Takeovers}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:SheetTab+TakeoverRow">
                                          <Border Classes="row" Padding="9,5" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,200,*">
                                              <CheckBox IsChecked="{Binding Kept, Mode=TwoWay}"
                                                        MinWidth="0" Margin="0,0,4,0"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Slot}"
                                                         FontSize="12" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Grid.Column="2" Text="{Binding Kind}"
                                                         FontSize="10.5" Classes="faint"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               Text="Untick one to leave that slot alone — what the player already wears there stays."/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS MESHES
                                 Every body type this part carries, at once. The old studio made
                                 you click into each mesh to reach its own editor; a helmet with a
                                 feminine and a masculine mesh is one part with two rows here. -->
                            <Border Classes="card" Tag="Meshes"
                                    IsVisible="{Binding SecMeshes.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecMeshes}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecMeshes.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="MESHES"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MeshesAre}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecMeshes.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecMeshes.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecMeshes.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding HasMeshRows}"
                                             Text="Pick re-points this at another of the game's meshes; Import puts your own FBX over it; View opens it in the 3D tab — the only way to check an import arrived as what you meant."/>

                                  <!-- A WEAPON MISSING PIECES OF ITS MODEL, and the repair.
                                       Assembled from one part per slot, each of which has to be
                                       the mod's own copy: missing one shows NOTHING in that slot
                                       in the game — a receiver floating with no barrel — and
                                       nothing said so until the build ran. -->
                                  <Border Classes="row" Margin="0,0,0,4"
                                          IsVisible="{Binding ModelIncomplete}"
                                          BorderBrush="{DynamicResource Accent}">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Accent}"
                                                 Text="{Binding ModelGapSays}"/>
                                      <Button Grid.Column="1" Classes="tiny" Margin="10,0,0,0"
                                              Content="Complete the model"
                                              Click="OnCompleteWeaponModel"/>
                                    </Grid>
                                  </Border>

                                  <ItemsControl ItemsSource="{Binding MeshRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+MeshRow">
                                        <!-- A CHANGED ROW LOOKS CHANGED: accent edge, what it now
                                             is, and the way back put where the change was made. -->
                                        <Border Classes="row" Margin="0,0,0,6"
                                                Classes.mine="{Binding Mine}">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                              <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Variant}" FontSize="12"
                                                           Foreground="{DynamicResource Fore}"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           Classes="faint"
                                                           IsVisible="{Binding !Mine}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           IsVisible="{Binding Mine}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}"/>
                                              </StackPanel>
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                           Classes="faint"
                                                           IsVisible="{Binding !Mine}"
                                                           FontFamily="Consolas,monospace"/>
                                                <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                           IsVisible="{Binding Mine}"
                                                           FontFamily="Consolas,monospace"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Classes="faint"
                                                           IsVisible="{Binding Mine}"/>
                                              </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                              <Button Classes="tiny" Content="Pick…"
                                                      Click="OnPickMeshRow"/>
                                              <Button Classes="tiny" Content="Import…"
                                                      Click="OnImportMeshRow"/>
                                              <Button Classes="tiny" Content="View"
                                                      Click="OnViewMeshRow"/>
                                              <Button Classes="tiny" Content="Revert"
                                                      IsVisible="{Binding Mine}"
                                                      Click="OnRevertMeshRow"
                                                      Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- The part-level mesh, for the things that carry no body-type
                                       rows at all. Absent when the rows above cover it, because
                                       two ways to say the same thing is how a project ends up
                                       with two answers. -->
                                  <Grid ColumnDefinitions="118,*"
                                        IsVisible="{Binding !HasMeshRows}">
                                    <TextBlock Text="Mesh (FBX)" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Width="560"
                                          HorizontalAlignment="Left">
                                      <TextBox Grid.Column="0" FontSize="12" Padding="5,2"
                                               CornerRadius="0"
                                               Watermark="the game's own geometry"
                                               Text="{Binding EditMesh, Mode=TwoWay}"/>
                                      <Button Grid.Column="1" Classes="tiny" Content="Import…"
                                              Margin="5,0,0,0" Click="OnPickPartMesh"/>
                                    </Grid>
                                  </Grid>

                                  <!-- Sits with the meshes it qualifies. The importer refuses a
                                       wild size change by default, because one is almost always
                                       an export at the wrong unit scale rather than an intent. -->
                                  <CheckBox IsChecked="{Binding EditAnySize, Mode=TwoWay}"
                                            FontSize="11.5" Margin="0,2,0,0"
                                            Content="Let a replacement be a very different size"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>


                            <!-- ============================== HOW IT FITS
                                 THE THREE FIELDS AND THE MEASUREMENT ARE ONE FEATURE. On their
                                 own the axis mapping, the centimetres per unit and the nudge are
                                 three numbers with no way to know what to put in them; the
                                 measurement is what makes them answerable.

                                 Without it the loop is export, build, install, launch, squint,
                                 guess again. Every number here is knowable before the game runs,
                                 so it is shown before the game runs. -->
                            <Border Classes="card" Tag="Fit"
                                    IsVisible="{Binding SecFit.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecFit}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecFit.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="HOW IT FITS"/>
                                    <TextBlock Grid.Column="2" Text="your model against the game's"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecFit.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecFit.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecFit.Open}">

                                  <!-- WHICH PIECE IS BEING PLACED. The five fields describe how
                                       to put ONE file where the game's mesh was, so a garment
                                       with two imported pieces has two answers and the card has
                                       to say which it is giving. Hidden when there is only one
                                       thing it could be placing. -->
                                  <StackPanel Orientation="Horizontal" Spacing="8"
                                              IsVisible="{Binding HasFitPieces}">
                                    <TextBlock Text="Piece" FontSize="11" Classes="faint"
                                               VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding FitPieces}"
                                              SelectedItem="{Binding FitPiece, Mode=TwoWay}"
                                              FontSize="11" MinHeight="0" Padding="7,2"/>
                                    <TextBlock Text="{Binding FitPieceSays}" FontSize="10.5"
                                               Classes="faint" VerticalAlignment="Center"/>
                                  </StackPanel>

                                  <!-- THE MEASUREMENT. Counts, then the two boxes side by side,
                                       with how many times the size yours is. -->
                                  <TextBlock Text="{Binding FitCounts}" FontSize="11.5"
                                             FontFamily="Consolas,monospace" Classes="faint"/>

                                  <Grid ColumnDefinitions="90,*" IsVisible="{Binding CanFit}">
                                    <TextBlock Text="template" FontSize="11" Classes="faint"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FitTemplate}"
                                               FontSize="11.5" Classes="faint"
                                               FontFamily="Consolas,monospace"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="90,*" IsVisible="{Binding CanFit}">
                                    <TextBlock Text="yours" FontSize="11" Classes="faint"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FitYours}"
                                               FontSize="11.5"
                                               FontFamily="Consolas,monospace"
                                               IsVisible="{Binding !FitOff}"
                                               Classes="faint"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FitYours}"
                                               FontSize="11.5"
                                               FontFamily="Consolas,monospace"
                                               IsVisible="{Binding FitOff}"
                                               Foreground="#FBBF24"/>
                                  </Grid>

                                  <!-- THE BUILD'S OWN REFUSAL BAND, at exactly the build's
                                       numbers. It ships the GAME's mesh in place of one outside
                                       it and prints a single line in a long log; an author who
                                       misses that gets a mod that builds clean with none of
                                       their model in it. -->
                                  <Border Padding="9,7" Background="{DynamicResource Raised}"
                                          BorderBrush="#F87171" BorderThickness="2,1,1,1"
                                          IsVisible="{Binding FitRefused}">
                                    <StackPanel Spacing="7">
                                      <TextBlock Text="{Binding FitRefuse}" FontSize="11.5"
                                                 TextWrapping="Wrap" MaxWidth="760"
                                                 HorizontalAlignment="Left"
                                                 Foreground="#F87171"/>
                                      <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button Classes="tiny" Content="Match the template's height"
                                                Click="OnFitScale"
                                                IsVisible="{Binding HasFitWants}"/>
                                        <Button Classes="tiny" Content="Pin the scale to 1"
                                                Click="OnFitPinOne"/>
                                      </StackPanel>
                                      <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                                 MaxWidth="760" HorizontalAlignment="Left"
                                                 Text="Two different fixes. Matching the height is right for one piece replacing one piece, and WRONG for a model split into several — each piece would get a different number and they would stop lining up with each other; give a set the same scale and check the centres, not the sizes. Pinning to 1 turns off the multiplier this tool applies when your file's own node says 1.0, which is the fix when you modelled at the game's size rather than in metres."/>
                                    </StackPanel>
                                  </Border>

                                  <!-- PLACING IT. Two buttons, because a mesh of a different
                                       shape cannot match at the centre AND at the bottom, and
                                       which is right depends on the piece: a helmet rests on a
                                       head, a pauldron hangs off a shoulder. -->
                                  <StackPanel Orientation="Horizontal" Spacing="7"
                                              IsVisible="{Binding CanFit}">
                                    <Button Classes="tiny" Content="Centre on the template"
                                            Click="OnFitCentre"/>
                                    <Button Classes="tiny" Content="Rest on the template"
                                            Click="OnFitRest"/>
                                    <Button Classes="tiny" Content="No move"
                                            Click="OnFitClear"/>
                                  </StackPanel>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>

                                  <Grid ColumnDefinitions="118,Auto,Auto,Auto,*">
                                    <TextBlock Text="Axes" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Width="90" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             FontFamily="Consolas,monospace"
                                             Watermark="XZY"
                                             Text="{Binding EditBasis, Mode=TwoWay}"
                                             LostFocus="OnFitBasis"/>
                                    <TextBlock Grid.Column="2" Text="cm per unit" FontSize="11.5"
                                               Classes="dim" Margin="18,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Width="100" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             FontFamily="Consolas,monospace"
                                             Watermark="the default"
                                             Text="{Binding EditScale, Mode=TwoWay}"
                                             LostFocus="OnFitScaleTyped"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="700"
                                             HorizontalAlignment="Left"
                                             Text="Axes say how the file's map onto Unreal's: XZY means Unreal's Y comes from the file's Z, and a minus flips one, as in -X-ZY."/>

                                  <Grid ColumnDefinitions="118,Auto,Auto,Auto,*" Margin="0,4,0,0">
                                    <TextBlock Text="Move (cm)" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Width="84" FontSize="12"
                                             Padding="6,3" CornerRadius="0" Margin="0,0,6,0"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditMoveX, Mode=TwoWay}"
                                             LostFocus="OnFitMoveX"/>
                                    <TextBox Grid.Column="2" Width="84" FontSize="12"
                                             Padding="6,3" CornerRadius="0" Margin="0,0,6,0"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditMoveY, Mode=TwoWay}"
                                             LostFocus="OnFitMoveY"/>
                                    <TextBox Grid.Column="3" Width="84" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditMoveZ, Mode=TwoWay}"
                                             LostFocus="OnFitMoveZ"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="700"
                                             HorizontalAlignment="Left"
                                             Text="Unreal's axes: X forward, Y right, Z up. Applied after scaling, because scaling pivots about the origin and slides the mesh with it."/>

                                  <ItemsControl ItemsSource="{Binding FitNotes}"
                                                IsVisible="{Binding HasFitNotes}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="#FBBF24"/>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS PICTURE -->
                            <Border Classes="card" Tag="Icon"
                                    IsVisible="{Binding SecIcon.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecIcon}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecIcon.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="ICON"/>
                                    <TextBlock Grid.Column="2" Text="the card in the menu"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecIcon.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecIcon.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecIcon.Open}">

                                  <!-- THE BANK TAG, when the template names its picture by one.
                                       A gear kit draws its armoury icon through a shared image
                                       bank rather than from an asset path, and changing it is a
                                       re-point of the donor's tag — which until now meant knowing
                                       that, knowing the donor's tag, and typing it by hand.
                                       Absent when the template names no icon by tag, which is
                                       most things: a row that can do nothing still reads as a
                                       feature. -->
                                  <StackPanel Orientation="Horizontal" Spacing="9"
                                              IsVisible="{Binding HasBankIcon}">
                                    <TextBlock Text="From the game's icons" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fore}"/>
                                    <TextBlock Text="{Binding BankIconSays}" FontSize="10.5"
                                               Classes="faint" VerticalAlignment="Center"/>
                                    <Button Classes="tiny" Content="Choose…" Click="OnPickBankIcon"/>
                                  </StackPanel>

                                  <!-- A TEXTURE ROW, like the ones below it. The picture IS a
                                       texture — it just is not one the MESH wears, so following
                                       the material chain never reaches it and it is asked for
                                       separately. Same row, same three buttons, same meaning. -->
                                  <Border Classes="row" DataContext="{Binding IconRow}"
                                          IsVisible="{Binding $parent[StackPanel].((local:SheetTab)DataContext).HasIconRow}"
                                          Classes.mine="{Binding Mine}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <!-- YOUR picture once there is one, the game's until then.
                                           Two images rather than one with a fallback, because a
                                           computed fallback has to be re-raised when the game's
                                           own thumbnail finishes loading and a missed raise
                                           leaves the card showing nothing. -->
                                      <Border Grid.Column="0" Width="60" Height="60"
                                              Background="{DynamicResource Chrome}"
                                              BorderBrush="{DynamicResource Line}"
                                              BorderThickness="1">
                                        <Panel>
                                          <Image Stretch="Uniform" Margin="3"
                                                 IsVisible="{Binding $parent[StackPanel].((local:SheetTab)DataContext).HasIconPreview}"
                                                 Source="{Binding $parent[StackPanel].((local:SheetTab)DataContext).IconPreview}"/>
                                          <Image Stretch="Uniform" Margin="3"
                                                 IsVisible="{Binding !$parent[StackPanel].((local:SheetTab)DataContext).HasIconPreview}"
                                                 Source="{Binding $parent[StackPanel].((local:SheetTab)DataContext).Icon}"/>
                                        </Panel>
                                      </Border>
                                      <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="1"
                                                  VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                          <TextBlock Text="{Binding Slot}" FontSize="12"
                                                     Foreground="{DynamicResource Fore}"/>
                                          <TextBlock Text="{Binding Kind}" FontSize="10"
                                                     Classes="faint" IsVisible="{Binding !Mine}"
                                                     VerticalAlignment="Center"/>
                                          <TextBlock Text="{Binding Kind}" FontSize="10"
                                                     IsVisible="{Binding Mine}"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Accent}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                          <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                     Classes="faint" IsVisible="{Binding !Mine}"
                                                     FontFamily="Consolas,monospace"/>
                                          <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                     IsVisible="{Binding Mine}"
                                                     FontFamily="Consolas,monospace"
                                                     Foreground="{DynamicResource Accent}"/>
                                          <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                     Classes="faint"/>
                                        </StackPanel>
                                        <!-- WHAT IT DOES DEPENDS ON WHICH EDIT THIS IS: an
                                             override writes into the game's texture, a copy
                                             names its own picture. Same row, opposite promise. -->
                                        <TextBlock FontSize="10.5" Classes="faint"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding $parent[StackPanel].((local:SheetTab)DataContext).PictureBlurb}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                  Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tiny" Content="Pick…"
                                                Click="OnPickTextureRow"
                                                IsVisible="{Binding CanPick}"/>
                                        <Button Classes="tiny" Content="Import…"
                                                Click="OnPickPartIcon"/>
                                        <Button Classes="tiny" Content="Use…"
                                                Click="OnUsePartIcon"
                                                IsVisible="{Binding $parent[Window].((local:StudioVm)DataContext).HasMyImages}"/>
                                        <Button Classes="tiny" Content="View"
                                                Click="OnViewTextureRow"/>
                                        <Button Classes="tiny" Content="Revert"
                                                IsVisible="{Binding Mine}"
                                                Click="OnRevertPartIcon"
                                                Foreground="{DynamicResource Accent}"/>
                                      </StackPanel>
                                    </Grid>
                                  </Border>

                                  <!-- NAMED BY A TAG, not by a texture. Not a failure to read
                                       anything: there is genuinely nothing to import over, and
                                       saying so beats a button that does nothing. -->
                                  <Border Classes="row" IsVisible="{Binding !HasIconRow}">
                                    <Grid ColumnDefinitions="Auto,*">
                                      <Border Grid.Column="0" Width="60" Height="60"
                                              Background="{DynamicResource Chrome}"
                                              BorderBrush="{DynamicResource Line}"
                                              BorderThickness="1">
                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3"/>
                                      </Border>
                                      <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="11"
                                                 Classes="faint" TextWrapping="Wrap"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding IconNote}"/>
                                    </Grid>
                                  </Border>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS TEXTURES
                                 The old studio called this Materials, and it is the half of the
                                 editor that makes an imported mesh usable: import your geometry
                                 in the card above, tab to the viewport to check it arrived, come
                                 back here and paint it. Every texture the part's MESHES wear,
                                 one row per texture package — a kit whose five regions share one
                                 diffuse is one row, not five fields writing to one override. -->
                            <Border Classes="card" Tag="Textures"
                                    IsVisible="{Binding SecTextures.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecTextures}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecTextures.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="TEXTURES"/>
                                    <TextBlock Grid.Column="2" Text="what the meshes above wear"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecTextures.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecTextures.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecTextures.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Import puts your pixels into the texture itself, so everything in the game that samples it changes. The size and format beside each row are what a replacement has to fit — they come from the texture being replaced, not from your file. View opens it in the 2D tab, where the channels can be split apart."/>

                                  <!-- ONE BLOCK PER MATERIAL SLOT, which is how the thing is
                                       actually built: a mesh wears a material per slot, and a
                                       slot either carries the author's paint or NAMES one of
                                       the game's materials and wears it whole. A flat list of
                                       textures could say the first and not the second. -->
                                  <ItemsControl ItemsSource="{Binding MaterialGroups}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+MaterialGroup">
                                        <StackPanel Margin="0,0,0,10" Spacing="5">

                                          <Grid ColumnDefinitions="*,Auto" Margin="1,4,1,0">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                              <TextBlock Text="{Binding Title}" FontSize="11"
                                                         LetterSpacing="0.5"
                                                         Foreground="{DynamicResource Accent}"/>
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Wears:" FontSize="10.5"
                                                           Classes="faint"/>
                                                <TextBlock Text="{Binding Wears}" FontSize="10.5"
                                                           Classes="dim"
                                                           TextTrimming="CharacterEllipsis"/>
                                              </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                              <Button Classes="tiny" Content="Choose…"
                                                      Click="OnChooseMaterial"/>
                                              <Button Classes="tiny" Content="Clear"
                                                      IsVisible="{Binding Named}"
                                                      Click="OnClearMaterial"
                                                      Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                          </Grid>

                                          <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate DataType="local:SheetTab+TextureRow">
                                        <Border Classes="row" Margin="0,0,0,6"
                                                Classes.mine="{Binding Mine}">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                              <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Slot}" FontSize="12"
                                                           Foreground="{DynamicResource Fore}"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           Classes="faint"
                                                           IsVisible="{Binding !Mine}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           IsVisible="{Binding Mine}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}"/>
                                              </StackPanel>
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                           Classes="faint"
                                                           IsVisible="{Binding !Mine}"
                                                           FontFamily="Consolas,monospace"/>
                                                <TextBlock Text="{Binding Shown}" FontSize="10.5"
                                                           IsVisible="{Binding Mine}"
                                                           FontFamily="Consolas,monospace"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Classes="faint"/>
                                              </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                              <Button Classes="tiny" Content="Pick…"
                                                      Click="OnPickTextureRow"
                                                      IsVisible="{Binding CanPick}"/>
                                              <Button Classes="tiny" Content="Import…"
                                                      Click="OnImportTextureRow"/>
                                              <!-- One this mod already holds. Absent until there
                                                   is one, so a fresh mod carries no button that
                                                   opens an empty list. -->
                                              <Button Classes="tiny" Content="Use…"
                                                      Click="OnUseTextureRow"
                                                      IsVisible="{Binding $parent[Window].((local:StudioVm)DataContext).HasMyImages}"/>
                                              <Button Classes="tiny" Content="View"
                                                      Click="OnViewTextureRow"/>
                                              <Button Classes="tiny" Content="Revert"
                                                      IsVisible="{Binding Mine}"
                                                      Click="OnRevertTextureRow"
                                                      Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>

                                          <!-- WHAT THE MESH CALLS THIS SLOT. The tint fragment
                                               names its target slots on a GAME Blueprint a mod
                                               cannot add to, so making a second slot answer to
                                               the name already there is the only route there
                                               is — and until this box existed there was no way
                                               to reach it. -->
                                          <StackPanel Orientation="Horizontal" Spacing="7"
                                                      Margin="1,0,0,0">
                                            <TextBlock Text="Tint slot:" FontSize="10.5"
                                                       Classes="faint"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Width="190" FontSize="11"
                                                     Padding="6,2" MinHeight="0"
                                                     FontFamily="Consolas,monospace"
                                                     Watermark="{Binding PlannedShown}"
                                                     Text="{Binding SlotName, Mode=TwoWay}"
                                                     LostFocus="OnMaterialSlotName"/>
                                            <TextBlock Text="takes no tint" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding TakesNoTint}"
                                                       Foreground="{DynamicResource Accent}"/>
                                          </StackPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- ONE PER MATERIAL GROUP IN YOUR FILE. A model with more
                                       pieces than the one it replaces needs the slots made for
                                       it, or every extra piece wears the first slot's paint. -->
                                  <StackPanel Orientation="Horizontal" Spacing="8"
                                              IsVisible="{Binding CanAddMaterial}">
                                    <Button Classes="tiny" Content="Add another material"
                                            Click="OnAddMaterial"/>
                                    <TextBlock FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               Text="for a model with more material groups than the one it replaces"/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>




                            <!-- ============================== THE BRIEFING
                                 The words the briefing screen prints, and the objectives it
                                 lists. The picture lives here too, because on the card it IS
                                 part of the briefing. -->
                            <Border Classes="card" Tag="Briefing"
                                    IsVisible="{Binding SecBriefing.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecBriefing}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecBriefing.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="BRIEFING"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecBriefing.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecBriefing.Open}">
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Briefing" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Top"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="76" Width="640"
                                             HorizontalAlignment="Left"
                                             Text="{Binding EditBriefing, Mode=TwoWay}"/>
                                  </Grid>

                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Picture" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="500"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Watermark="keeps the donor's"
                                             Text="{Binding EditThumbnail, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickThumbnail" VerticalAlignment="Center"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Bank tag" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="500"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Watermark="what the card falls back to"
                                             Text="{Binding EditBankTag, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickBankTag" VerticalAlignment="Center"/>
                                  </Grid>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock Text="Objectives, as the briefing lists them"
                                             FontSize="11" Classes="dim"/>
                                  <ItemsControl ItemsSource="{Binding Objectives}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+LineRow">
                                        <Border Classes="row" Margin="0,0,0,3">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding Shown}" FontSize="12"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Text="{Binding Value}" FontSize="10"
                                                         Classes="faint"
                                                         FontFamily="Consolas,monospace"
                                                         IsVisible="{Binding Long}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="tiny" Content="Remove"
                                                    Click="OnDropMissionLine"
                                                    VerticalAlignment="Center"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button Classes="tiny" Content="Add an objective"
                                          Click="OnAddObjective" HorizontalAlignment="Left"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHERE IT IS FOUGHT
                                 THE PLANET IS A ROW NAME, not free text, and the location table
                                 moves with it: a planet is a row of a particular region table
                                 and keeping the donor's while changing the row names a row that
                                 table does not have.

                                 THE MAP IS THE ONE PART NOBODY CAN AUTHOR. Objective actors,
                                 spawn points and reinforcement pins live in the level, so this
                                 is a thing you choose. Picking Brentaal's map means inheriting
                                 Brentaal's objective actors, which is the single most surprising
                                 thing in this editor and is therefore said on the screen. -->
                            <Border Classes="card" Tag="Place"
                                    IsVisible="{Binding SecPlace.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPlace}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPlace.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHERE IT IS FOUGHT"/>
                                    <TextBlock Grid.Column="2" Text="the planet, and the map"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecPlace.Open}">
                                  <Grid ColumnDefinitions="118,Auto,*">
                                    <TextBlock Text="Planet" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="260" FontSize="12"
                                              CornerRadius="0" VerticalAlignment="Center"
                                              ItemsSource="{Binding PlanetChoices}"
                                              SelectedItem="{Binding PickedPlanet, Mode=TwoWay}"
                                              SelectionChanged="OnPickPlanet"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LocationTableIs}"
                                               FontSize="10.5" Classes="faint" Margin="11,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Consolas,monospace"/>
                                  </Grid>

                                  <Grid ColumnDefinitions="118,*,Auto"
                                        IsVisible="{Binding HasPlanetNote}">
                                    <TextBlock Grid.Column="1" Text="{Binding PlanetNote}"
                                               FontSize="10.5" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="#FBBF24"/>
                                    <Button Grid.Column="2" Classes="tiny"
                                            Content="Match the planet" Click="OnMatchThePlanet"
                                            VerticalAlignment="Center"/>
                                  </Grid>

                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Region tag" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="420"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditRegionTag, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickRegionTag" VerticalAlignment="Center"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Region" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="420"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditRegionAsset, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickRegionAsset" VerticalAlignment="Center"/>
                                  </Grid>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="The map is the one part of a mission you cannot author: the objective actors, the enemy spawn points and the reinforcement pins are placed in the level itself. You pick which level, and that is enough — the game runs 125 missions on 74 maps. Prefer one that already carries several; it has been made to host more than one."/>

                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Map" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="480" FontSize="12"
                                              CornerRadius="0" HorizontalAlignment="Left"
                                              ItemsSource="{Binding LevelChoices}"
                                              SelectedItem="{Binding PickedLevel, Mode=TwoWay}"
                                              SelectionChanged="OnPickLevel">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="local:SheetTab+Choice">
                                          <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Shown}" FontSize="12"
                                                       FontFamily="Consolas,monospace"/>
                                            <TextBlock Text="{Binding Aside}" FontSize="10.5"
                                                       Classes="faint" VerticalAlignment="Center"/>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                  </Grid>
                                  <TextBlock Text="{Binding LevelNote}" FontSize="10.5"
                                             Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="660"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding HasLevelNote}"/>

                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Map rules" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="420"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditMapConfig, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickMapConfig" VerticalAlignment="Center"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="660"
                                             HorizontalAlignment="Left"
                                             Text="The Blueprint that sets reinforcements, timers and the objective state machines. Almost every mission in the game uses the same one — leave it unless you have a reason."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== THE FIGHT
                                 ONLY THE FACTIONS THAT CAN FIGHT ARE OFFERED. The tag list holds
                                 twelve; five have a FactionData asset, and that asset owns the
                                 spawn sets a level draws from. A mission naming one of the other
                                 seven has no roster at all and spawns nobody, silently, with a
                                 clean build. -->
                            <Border Classes="card" Tag="Fight"
                                    IsVisible="{Binding SecFight.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecFight}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecFight.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="THE FIGHT"/>
                                    <TextBlock Grid.Column="2" Text="who, what, and how many"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecFight.Open}">
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="You fight" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="300" FontSize="12"
                                              CornerRadius="0" HorizontalAlignment="Left"
                                              ItemsSource="{Binding FactionChoices}"
                                              SelectedItem="{Binding PickedFaction, Mode=TwoWay}"
                                              SelectionChanged="OnPickFaction">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="local:SheetTab+Choice">
                                          <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Shown}" FontSize="12"/>
                                            <TextBlock Text="{Binding Aside}" FontSize="10.5"
                                                       Classes="faint" VerticalAlignment="Center"/>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                  </Grid>
                                  <TextBlock Text="{Binding FactionWarn}" FontSize="10.5"
                                             TextWrapping="Wrap" Margin="118,0,0,0"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             IsVisible="{Binding HasFactionWarn}"
                                             Foreground="#F87171"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="660"
                                             HorizontalAlignment="Left"
                                             Text="The number beside each is how many spawn sets it has — the rosters the level's spawners draw from. Kaller 030 and Kaller 040 share one map and fight Separatists and Imperials, so this really does pick the enemies."/>

                                  <Grid ColumnDefinitions="118,Auto,Auto,Auto">
                                    <TextBlock Text="Objective" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="180" FontSize="12"
                                              CornerRadius="0" VerticalAlignment="Center"
                                              ItemsSource="{Binding TypeChoices}"
                                              SelectedItem="{Binding PickedType, Mode=TwoWay}"
                                              SelectionChanged="OnPickType"/>
                                    <TextBlock Grid.Column="2" Text="Difficulty" FontSize="11.5"
                                               Classes="dim" Margin="22,0,11,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" Width="150" FontSize="12"
                                              CornerRadius="0" VerticalAlignment="Center"
                                              ItemsSource="{Binding DifficultyChoices}"
                                              SelectedItem="{Binding PickedDifficulty, Mode=TwoWay}"
                                              SelectionChanged="OnPickDifficulty"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Margin="118,0,0,0" MaxWidth="660"
                                             HorizontalAlignment="Left"
                                             Text="Likely the objective really does drive the mission: Kaller 030, 040 and 045 share one map and are a Capture, a Rescue and a Sabotage. Not yet proven from a mod."/>

                                  <Grid ColumnDefinitions="118,Auto,Auto,Auto,Auto,Auto,*">
                                    <TextBlock Text="Squad" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Width="66" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditMinSquad, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="to" FontSize="11"
                                               Classes="faint" Margin="9,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Width="66" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditMaxSquad, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="4" Text="Stays for" FontSize="11.5"
                                               Classes="dim" Margin="22,0,11,0"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="5" Width="66" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditLifeSpan, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="6" Text="turns before it expires"
                                               FontSize="11" Classes="faint" Margin="11,0,0,0"
                                               VerticalAlignment="Center"/>
                                  </Grid>

                                  <CheckBox IsChecked="{Binding EditBlockActive, Mode=TwoWay}"
                                            FontSize="11.5" Margin="118,4,0,0"
                                            Content="Do not offer it twice at once"/>
                                  <CheckBox IsChecked="{Binding EditBlockDone, Mode=TwoWay}"
                                            FontSize="11.5" Margin="118,0,0,0"
                                            Content="Do not offer it again once completed"/>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock Text="Other tags it carries" FontSize="11"
                                             Classes="dim"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="Beyond the difficulty above. The game uses these to let one mission's outcome be referred to elsewhere — you will rarely need one, and a tag beyond what the mission you copied carries cannot be written."/>
                                  <ItemsControl ItemsSource="{Binding MissionTags}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+LineRow">
                                        <Border Classes="row" Margin="0,0,0,3">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Value}" FontSize="11"
                                                       FontFamily="Consolas,monospace"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Classes="tiny" Content="Remove"
                                                    Click="OnDropMissionLine"
                                                    VerticalAlignment="Center"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button Classes="tiny" Content="Add a tag" Click="OnAddMissionTag"
                                          HorizontalAlignment="Left"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IT PAYS
                                 And what it REMEMBERS: a mission's rewards can carry
                                 CustomReward_IncrementFactValue, and another mission's table row
                                 can require that fact. That pair is the whole of "appears only
                                 after that one" and is the lever an era gate uses. -->
                            <Border Classes="card" Tag="Pays"
                                    IsVisible="{Binding SecPays.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPays}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPays.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHAT IT PAYS"/>
                                    <TextBlock Grid.Column="2" Text="and what it remembers"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecPays.Open}">
                                  <ItemsControl ItemsSource="{Binding Rewards}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+LineRow">
                                        <Border Classes="row" Margin="0,0,0,3">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding Shown}" FontSize="12"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Text="{Binding Value}" FontSize="10"
                                                         Classes="faint"
                                                         FontFamily="Consolas,monospace"
                                                         TextTrimming="CharacterEllipsis"
                                                         IsVisible="{Binding Long}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="tiny" Content="Remove"
                                                    Click="OnDropMissionLine"
                                                    VerticalAlignment="Center"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Button Classes="tiny" Content="Add a reward"
                                          Click="OnAddReward" HorizontalAlignment="Left"/>

                                  <Grid ColumnDefinitions="118,*,Auto" Margin="0,4,0,0">
                                    <TextBlock Text="Reward table" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="500"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditRewardTable, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickRewardTable" VerticalAlignment="Center"/>
                                  </Grid>
                                  <CheckBox IsChecked="{Binding EditPreRoll, Mode=TwoWay}"
                                            FontSize="11.5" Margin="118,0,0,0"
                                            Content="Roll the reward before the mission is offered"/>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <Grid ColumnDefinitions="118,*,Auto">
                                    <TextBlock Text="Raises" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="440"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Watermark="a fact, when it is completed"
                                             Text="{Binding EditFactTag, Mode=TwoWay}"/>
                                    <Button Grid.Column="2" Classes="tiny" Content="Choose…"
                                            Click="OnPickFact" VerticalAlignment="Center"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="118,Auto,*">
                                    <TextBlock Text="by" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Width="66" FontSize="12"
                                             Padding="6,3" CornerRadius="0"
                                             VerticalAlignment="Center"
                                             Text="{Binding EditFactIncrement, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" FontSize="10.5" Classes="faint"
                                               TextWrapping="Wrap" Margin="11,0,0,0"
                                               MaxWidth="600" VerticalAlignment="Center"
                                               Text="Another mission's table row can require this fact, which is the whole of “appears only after that one”."/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>


                            <!-- ============================== WHEN IT TURNS UP
                                 A MISSION THAT EXISTS IS OFFERED TO NOBODY. The galaxy map
                                 places some missions itself and draws the rest from weighted
                                 tables, and neither consults what a mod happens to ship.

                                 THREE ROUTES, IN THE ORDER OF WHAT THEY TAKE AWAY: adding it to
                                 a turn costs nothing; taking a campaign slot costs the game the
                                 mission that sat there; a table row costs nothing and may never
                                 be drawn. -->
                            <Border Classes="card" Tag="When" Margin="0,0,0,20"
                                    IsVisible="{Binding SecWhen.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecWhen}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecWhen.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHEN IT TURNS UP"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecWhen.Count}"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               IsVisible="{Binding NeverOffered}"
                                               Foreground="#F87171"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecWhen.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="8"
                                            IsVisible="{Binding SecWhen.Open}">

                                  <!-- THE ANSWER FIRST. A mission nothing offers builds, installs,
                                       reads back clean and is never drawn, which from the outside
                                       is a mod that did not work. -->
                                  <Border Padding="9,7" Background="{DynamicResource Raised}"
                                          BorderBrush="#F87171" BorderThickness="2,1,1,1"
                                          IsVisible="{Binding NeverOffered}">
                                    <TextBlock Text="{Binding WhenSays}" FontSize="11.5"
                                               TextWrapping="Wrap" MaxWidth="760"
                                               HorizontalAlignment="Left" Foreground="#F87171"/>
                                  </Border>
                                  <TextBlock Text="{Binding WhenSays}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="780"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding !NeverOffered}"
                                             Foreground="#4ADE80"/>

                                  <!-- ROUTE ONE: add it to a turn. Costs nothing and cannot lose,
                                       which is why it is first. -->
                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock Text="ADD IT TO A CAMPAIGN TURN" Classes="sechead"
                                             FontSize="11"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="The surest route, and the only one that takes nothing away: the turn keeps every mission it already placed and gains this one, so it arrives with no table, no weight and no roll. Pick a turn you have NOT reached yet — one that has already run cannot place anything."/>

                                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                          MaxHeight="210" IsVisible="{Binding HasTurns}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                      <ItemsControl ItemsSource="{Binding Turns}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate DataType="local:SheetTab+TurnRow">
                                            <Grid ColumnDefinitions="Auto,90,70,*" Margin="7,3">
                                              <CheckBox IsChecked="{Binding Taken, Mode=TwoWay}"
                                                        Click="OnSetArcAdd" MinWidth="0"
                                                        VerticalAlignment="Center"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Arc}"
                                                         FontSize="11.5" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Grid.Column="2" Text="{Binding Turn}"
                                                         FontSize="11" Classes="faint"
                                                         VerticalAlignment="Center"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Already}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         IsVisible="{Binding !Alone}"
                                                         Classes="faint"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Already}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         IsVisible="{Binding Alone}"
                                                         Foreground="#4ADE80"/>
                                            </Grid>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </ScrollViewer>
                                  </Border>

                                  <!-- ROUTE TWO: take a slot. Certain, and it costs the game the
                                       mission that sat there — so what each one displaces is
                                       named, and the finale is not on offer at all. -->
                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock Text="OR TAKE A CAMPAIGN SLOT" Classes="sechead"
                                             FontSize="11"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="The campaign places 20 missions itself, with no table, no weight and no roll. Take one of those slots and this mission arrives on that turn instead — the only other way to be certain it turns up. It costs the game the mission that sat there, so what each slot displaces is named."/>

                                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                          MaxHeight="210" IsVisible="{Binding HasCampaignSlots}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                      <ItemsControl ItemsSource="{Binding CampaignSlots}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate DataType="local:SheetTab+SlotRow">
                                            <Grid ColumnDefinitions="Auto,230,190,*" Margin="7,3">
                                              <CheckBox IsChecked="{Binding Taken, Mode=TwoWay}"
                                                        Click="OnSetPlacement" MinWidth="0"
                                                        IsEnabled="{Binding CanTake}"
                                                        VerticalAlignment="Center"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Leaf}"
                                                         FontSize="11.5" VerticalAlignment="Center"
                                                         TextTrimming="CharacterEllipsis"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Grid.Column="2" Text="{Binding PlacedBy}"
                                                         FontSize="11" Classes="faint"
                                                         VerticalAlignment="Center"
                                                         TextTrimming="CharacterEllipsis"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Costs}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         IsVisible="{Binding Cheap}"
                                                         Foreground="#4ADE80"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Costs}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         IsVisible="{Binding Middling}"
                                                         Foreground="#FBBF24"/>
                                              <TextBlock Grid.Column="3" Text="{Binding Costs}"
                                                         FontSize="11" VerticalAlignment="Center"
                                                         IsVisible="{Binding Dear}"
                                                         Foreground="#F87171"/>
                                            </Grid>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </ScrollViewer>
                                  </Border>

                                  <!-- ROUTE THREE: the lottery. Nothing ties a table to a
                                       faction, so a Separatist mission in the Imperial table
                                       gated on a late-campaign fact is "Separatist holdouts in
                                       the Empire era". Both axes were always there. -->
                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <TextBlock Text="OR ENTER IT IN A LOTTERY" Classes="sechead"
                                             FontSize="11"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="A mission can instead be drawn from a weighted table. Nothing ties a table to a faction — the game lines them up by naming convention alone — so a Separatist mission whose row sits in the Imperial table, gated on a fact only the late campaign raises, is “Separatist holdouts in the Empire era”. A table is only consulted on the turns that pull from it, and your row is one candidate among several even then."/>
                                  <Button Classes="tiny" Content="Put it in a table"
                                          Click="OnAddLottery" HorizontalAlignment="Left"/>

                                  <ItemsControl ItemsSource="{Binding LotteryRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+LotteryRow">
                                        <Border Classes="row" Margin="0,5,0,0">
                                          <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="60,*,Auto">
                                              <TextBlock Text="Table" FontSize="11.5"
                                                         Classes="dim" VerticalAlignment="Center"/>
                                              <ComboBox Grid.Column="1" Width="360" FontSize="12"
                                                        CornerRadius="0" HorizontalAlignment="Left"
                                                        ItemsSource="{Binding $parent[ItemsControl].((local:SheetTab)DataContext).TableChoices}"
                                                        SelectedValue="{Binding Table, Mode=TwoWay}"
                                                        SelectedValueBinding="{Binding Value}"
                                                        SelectionChanged="OnPickLotteryTable">
                                                <ComboBox.ItemTemplate>
                                                  <DataTemplate DataType="local:SheetTab+Choice">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                      <TextBlock Text="{Binding Shown}" FontSize="12"/>
                                                      <TextBlock Text="{Binding Aside}" FontSize="10.5"
                                                                 Classes="faint"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                  </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                              </ComboBox>
                                              <Button Grid.Column="2" Classes="tiny"
                                                      Content="Remove" Click="OnDropLottery"
                                                      VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="60,Auto,Auto,*">
                                              <TextBlock Text="How" FontSize="11.5" Classes="dim"
                                                         VerticalAlignment="Center"/>
                                              <!-- NO GroupName. A name is global, so every
                                                   lottery row's pair would have joined ONE
                                                   group and checking a row would have
                                                   unchecked all the others. Without one they
                                                   group by their parent, which is this row's
                                                   own Grid. -->
                                              <RadioButton Grid.Column="1" FontSize="11.5"
                                                           Content="Add a row"
                                                           IsChecked="{Binding AddsRow, Mode=TwoWay}"
                                                           Click="OnLotteryHow"/>
                                              <RadioButton Grid.Column="2" FontSize="11.5"
                                                           Margin="14,0,0,0"
                                                           Content="Take over a row"
                                                           IsChecked="{Binding TakesOver}"
                                                           Click="OnLotteryHow"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="60,Auto,Auto,*"
                                                  IsVisible="{Binding TakesOver}">
                                              <TextBlock Grid.Column="1" Text="which" FontSize="11"
                                                         Classes="faint" Margin="0,0,9,0"
                                                         VerticalAlignment="Center"/>
                                              <ComboBox Grid.Column="2" Width="210" FontSize="12"
                                                        CornerRadius="0"
                                                        VerticalAlignment="Center"
                                                        ItemsSource="{Binding Rows}"
                                                        SelectedItem="{Binding PickedRow, Mode=TwoWay}"
                                                        SelectionChanged="OnPickLotteryRow">
                                                <ComboBox.ItemTemplate>
                                                  <DataTemplate DataType="local:SheetTab+Choice">
                                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                                      <TextBlock Text="{Binding Shown}" FontSize="11.5"/>
                                                      <TextBlock Text="{Binding Aside}" FontSize="10.5"
                                                                 Classes="faint"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                  </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                              </ComboBox>
                                              <Button Grid.Column="3" Classes="tiny"
                                                      Content="Take every row"
                                                      Click="OnTakeEveryRow" Margin="9,0,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="60,Auto,*">
                                              <TextBlock Text="Weight" FontSize="11.5"
                                                         Classes="dim" VerticalAlignment="Center"/>
                                              <TextBox Grid.Column="1" Width="76" FontSize="12"
                                                       Padding="6,3" CornerRadius="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Weight, Mode=TwoWay}"
                                                       LostFocus="OnLotteryWeight"/>
                                              <TextBlock Grid.Column="2" Text="{Binding Effect}"
                                                         FontSize="10.5" Classes="faint"
                                                         TextWrapping="Wrap" Margin="11,0,0,0"
                                                         MaxWidth="560"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                              <TextBlock Text="only when" FontSize="10.5"
                                                         Classes="faint" VerticalAlignment="Center"
                                                         Margin="0,0,7,0"/>
                                              <ItemsControl Grid.Column="1" ItemsSource="{Binding Requires}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate DataType="local:SheetTab+LineRow">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                      <TextBlock Text="{Binding Shown}" FontSize="11"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip.Tip="{Binding Value}"
                                                                 Foreground="#4ADE80"/>
                                                      <Button Grid.Column="1" Classes="tiny"
                                                              Content="x" Click="OnDropGateTag"/>
                                                    </Grid>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                              <TextBlock Grid.Column="2" Text="never when"
                                                         FontSize="10.5" Classes="faint"
                                                         VerticalAlignment="Center"
                                                         Margin="14,0,7,0"/>
                                              <ItemsControl Grid.Column="3" ItemsSource="{Binding Ignores}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate DataType="local:SheetTab+LineRow">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                      <TextBlock Text="{Binding Shown}" FontSize="11"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip.Tip="{Binding Value}"
                                                                 Foreground="#F87171"/>
                                                      <Button Grid.Column="1" Classes="tiny"
                                                              Content="x" Click="OnDropGateTag"/>
                                                    </Grid>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <Button Classes="tiny" Content="Require a fact"
                                                      Click="OnAddRequire"/>
                                              <Button Classes="tiny" Content="Block on a fact"
                                                      Click="OnAddIgnore"/>
                                              <Button Classes="tiny" Content="Add a number condition"
                                                      Click="OnAddGate"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Gates}">
                                              <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="local:SheetTab+GateRow">
                                                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                        Margin="0,2">
                                                    <Button Classes="tiny" Content="{Binding TagShown}"
                                                            Click="OnPickGateFact"
                                                            VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" Width="170"
                                                              FontSize="11.5" CornerRadius="0"
                                                              Margin="6,0" VerticalAlignment="Center"
                                                              ItemsSource="{Binding $parent[ItemsControl].((local:SheetTab)DataContext).GateOperations}"
                                                              SelectedItem="{Binding Operation, Mode=TwoWay}"
                                                              SelectionChanged="OnGateOperation"/>
                                                    <TextBox Grid.Column="2" Width="70"
                                                             FontSize="11.5" Padding="5,2"
                                                             CornerRadius="0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding Value, Mode=TwoWay}"
                                                             LostFocus="OnGateValue"/>
                                                    <CheckBox Grid.Column="3" FontSize="10.5"
                                                              Margin="9,0" Content="unset = 0"
                                                              IsChecked="{Binding MissingIsZero, Mode=TwoWay}"
                                                              Click="OnGateZero"/>
                                                    <Button Grid.Column="4" Classes="tiny"
                                                            Content="Remove" Click="OnDropGate"
                                                            VerticalAlignment="Center"/>
                                                  </Grid>
                                                </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== SELL IT IN THE ARMOURY
                                 THE STEP WITHOUT WHICH A CORRECT UTILITY ITEM IS OFFERED TO
                                 NOBODY. The Armoury does not scan for what exists; it sells from
                                 six tables naming 99 items by hard import, so a duplicate that
                                 is perfect in every other way never appears and nothing anywhere
                                 says why. That is how the PROBE BETA COIL modification spent two
                                 days waiting for a shop restock that could not have helped it.

                                 A cooked array cannot grow, so taking a slot REPLACES what it
                                 sold. The item being displaced is named before anything happens,
                                 because this is the one edit in the panel that takes something
                                 OUT of somebody's game. -->
                            <Border Classes="card" Tag="Sell"
                                    IsVisible="{Binding SecSell.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecSell}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecSell.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="SELL IT IN THE ARMOURY"/>
                                    <TextBlock Grid.Column="2" Text="nothing offers it yet"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsOnSale}"/>
                                    <TextBlock Grid.Column="2" Text="on sale"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsOnSale}"
                                               Foreground="#4ADE80"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecSell.Open}">

                                  <!-- ON SALE: where, at whose expense, and the way back. -->
                                  <StackPanel Spacing="6" IsVisible="{Binding IsOnSale}">
                                    <TextBlock Text="{Binding OnSaleAs}" FontSize="12"
                                               TextWrapping="Wrap" MaxWidth="780"
                                               HorizontalAlignment="Left"
                                               Foreground="#4ADE80"/>
                                    <TextBlock Text="{Binding SellNote}" FontSize="10.5"
                                               Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="780" HorizontalAlignment="Left"/>
                                    <Button Classes="tiny" Content="Take it off sale"
                                            Click="OnTakeOffSale" HorizontalAlignment="Left"/>
                                  </StackPanel>

                                  <!-- NOT ON SALE: the chooser, named by what each slot sells
                                       today rather than by an index. -->
                                  <StackPanel Spacing="7" IsVisible="{Binding !IsOnSale}">
                                    <TextBlock Text="{Binding SellNote}" FontSize="11"
                                               Classes="dim" TextWrapping="Wrap"
                                               MaxWidth="780" HorizontalAlignment="Left"/>
                                    <Grid ColumnDefinitions="Auto,Auto,*"
                                          IsVisible="{Binding HasShopSlots}">
                                      <ComboBox Width="420" FontSize="12" CornerRadius="0"
                                                VerticalAlignment="Center"
                                                ItemsSource="{Binding ShopSlots}"
                                                SelectedItem="{Binding SellSlot, Mode=TwoWay}"/>
                                      <Button Grid.Column="1" Content="Put it on sale"
                                              Click="OnPutOnSale" Margin="11,0,0,0"
                                              Padding="10,4" FontSize="11.5"
                                              IsEnabled="{Binding CanSell}"/>
                                    </Grid>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IS INSIDE IT
                                 EVERY REFERENCE THE COPIED ASSET HOLDS, read out of the asset.
                                 The from/to boxes in Advanced were the only door until now: they
                                 work perfectly once you already know the exact string, and are
                                 useless otherwise. A weapon's Blueprint names its firing sound,
                                 its projectile, its muzzle flash, its volley profile and its
                                 animation set, and offered a blank box and no way to learn that
                                 any of them existed.

                                 GROUPED AND FILTERED, because the lists are longest where they
                                 matter most: one base part carries 231 references and 45 of them
                                 are meshes: a foregrip for every weapon in the game. -->
                            <Border Classes="card" Tag="Inside"
                                    IsVisible="{Binding SecInside.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecInside}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecInside.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHAT IS INSIDE IT"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecInside.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecInside.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecInside.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecInside.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="820" HorizontalAlignment="Left"
                                             Text="Everything this asset points at. Choose picks a replacement from the game and rewrites both halves of the reference for you; the box beside it takes a pasted path for anything the list does not offer."/>

                                  <Grid ColumnDefinitions="330,*">
                                    <TextBox FontSize="11.5" Padding="6,3" CornerRadius="0"
                                             Watermark="filter — try DC-15A, or Shot, or Base"
                                             Text="{Binding InsideFilter, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InsideSays}"
                                               FontSize="10.5" Classes="faint" Margin="12,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                  </Grid>

                                  <TextBlock FontSize="11" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding !HasInside}"
                                             Text="{Binding InsideNote}"/>

                                  <ItemsControl ItemsSource="{Binding InsideGroups}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+InsideGroup">
                                        <StackPanel Margin="0,0,0,6">
                                          <!-- THE GROUP'S OWN HEAD, folding. Same shape as a
                                               material group's, so one thing means one thing. -->
                                          <Button Classes="cardhead" Click="OnToggleInsideGroup"
                                                  Tag="{Binding}" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                              <Path Classes="chev" Width="15" Data="{Binding Chevron}"/>
                                              <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                         FontSize="11.5"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Grid.Column="2" Text="{Binding Changed}"
                                                         FontSize="10.5"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding HasChanged}"
                                                         Foreground="{DynamicResource Accent}"/>
                                            </Grid>
                                          </Button>

                                          <ItemsControl ItemsSource="{Binding Rows}"
                                                        IsVisible="{Binding Open}">
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate DataType="local:SheetTab+InsideRow">
                                                <Border Classes="row" Margin="0,3,0,0"
                                                        Classes.mine="{Binding IsMine}">
                                                  <Grid ColumnDefinitions="250,*,220,Auto">
                                                    <!-- WHAT IT IS. The property name as the
                                                         game calls it; the export and the full
                                                         path are in the tooltip, with which of
                                                         the two maps moves it. -->
                                                    <StackPanel Grid.Column="0" Spacing="1"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding How}">
                                                      <TextBlock Text="{Binding Property}"
                                                                 FontSize="11.5"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 IsVisible="{Binding !IsMine}"
                                                                 Foreground="{DynamicResource Fore}"/>
                                                      <TextBlock Text="{Binding Property}"
                                                                 FontSize="11.5"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 IsVisible="{Binding IsMine}"
                                                                 Foreground="{DynamicResource Accent}"/>
                                                      <TextBlock Text="a hard import" FontSize="10"
                                                                 Classes="faint"
                                                                 IsVisible="{Binding Hard}"/>
                                                    </StackPanel>

                                                    <!-- WHAT IT POINTS AT NOW. -->
                                                    <StackPanel Grid.Column="1" Spacing="1"
                                                                Margin="10,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding Path}">
                                                      <TextBlock Text="{Binding Shown}"
                                                                 FontSize="11"
                                                                 FontFamily="Consolas,monospace"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 IsVisible="{Binding !IsMine}"
                                                                 Classes="faint"/>
                                                      <TextBlock Text="{Binding Shown}"
                                                                 FontSize="11"
                                                                 FontFamily="Consolas,monospace"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 IsVisible="{Binding IsMine}"
                                                                 Foreground="{DynamicResource Accent}"/>
                                                      <TextBlock Text="{Binding Detail}"
                                                                 FontSize="10" Classes="faint"
                                                                 TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBox Grid.Column="2" FontSize="11"
                                                             Padding="5,2" CornerRadius="0"
                                                             VerticalAlignment="Center"
                                                             FontFamily="Consolas,monospace"
                                                             Watermark="paste a path"
                                                             Text="{Binding Typed, Mode=TwoWay}"/>

                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Spacing="4" Margin="6,0,0,0"
                                                                VerticalAlignment="Center">
                                                      <Button Classes="tiny" Content="Choose…"
                                                              Click="OnChooseInside"/>
                                                      <Button Classes="tiny" Content="Set"
                                                              Click="OnSetInside"/>
                                                      <Button Classes="tiny" Content="Revert"
                                                              Click="OnRevertInside"
                                                              IsVisible="{Binding IsMine}"
                                                              Foreground="{DynamicResource Accent}"/>
                                                    </StackPanel>
                                                  </Grid>
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- TAKING IT OUT AGAIN. At the foot of the card that is about
                                       what this copy IS, because that is where somebody who has
                                       decided they do not want it is looking. -->
                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,8,0,4"/>
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="640" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="Takes it out of this mod. The game's asset was never touched, so there is nothing to put back — but its cooked file stays in the project folder until the next build."/>
                                    <Button Grid.Column="1" Content="Remove this copy"
                                            Click="OnRemoveCopy" Padding="10,4" FontSize="11.5"/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>


                            <!-- ============================== ITS TINT
                                 THE MASK AND THE COLOUR, which together are what make one part a
                                 COLOURWAY of another. The game's eleven Clo000 helmets are
                                 eleven PARTS sharing one mesh, each with its own mask and its
                                 own colour, and nothing links them to a base. So a mod makes a
                                 set the same way, and the button at the foot is that in one
                                 press.

                                 A COPY'S ONLY: both fields live on ModPart, and an override
                                 rewrites the game's own part in place. -->
                            <Border Classes="card" Tag="Tint"
                                    IsVisible="{Binding SecTint.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecTint}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecTint.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="TINT"/>
                                    <TextBlock Grid.Column="2" Text="what colour it paints"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecTint.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecTint.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecTint.Open}">

                                  <!-- THE MASK, NAMED. Not "the template's" — a mask is drawn
                                       for ONE kit's UVs, and a part built from another kit's
                                       template paints the wrong panels. Which mask is in play
                                       is the whole of that check. -->
                                  <Border Classes="row" Classes.mine="{Binding HasOwnTintMask}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <TextBlock Grid.Column="0" Text="Mask" FontSize="11.5"
                                                 Classes="dim" Width="60"
                                                 VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="1" Spacing="1"
                                                  VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TintMaskShown}" FontSize="12"
                                                   FontFamily="Consolas,monospace"
                                                   IsVisible="{Binding HasOwnTintMask}"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="{Binding TintMaskShown}" FontSize="12"
                                                   FontFamily="Consolas,monospace"
                                                   IsVisible="{Binding !HasOwnTintMask}"
                                                   Classes="faint"/>
                                        <TextBlock Text="its template's"
                                                   FontSize="10" Classes="faint"
                                                   IsVisible="{Binding !HasOwnTintMask}"/>
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                  Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tiny" Content="Choose…"
                                                Click="OnPickTintMask"/>
                                        <Button Classes="tiny" Content="Revert"
                                                Click="OnClearTintMask"
                                                IsVisible="{Binding HasOwnTintMask}"
                                                Foreground="{DynamicResource Accent}"/>
                                      </StackPanel>
                                    </Grid>
                                  </Border>

                                  <!-- THE COLOUR, and only where the template carries one. A box
                                       that writes into a property the part does not have is a
                                       control that takes a value and drops it. -->
                                  <Border Classes="row" IsVisible="{Binding TakesTintColour}"
                                          Classes.mine="{Binding HasOwnTintColour}">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                      <TextBlock Grid.Column="0" Text="Colour" FontSize="11.5"
                                                 Classes="dim" Width="60"
                                                 VerticalAlignment="Center"/>
                                      <Border Grid.Column="1" Width="30" Height="22"
                                              Margin="0,0,9,0"
                                              BorderBrush="{DynamicResource Line}"
                                              BorderThickness="1"
                                              IsVisible="{Binding HasTintSwatch}"
                                              Background="{Binding TintSwatch}"/>
                                      <TextBox Grid.Column="2" Width="96" FontSize="12"
                                               Padding="6,3" CornerRadius="0"
                                               FontFamily="Consolas,monospace"
                                               VerticalAlignment="Center"
                                               Watermark="its template's"
                                               Text="{Binding EditTintColour, Mode=TwoWay}"
                                               LostFocus="OnTintColourTyped"/>
                                      <TextBlock Grid.Column="3" Text="{Binding TintColourShown}"
                                                 FontSize="10.5" Classes="faint" Margin="11,0,0,0"
                                                 VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                  Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tiny" Content="Choose…"
                                                Click="OnPickTintColour"/>
                                        <Button Classes="tiny" Content="Revert"
                                                Click="OnClearTintColour"
                                                IsVisible="{Binding HasOwnTintColour}"
                                                Foreground="{DynamicResource Accent}"/>
                                      </StackPanel>
                                    </Grid>
                                  </Border>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="780" HorizontalAlignment="Left"
                                             Text="{Binding TintNote}"/>

                                  <Border Height="1" Background="{DynamicResource Line}"
                                          Margin="0,4"/>
                                  <Grid ColumnDefinitions="*,Auto"
                                        IsVisible="{Binding TakesTintColour}">
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="620" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="A second part, the same mesh and the same artwork, for another colour. This is how the game's own colourways are built — eleven helmets, one mesh, eleven masks."/>
                                    <Button Grid.Column="1" Content="Duplicate as another colour"
                                            Click="OnDuplicateAsColour" Padding="10,4"
                                            FontSize="11.5"/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== AN ENEMY GROUP'S NUMBERS
                                 MULTIPLIERS, NOT NUMBERS, and the reason is the shape of the
                                 data: a group is up to 32 tables and a health change alone is 16
                                 of them, one per tier and difficulty. A multiplier keeps the
                                 game's own curve, which is what "make Outlaws weaker" means.

                                 The spread in "The game ships" is what a single number cannot
                                 say: a stat reading 40 .. 260 is one the game already scales. -->
                            <Border Classes="card" Tag="Enemy" Margin="0,0,0,20"
                                    IsVisible="{Binding SecEnemy.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecEnemy}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecEnemy.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="THEIR NUMBERS"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecEnemy.Count}"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecEnemy.Changed}"
                                               Classes="faint"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecEnemy.Count}"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding SecEnemy.Changed}"
                                               Foreground="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecEnemy.Open}">

                                  <TextBlock FontSize="11" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="820" HorizontalAlignment="Left"
                                             Text="{Binding EnemyNote}"/>

                                  <Grid ColumnDefinitions="*,140,90,150" Margin="1,6,1,0">
                                    <TextBlock Text="STAT" FontSize="10" Classes="faint"
                                               LetterSpacing="0.6"/>
                                    <TextBlock Grid.Column="1" Text="THE GAME SHIPS" FontSize="10"
                                               Classes="faint" LetterSpacing="0.6"/>
                                    <TextBlock Grid.Column="2" Text="×" FontSize="10"
                                               Classes="faint" LetterSpacing="0.6"/>
                                    <TextBlock Grid.Column="3" Text="BECOMES" FontSize="10"
                                               Classes="faint" LetterSpacing="0.6"/>
                                  </Grid>

                                  <ItemsControl ItemsSource="{Binding EnemyRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+EnemyRow">
                                        <Border Classes="row" Margin="0,0,0,3"
                                                Classes.mine="{Binding Changed}">
                                          <Grid ColumnDefinitions="*,140,90,150">
                                            <StackPanel Spacing="1" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding Row}">
                                              <TextBlock Text="{Binding Shown}" FontSize="12"
                                                         TextTrimming="CharacterEllipsis"
                                                         IsVisible="{Binding !Changed}"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Text="{Binding Shown}" FontSize="12"
                                                         TextTrimming="CharacterEllipsis"
                                                         IsVisible="{Binding Changed}"
                                                         Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Ships}"
                                                       FontSize="11.5" Classes="faint"
                                                       FontFamily="Consolas,monospace"
                                                       VerticalAlignment="Center"/>

                                            <TextBox Grid.Column="2" Width="66" FontSize="11.5"
                                                     Padding="5,2" CornerRadius="0" MinHeight="0"
                                                     HorizontalAlignment="Left"
                                                     FontFamily="Consolas,monospace"
                                                     VerticalAlignment="Center"
                                                     IsEnabled="{Binding CanScale}"
                                                     Text="{Binding Text, Mode=TwoWay}"
                                                     LostFocus="OnSetEnemyMultiplier"/>

                                            <TextBlock Grid.Column="3" Text="{Binding Becomes}"
                                                       FontSize="11.5"
                                                       FontFamily="Consolas,monospace"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !Changed}"
                                                       Classes="faint"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Becomes}"
                                                       FontSize="11.5"
                                                       FontFamily="Consolas,monospace"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Changed}"
                                                       Foreground="#4ADE80"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="620" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="A stat the game ships at 0 cannot be scaled — anything times zero is zero. Setting one back to 1 removes it, and a group with nothing left asked of it is dropped from the mod, so its tables are not copied for nothing."/>
                                    <Button Grid.Column="1" Content="Put them all back"
                                            Click="OnClearEnemyGroup" Padding="10,4"
                                            FontSize="11.5"
                                            IsVisible="{Binding SecEnemy.Changed}"/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS COLOURS
                                 Every outfit region has FOUR swatches and a part decides how many
                                 the menu offers by putting the rest in its LockedSlots and
                                 HiddenSlots. Handing one back answers "I can only reach 2 of the
                                 tints on this helmet" — which was never a limit in the tool. -->
                            <Border Classes="card" Tag="Colours"
                                    IsVisible="{Binding SecColours.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecColours}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecColours.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="TINTS"/>
                                    <TextBlock Grid.Column="2" Text="what the menu offers"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecColours.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecColours.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="5"
                                            IsVisible="{Binding SecColours.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Tick a swatch to offer it in the menu. The game hides the rest."/>
                                  <ItemsControl ItemsSource="{Binding Swatches}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+SwatchRow">
                                        <Border Classes="row" Padding="9,5" Margin="0,0,0,4">
                                          <Grid ColumnDefinitions="Auto,170,*">
                                            <CheckBox IsChecked="{Binding Offered, Mode=TwoWay}"
                                                      MinWidth="0" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fore}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       FontSize="10.5" Classes="faint"
                                                       VerticalAlignment="Center"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHO IT IS FOR -->
                            <Border Classes="card" Tag="Offered"
                                    IsVisible="{Binding SecOffered.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecOffered}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecOffered.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="TAGS"/>
                                    <TextBlock Grid.Column="2" Text="the tags that gate it"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecOffered.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecOffered.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="4"
                                            IsVisible="{Binding SecOffered.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Gate tags on its AllowedSlots, one per line. A hero specialisation carries its owner's name tag beside its slot tag — removing the name tag is what offers it to everyone."/>
                                  <!-- THE TAGS IT ACTUALLY CARRIES, as ticks. A gate tag is
                                       fifty-odd characters of dotted namespace and one wrong
                                       character fails the build, so a free-text box asked for
                                       something nobody can do. Untick to take one off — which
                                       is how a hero's gear becomes everybody's. -->
                                  <TextBlock Classes="faint" FontSize="11" Margin="0,4,0,0"
                                             IsVisible="{Binding HasTags}"
                                             Text="The tags it carries — untick one to take it off"/>
                                  <TextBlock Classes="faint" FontSize="11" Margin="0,4,0,0"
                                             IsVisible="{Binding !HasTags}"
                                             Text="It carries no gate tags of its own."/>
                                  <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+TagRow">
                                        <Border Classes="row" Padding="9,5" Margin="0,0,0,4">
                                          <Grid ColumnDefinitions="Auto,230,*">
                                            <CheckBox IsChecked="{Binding Kept, Mode=TwoWay}"
                                                      MinWidth="0" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Shown}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fore}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tag}"
                                                       FontSize="10" Classes="faint"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Consolas,monospace"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <TextBlock Classes="faint" FontSize="11" Text="Add tags"
                                             Margin="0,4,0,0" IsVisible="{Binding !IsCopy}"/>
                                  <TextBox FontSize="11.5" Padding="5,2" CornerRadius="0"
                                           AcceptsReturn="True" MinHeight="46" Width="600"
                                           HorizontalAlignment="Left" IsVisible="{Binding !IsCopy}"
                                           FontFamily="Consolas,monospace"
                                           Text="{Binding EditAddTags, Mode=TwoWay}"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IT DOES
                                 A COPY ONLY. Swapping an ability replaces one of the template's
                                 with another — the description, icon and tuning all live on the
                                 ability, so moving the reference brings the whole thing. -->
                            <Border Classes="card" Tag="Does"
                                    IsVisible="{Binding SecDoes.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecDoes}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecDoes.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="ABILITIES"/>
                                    <TextBlock Grid.Column="2" Text="its abilities and animation"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecDoes.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding !HasAbilities}"
                                             Text="This copy does whatever its template does. It swaps no abilities."/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding HasAbilities}"
                                             Text="Swapping an ability replaces one of the template's with another — the description, icon and tuning all live on the ability, so moving the reference brings the whole thing with it. TIERS MUST MATCH: a six-tier line needs all six rows, or the tiers you left alone still point at the one you replaced."/>

                                  <ItemsControl ItemsSource="{Binding Abilities}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+AbilityRow">
                                        <Border Classes="row" Margin="0,0,0,6">
                                          <Grid ColumnDefinitions="210,Auto,*">
                                            <TextBlock Text="{Binding FromShown}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding From}"
                                                       Foreground="{DynamicResource Fore}"/>
                                            <TextBlock Grid.Column="1" Text="→" Margin="8,0"
                                                       VerticalAlignment="Center" Classes="faint"/>
                                            <TextBox Grid.Column="2" FontSize="11.5" Padding="5,2"
                                                     CornerRadius="0"
                                                     Watermark="the ability to use instead"
                                                     FontFamily="Consolas,monospace"
                                                     Text="{Binding To, Mode=TwoWay}"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <Grid ColumnDefinitions="118,*" Margin="0,4,0,0">
                                    <TextBlock Text="Anim class" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="11.5" Padding="5,2"
                                             CornerRadius="0" Width="600"
                                             HorizontalAlignment="Left"
                                             Watermark="optional — its template's own"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditAnimClass, Mode=TwoWay}"/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== BOLTS (a weapon's)
                                 The colour it fires, on THIS mod's copy of the weapon's actor.
                                 The weapon it was copied from keeps whatever it had. -->
                            <Border Classes="card" Tag="Bolts"
                                    IsVisible="{Binding SecBolts.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecBolts}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecBolts.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="BOLTS"/>
                                    <TextBlock Grid.Column="2" Text="the colour it fires"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecBolts.Open}">
                                  <ComboBox Width="240" FontSize="12"
                                            ItemsSource="{Binding Bolts}"
                                            SelectedItem="{Binding Bolt, Mode=TwoWay}"
                                            SelectionChanged="OnPickBolt">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+BoltChoice">
                                        <TextBlock Text="{Binding Label}"/>
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="{Binding BoltNote}"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== SHELF (a weapon's)
                                 Which Armoury shelf it lands on. The game's own shelf was
                                 measured LOSING its first row once it holds more than seven,
                                 counting every mod installed — so the custom shelf is the
                                 default a duplicate goes onto. -->
                            <Border Classes="card" Tag="Shelf"
                                    IsVisible="{Binding SecShelf.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecShelf}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecShelf.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="SHELF"/>
                                    <TextBlock Grid.Column="2" Text="where the Armoury lists it"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecShelf.Open}">
                                  <TextBlock Text="{Binding ShelfIs}" FontSize="12"
                                             Foreground="{DynamicResource Fore}"/>
                                  <TextBlock Text="{Binding ShelfNote}" FontSize="10.5"
                                             Classes="faint" TextWrapping="Wrap"/>
                                  <StackPanel Orientation="Horizontal" Spacing="7"
                                              IsVisible="{Binding CanMoveShelf}">
                                    <Button Classes="tiny" Content="Put it on the custom shelf"
                                            Click="OnShelfCustom"
                                            IsVisible="{Binding OnGameShelf}"/>
                                    <Button Classes="tiny" Content="Put it on the game's shelf"
                                            Click="OnShelfGame"
                                            IsVisible="{Binding !OnGameShelf}"/>
                                  </StackPanel>

                                  <!-- AND THE WAY BACK OFF ONE. Every other state here can be
                                       changed; without this, making a shelf of your own was the
                                       one move in this panel that could not be undone from it.
                                       The shelf stays in the mod, only the weapon moves. -->
                                  <StackPanel Spacing="5" IsVisible="{Binding ShelfIsOwn}">
                                    <Button Classes="tiny" HorizontalAlignment="Left"
                                            Content="Put it back on the game's shelf"
                                            Click="OnShelfGame"/>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="780" HorizontalAlignment="Left"
                                               Text="The shelf itself stays in the mod; only this weapon moves off it. Its numbers, if it has any of its own, are unaffected."/>
                                  </StackPanel>

                                  <!-- A SHELF OF THIS MOD'S OWN, offered BELOW the two shared
                                       ones rather than instead of them: the shipped shelves need
                                       no setup and no dependency of the author's, so they are
                                       the right default. This is for somebody who wants their
                                       own name on the Armoury's list.

                                       Absent once the weapon already has one, because then the
                                       answer above it is the whole story. -->
                                  <StackPanel Spacing="7" IsVisible="{Binding CanMoveShelf}">
                                    <Border Height="1" Background="{DynamicResource Line}"
                                            Margin="0,4"/>
                                    <TextBlock FontSize="11" Classes="dim" TextWrapping="Wrap"
                                               MaxWidth="780" HorizontalAlignment="Left"
                                               Text="Or give it a shelf of your own, with a name and numbers nobody else's weapons share."/>
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                      <TextBox Width="200" FontSize="12" Padding="6,3"
                                               CornerRadius="0" VerticalAlignment="Center"
                                               Watermark="a name for the shelf"
                                               Text="{Binding EditShelfName, Mode=TwoWay}"/>
                                      <TextBlock Grid.Column="1" Text="behaves like" FontSize="11"
                                                 Classes="faint" Margin="11,0"
                                                 VerticalAlignment="Center"/>
                                      <ComboBox Grid.Column="2" Width="130" FontSize="12"
                                                CornerRadius="0" VerticalAlignment="Center"
                                                ItemsSource="{Binding ShelfLikes}"
                                                SelectedItem="{Binding EditShelfLike, Mode=TwoWay}"/>
                                      <Button Grid.Column="3" Content="Make a shelf of my own"
                                              Click="OnMakeOwnShelf" Margin="11,0,0,0"
                                              Padding="10,4" FontSize="11.5"
                                              IsEnabled="{Binding CanMakeShelf}"/>
                                    </Grid>
                                    <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                               MaxWidth="780" HorizontalAlignment="Left"
                                               Text="What it behaves like is not what it is called: the animations, the abilities and the numbers it starts from all come from the class you name. A shelf that behaves like a Repeater holds repeaters, whatever is on the label."/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== NUMBERS (a weapon's)
                                 A weapon SHARES its class's attribute table until it is given
                                 one of its own — so editing the shared one would change every
                                 weapon of that kind, the game's included. -->
                            <Border Classes="card" Tag="Stats"
                                    IsVisible="{Binding SecStats.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecStats}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecStats.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="NUMBERS"/>
                                    <TextBlock Grid.Column="2" Text="damage, rate, range"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecStats.Open}">

                                  <StackPanel Spacing="7" IsVisible="{Binding CanOwnStats}">
                                    <TextBlock Text="{Binding StatsNote}" FontSize="11"
                                               Classes="dim" TextWrapping="Wrap"/>
                                    <Button Classes="tiny" Content="Give it numbers of its own"
                                            Click="OnGiveOwnStats" HorizontalAlignment="Left"/>
                                  </StackPanel>

                                  <ItemsControl ItemsSource="{Binding WeaponStats}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+StatRow">
                                        <Border Classes="row" Margin="0,0,0,5"
                                                Classes.mine="{Binding Changed}">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fore}"/>
                                            <TextBox Grid.Column="1" Width="110" FontSize="11.5"
                                                     Padding="6,2" MinHeight="0"
                                                     FontFamily="Consolas,monospace"
                                                     Text="{Binding Text, Mode=TwoWay}"
                                                     LostFocus="OnSetWeaponStat"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT FITS IT (a weapon's)
                                 The type tag is what the game's palettes are keyed by. Keeping
                                 the donor's means the game's attachments fit; minting its own
                                 means nothing of the game's does, and every piece must come
                                 from this mod. -->
                            <Border Classes="card" Tag="Fits"
                                    IsVisible="{Binding SecFits.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecFits}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecFits.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="WHAT FITS IT"/>
                                    <TextBlock Grid.Column="2" Text="whose attachments it takes"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecFits.Open}">
                                  <TextBlock Text="{Binding FitsIs}" FontSize="12"
                                             Foreground="{DynamicResource Fore}"/>
                                  <TextBlock Text="{Binding FitsNote}" FontSize="10.5"
                                             Classes="faint" TextWrapping="Wrap"/>
                                  <Button Classes="tiny" HorizontalAlignment="Left"
                                          Content="Give it a type of its own"
                                          IsVisible="{Binding KeepsDonorType}"
                                          Click="OnOwnType"/>
                                  <Button Classes="tiny" HorizontalAlignment="Left"
                                          Content="Make it answer to its donor's type"
                                          IsVisible="{Binding !KeepsDonorType}"
                                          Click="OnDonorType"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ATTACHMENTS (a weapon's)
                                 Which palettes it can wear, and which this mod owns a copy of.
                                 One it does not own is the GAME's, and changing that would
                                 change it for every weapon sharing it. -->
                            <Border Classes="card" Tag="Attach"
                                    IsVisible="{Binding SecAttach.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecAttach}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecAttach.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="ATTACHMENTS"/>
                                    <TextBlock Grid.Column="2" Text="what it can wear"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="5"
                                            IsVisible="{Binding SecAttach.Open}">
                                  <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+AttachRow">
                                        <Border Classes="row" Margin="0,0,0,5"
                                                Classes.mine="{Binding Mine}">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                              <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Slot}" FontSize="12"
                                                           Foreground="{DynamicResource Fore}"/>
                                                <TextBlock Text="{Binding Style}" FontSize="10"
                                                           Classes="faint"
                                                           VerticalAlignment="Center"/>
                                              </StackPanel>
                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- THREE READINGS, not two. A state that
                                                     looks applied in the project and reaches
                                                     nothing in the game is not success and must
                                                     not be drawn as it. -->
                                                <TextBlock Text="{Binding Wearing}" FontSize="10.5"
                                                           Classes="faint" TextWrapping="Wrap"
                                                           IsVisible="{Binding Plain}"/>
                                                <TextBlock Text="{Binding Wearing}" FontSize="10.5"
                                                           IsVisible="{Binding Mine}"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding Wearing}" FontSize="10.5"
                                                           IsVisible="{Binding Warn}"
                                                           TextWrapping="Wrap"
                                                           Foreground="#F87171"/>
                                                <TextBlock Text="{Binding Leaf}" FontSize="10.5"
                                                           Classes="faint"
                                                           FontFamily="Consolas,monospace"/>
                                              </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                              <Button Classes="tiny" Content="Take a copy"
                                                      IsVisible="{Binding !Mine}"
                                                      Click="OnOwnAttachment"/>
                                              <Button Classes="tiny" Content="Give it back"
                                                      IsVisible="{Binding Mine}"
                                                      Click="OnDropAttachment"
                                                      Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== CREST (a specialization's)
                                 A specialization names its icon by TAG out of an image bank,
                                 not by asset path. Any ImageBank.Icon.* tag will do. -->
                            <Border Classes="card" Tag="Crest"
                                    IsVisible="{Binding SecCrest.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecCrest}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecCrest.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="CREST"/>
                                    <TextBlock Grid.Column="2" Text="the badge in the menu"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="7"
                                            IsVisible="{Binding SecCrest.Open}">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="330" FontSize="11" Padding="6,2" MinHeight="0"
                                             FontFamily="Consolas,monospace"
                                             Watermark="its template's crest"
                                             Text="{Binding EditCrest, Mode=TwoWay}"/>
                                    <Button Classes="tiny" Content="Browse…" Click="OnPickCrest"/>
                                  </StackPanel>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="A specialization names its icon by TAG rather than by asset path. Browse offers every crest the game has; any ImageBank.Icon.* tag will do."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHO CAN TAKE IT
                                 And which specialization it claims to BE. The identity tag is
                                 KEPT from the template on purpose: one carrying its template's
                                 identity was measured reaching the picker AND the game's own
                                 recruit generator, and a fresh tag is one the game's tag table
                                 does not define. -->
                            <Border Classes="card" Tag="Who"
                                    IsVisible="{Binding SecWho.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecWho}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecWho.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="WHO CAN TAKE IT"/>
                                    <TextBlock Grid.Column="2" Text="and what it claims to be"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <Grid Margin="12" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto"
                                      IsVisible="{Binding SecWho.Open}">
                                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Only for"
                                             FontSize="12" Classes="dim" Margin="0,4,0,0"/>
                                  <TextBox Grid.Row="0" Grid.Column="1" FontSize="12"
                                           HorizontalAlignment="Left" Width="300"
                                           Watermark="anyone"
                                           Text="{Binding EditForWho, Mode=TwoWay}"/>

                                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Identity"
                                             FontSize="12" Classes="dim" Margin="0,12,0,0"/>
                                  <TextBox Grid.Row="1" Grid.Column="1" FontSize="11"
                                           Margin="0,8,0,0" HorizontalAlignment="Left" Width="440"
                                           FontFamily="Consolas,monospace"
                                           Text="{Binding EditIdentity, Mode=TwoWay}"/>

                                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                             FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="A copy keeps its template's identity tag, and that is measured rather than assumed: one that did shipped and reached both the picker and the game's own recruit generator. A fresh tag is one the game's tag table does not define."/>
                                </Grid>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IT GRANTS
                                 Outright, without spending focus. -->
                            <Border Classes="card" Tag="Grants"
                                    IsVisible="{Binding SecGrants.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecGrants}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecGrants.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="WHAT IT GRANTS"/>
                                    <TextBlock Grid.Column="2" Text="from the start, without focus"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="5"
                                            IsVisible="{Binding SecGrants.Open}">
                                  <ItemsControl ItemsSource="{Binding Grants}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+GrantRow">
                                        <Border Classes="row" Margin="0,0,0,5">
                                          <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" FontSize="10" Width="64"
                                                       VerticalAlignment="Center" Classes="faint"
                                                       Text="ability"
                                                       IsVisible="{Binding !IsGear}"/>
                                            <TextBlock Grid.Column="0" FontSize="10" Width="64"
                                                       VerticalAlignment="Center" Classes="faint"
                                                       Text="gear kit"
                                                       IsVisible="{Binding IsGear}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Leafed}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fore}"
                                                       ToolTip.Tip="{Binding Path}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                              <Button Classes="tiny" Content="Change…"
                                                      Click="OnChangeGrant"/>
                                              <Button Classes="tiny" Content="Remove"
                                                      Click="OnDropGrant"
                                                      Foreground="{DynamicResource Accent}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Button Classes="tiny" Content="Grant an ability…"
                                            Click="OnAddAbilityGrant"/>
                                    <Button Classes="tiny" Content="Grant a gear kit…"
                                            Click="OnAddGearGrant"/>
                                  </StackPanel>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS RUNGS
                                 The focus tree: the ladder a recruit spends focus climbing, and
                                 what makes a specialization selectable at all. A number the game
                                 ships as 0 cannot be raised — it takes no space in the file, so
                                 there is nothing to write over, and the build says so. -->
                            <Border Classes="card" Tag="Rungs"
                                    IsVisible="{Binding SecRungs.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecRungs}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecRungs.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="ITS RUNGS"/>
                                    <TextBlock Grid.Column="2" Text="the ladder focus is spent on"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="4"
                                            IsVisible="{Binding SecRungs.Open}">
                                  <Grid ColumnDefinitions="118,*,58,58,58,Auto" Margin="2,0,2,2">
                                    <TextBlock Grid.Column="1" Text="Grants" FontSize="10"
                                               Classes="faint"/>
                                    <TextBlock Grid.Column="2" Text="Level" FontSize="10"
                                               Classes="faint" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Focus" FontSize="10"
                                               Classes="faint" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Cost" FontSize="10"
                                               Classes="faint" HorizontalAlignment="Center"/>
                                  </Grid>

                                  <ItemsControl ItemsSource="{Binding Rungs}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+RungRow">
                                        <Border Classes="row" Margin="0,0,0,4" Padding="8,4">
                                          <Grid ColumnDefinitions="118,*,58,58,58,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Where}"
                                                       FontSize="10.5" Classes="faint"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AbilityLeaf}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fore}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Ability}"/>
                                            <TextBox Grid.Column="2" Width="50" FontSize="11"
                                                     Padding="4,1" MinHeight="0" Margin="4,0"
                                                     Tag="level"
                                                     Text="{Binding Level, Mode=TwoWay}"
                                                     LostFocus="OnSetRung"/>
                                            <TextBox Grid.Column="3" Width="50" FontSize="11"
                                                     Padding="4,1" MinHeight="0" Margin="4,0"
                                                     Tag="focus"
                                                     Text="{Binding Focus, Mode=TwoWay}"
                                                     LostFocus="OnSetRung"/>
                                            <TextBox Grid.Column="4" Width="50" FontSize="11"
                                                     Padding="4,1" MinHeight="0" Margin="4,0"
                                                     Tag="cost"
                                                     Text="{Binding Cost, Mode=TwoWay}"
                                                     LostFocus="OnSetRung"/>
                                            <Button Grid.Column="5" Classes="tiny" Content="Change…"
                                                    Margin="6,0,0,0" Click="OnChangeRung"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Level is when a recruit may take the rung; Focus is its place in the line; Cost is what it charges. A number the game ships as 0 cannot be raised — it takes no space in the file, so there is nothing to write over, and the build says so if you try."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== PROGRESSION (an ability's)
                                 Every tier and every number behind it — on the ability, on the
                                 effect it applies, on its cooldown. A SHARED number is one that
                                 several tiers name: changing it moves all of them, unless this
                                 tier is given its own copy of the asset that holds it. -->
                            <Border Classes="card" Tag="Progression"
                                    IsVisible="{Binding SecProg.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecProg}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecProg.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="PROGRESSION"/>
                                    <TextBlock Grid.Column="2" Text="every tier, and what it costs"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecProg.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecProg.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="4"
                                            IsVisible="{Binding SecProg.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="{Binding ProgressionNote}"/>

                                  <ItemsControl ItemsSource="{Binding Progression}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+ProgRow">
                                        <Border Classes="row" Margin="0,0,0,4" Padding="8,4"
                                                Classes.mine="{Binding Edited}">
                                          <Grid ColumnDefinitions="66,*,Auto,90,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Where}"
                                                       FontSize="10.5" Classes="faint"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                              <TextBlock Text="{Binding Label}" FontSize="12"
                                                         Foreground="{DynamicResource Fore}"/>
                                              <TextBlock Text="{Binding Note}" FontSize="10"
                                                         Classes="faint"
                                                         IsVisible="{Binding !IsShared}"/>
                                              <!-- AMBER, as the old studio has it: this one
                                                   number belongs to several tiers. -->
                                              <TextBlock Text="{Binding Note}" FontSize="10"
                                                         IsVisible="{Binding IsShared}"
                                                         Foreground="#F5B14C"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="tiny"
                                                    Content="Its own copy…"
                                                    Margin="0,0,6,0"
                                                    IsVisible="{Binding IsShared}"
                                                    Click="OnProgressionOwnCopy"/>
                                            <TextBox Grid.Column="3" Width="82" FontSize="11.5"
                                                     Padding="6,2" MinHeight="0"
                                                     FontFamily="Consolas,monospace"
                                                     Text="{Binding Text, Mode=TwoWay}"
                                                     LostFocus="OnSetProgression"/>
                                            <Button Grid.Column="4" Classes="tiny" Content="Revert"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding Edited}"
                                                    Click="OnClearProgression"
                                                    Foreground="{DynamicResource Accent}"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS ASSET NAME
                                 What the copy cooks to. Unique across every mod installed at
                                 once: two mods sharing one id cook to the same package and one
                                 wins — which is a bug report nobody can diagnose from inside
                                 either mod. -->
                            <Border Classes="card" Tag="Files"
                                    IsVisible="{Binding SecFiles.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecFiles}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecFiles.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="ASSET NAME"/>
                                    <TextBlock Grid.Column="2" Text="what it cooks to"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecFiles.Open}">
                                  <Grid ColumnDefinitions="118,*">
                                    <TextBlock Text="Id" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" FontSize="12" Padding="6,3"
                                             CornerRadius="0" Width="600"
                                             HorizontalAlignment="Left"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding EditId, Mode=TwoWay}"/>
                                  </Grid>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Unique across every mod installed at once — two mods sharing one id cook to the same package and one wins. Avoid ending it in _1, _2 and so on: the engine splits a trailing number off into an FName number and the part does not load."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS OWN SLOT
                                 Only for a target that sets the lock; 49 parts in the game do,
                                 and for the rest this is a tick that means nothing. -->
                            <Border Classes="card" Tag="Slot"
                                    IsVisible="{Binding SecSlot.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecSlot}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecSlot.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="SLOT LOCK"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecSlot.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="4"
                                            IsVisible="{Binding SecSlot.Open}">
                                  <CheckBox IsChecked="{Binding EditLocksOwnSlot, Mode=TwoWay}"
                                            FontSize="11.5"
                                            Content="Locks its own slot once chosen"/>
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="The game locks named voices and the clone and bespoke appearances — which is why a clone's face cannot be changed. Untick to let the player change their mind."/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== ITS NUMBERS
                                 The part's OWN properties, in the same grid the asset reader
                                 uses — not the old studio's numbers box, which reads attribute
                                 tables and ability effects and opens empty on a garment. Double
                                 click a value to type over it; every change is rehearsed against
                                 the build's own write before the project hears about it. -->
                            <!-- ============================== NUMBERS
                                 What the ability and its effects are worth. Two kinds in one
                                 list: a number the asset CARRIES is written over, and a property
                                 it leaves at the class default is ADDED, which rebuilds the
                                 export's header around it. The right hand cell says which. -->
                            <Border Classes="card" Tag="Effects"
                                    IsVisible="{Binding SecEffects.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecEffects}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecEffects.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead" Text="NUMBERS"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecEffects.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecEffects.Open}">

                                  <TextBlock Text="{Binding EffectsNote}" FontSize="11"
                                             Classes="faint" TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left"
                                             IsVisible="{Binding HasEffectsNote}"/>

                                  <TextBlock Text="{Binding EffectsElsewhere}" FontSize="10.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasEffectsElsewhere}"/>

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             Text="{Binding EffectsHelp}"/>

                                  <!-- WHAT BECAME OF THE LAST NUMBER TYPED: why it was refused
                                       (red), or what was done to it (amber). The log says the
                                       same, but a box that quietly goes back to its old value
                                       with the reason only down there reads as a broken box. -->
                                  <TextBlock Text="{Binding EffectsFeedback}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#F87171"
                                             IsVisible="{Binding HasEffectsRefusal}"/>
                                  <TextBlock Text="{Binding EffectsFeedback}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasEffectsFeedbackNote}"/>

                                  <!-- A TABLE ONLY: it can hold thousands of numbers, and this is
                                       how the ones past the first screenful are reached. -->
                                  <TextBox FontSize="12" Padding="6,3" CornerRadius="0" Width="360"
                                           HorizontalAlignment="Left"
                                           Watermark="Find a row or a field"
                                           IsVisible="{Binding EffectsFilterable}"
                                           Text="{Binding EffectsFilter, Mode=TwoWay}"/>

                                  <ItemsControl ItemsSource="{Binding EffectRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+EffectRow">
                                        <Border Classes="row" Margin="0,0,0,3">
                                          <Grid ColumnDefinitions="*,92,62,Auto">
                                            <StackPanel Spacing="1" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding Where}">
                                              <TextBlock Text="{Binding Label}" FontSize="12"
                                                         TextWrapping="Wrap"
                                                         Foreground="{DynamicResource Fore}"
                                                         IsVisible="{Binding !Mine}"/>
                                              <TextBlock Text="{Binding Label}" FontSize="12"
                                                         TextWrapping="Wrap" Foreground="#4ADE80"
                                                         IsVisible="{Binding Mine}"/>
                                              <TextBlock Text="{Binding Detail}" FontSize="10"
                                                         Classes="faint" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" FontSize="12" Padding="5,2"
                                                     CornerRadius="0" Margin="6,0"
                                                     VerticalAlignment="Center"
                                                     IsEnabled="{Binding CanType}"
                                                     Text="{Binding Value, Mode=TwoWay}"
                                                     LostFocus="OnEffectNumber"/>

                                            <TextBlock Grid.Column="2" Text="{Binding Now}"
                                                       FontSize="11" Classes="faint"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,8,0"/>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        Spacing="5" VerticalAlignment="Center"
                                                        MinWidth="104">
                                              <Button Classes="tiny" Content="Reset"
                                                      Click="OnResetEffectNumber"
                                                      IsVisible="{Binding Mine}"/>
                                              <!-- A ROW'S OWN ACT, where a box cannot say it: a
                                                   modification that carries no number of its own
                                                   is given one with this, not by typing. -->
                                              <Button Classes="tiny" Content="{Binding ActionLabel}"
                                                      Click="OnEffectAction"
                                                      ToolTip.Tip="{Binding Note}"
                                                      IsVisible="{Binding HasAction}"/>
                                              <TextBlock Text="{Binding State}" FontSize="10"
                                                         Classes="faint" VerticalAlignment="Center"
                                                         ToolTip.Tip="{Binding Note}"
                                                         IsVisible="{Binding HasState}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== IN THE BLACK MARKET
                                 THE SHOP HALF OF A MODIFICATION. A modification is TWO assets:
                                 the ability holds what it does (the NUMBERS card above), and the
                                 shop item holds what it is called, what it says, how rare it is
                                 and what it costs. So this card writes to a second override, and
                                 either card can be left alone. Written when a box is left, as the
                                 numbers are. -->
                            <Border Classes="card" Tag="Shop"
                                    IsVisible="{Binding SecShop.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecShop}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecShop.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="IN THE BLACK MARKET"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecShop.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="8"
                                            IsVisible="{Binding SecShop.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             Text="What the Black Market and the weapon's modification list call it, say about it, charge for it and rate it. The grey text in a box is the game's own; leave a box empty to keep it. The two prices are set against each other: a modification that sells for more than it costs is a credit press. In what it says, {effectDescription_1} is where the game puts the number itself when it shows the sentence: keep it where the number should appear, because taking it out makes the sentence stop saying the number."/>

                                  <TextBlock Text="{Binding ShopFeedback}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#F87171"
                                             IsVisible="{Binding HasShopRefusal}"/>
                                  <TextBlock Text="{Binding ShopFeedback}" FontSize="11.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasShopNote}"/>

                                  <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Text="Name" FontSize="11.5" Classes="dim"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="ShopNameBox" FontSize="12"
                                             Padding="6,3" CornerRadius="0" Width="420"
                                             HorizontalAlignment="Left"
                                             Watermark="{Binding ShopNameGame}"
                                             Text="{Binding ShopName, Mode=TwoWay}"
                                             LostFocus="OnShopName"/>
                                    <TextBlock Grid.Row="1" Text="What it says" FontSize="11.5"
                                               Classes="dim" Margin="0,8,0,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Name="ShopTextBox"
                                             FontSize="12" Padding="6,3" CornerRadius="0"
                                             Margin="0,8,0,0" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="52" Width="600"
                                             HorizontalAlignment="Left"
                                             Watermark="{Binding ShopTextGame}"
                                             Text="{Binding ShopText, Mode=TwoWay}"
                                             LostFocus="OnShopText"/>
                                    <TextBlock Grid.Row="2" Text="How rare" FontSize="11.5"
                                               Classes="dim" Margin="0,8,0,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                                Spacing="8" Margin="0,8,0,0"
                                                IsVisible="{Binding HasRarities}">
                                      <ComboBox Name="ShopRarityBox" Width="170" FontSize="12"
                                                CornerRadius="0"
                                                ItemsSource="{Binding ShopRarities}"
                                                SelectedItem="{Binding ShopRarity, Mode=TwoWay}"
                                                SelectionChanged="OnShopRarity"/>
                                      <TextBlock Text="{Binding ShopRarityGame}"
                                                 FontSize="11" Classes="faint"
                                                 VerticalAlignment="Center"/>
                                      <Button Classes="tiny" Content="Reset"
                                              Click="OnResetShopRarity"
                                              IsVisible="{Binding ShopRarityMine}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11"
                                               Classes="faint" Margin="0,8,0,0"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasRarities}"
                                               Text="It carries no rarity tag, so there is nothing to change."/>
                                  </Grid>

                                  <ItemsControl ItemsSource="{Binding ShopRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+EffectRow">
                                        <Border Classes="row" Margin="0,0,0,3">
                                          <Grid ColumnDefinitions="*,92,62,Auto">
                                            <StackPanel Spacing="1" VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding Where}">
                                              <TextBlock Text="{Binding Label}" FontSize="12"
                                                         TextWrapping="Wrap"
                                                         Foreground="{DynamicResource Fore}"
                                                         IsVisible="{Binding !Mine}"/>
                                              <TextBlock Text="{Binding Label}" FontSize="12"
                                                         TextWrapping="Wrap" Foreground="#4ADE80"
                                                         IsVisible="{Binding Mine}"/>
                                              <TextBlock Text="{Binding Detail}" FontSize="10"
                                                         Classes="faint" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" FontSize="12" Padding="5,2"
                                                     CornerRadius="0" Margin="6,0"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Value, Mode=TwoWay}"
                                                     LostFocus="OnEffectNumber"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Now}"
                                                       FontSize="11" Classes="faint"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        Spacing="5" VerticalAlignment="Center"
                                                        MinWidth="104">
                                              <Button Classes="tiny" Content="Reset"
                                                      Click="OnResetEffectNumber"
                                                      IsVisible="{Binding Mine}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <TextBlock Text="{Binding ShopBeyond}" FontSize="10.5"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasShopBeyond}"/>
                                  <TextBlock Text="{Binding ShopProblem}" FontSize="11"
                                             TextWrapping="Wrap" MaxWidth="660"
                                             HorizontalAlignment="Left" Foreground="#FBBF24"
                                             IsVisible="{Binding HasShopProblem}"/>

                                  <!-- EVERYTHING THE MOD DOES TO THIS ONE, off: the override on
                                       its ability and the one on its shop item. -->
                                  <Button Classes="tiny" HorizontalAlignment="Left"
                                          Content="Put everything about this one back"
                                          Click="OnPutModificationBack"
                                          IsVisible="{Binding Altered}"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== WHAT IT POINTS AT
                                 The class valued properties: which OTHER asset does the work.
                                 Where one is inherited, every tier shares it, so changing that
                                 asset changes all of them. -->
                            <Border Classes="card" Tag="Points"
                                    IsVisible="{Binding SecPoints.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecPoints}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecPoints.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="WHAT IT POINTS AT"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecPoints.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="10"
                                            IsVisible="{Binding SecPoints.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             Text="These decide which OTHER asset does the work. A cooldown effect holds the uses per combat, not the ability."/>

                                  <ItemsControl ItemsSource="{Binding PointRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+PointRow">
                                        <StackPanel Spacing="2" Margin="0,0,0,8">
                                          <TextBlock Text="{Binding Label}" FontSize="12"
                                                     TextWrapping="Wrap"
                                                     ToolTip.Tip="{Binding Where}"
                                                     Foreground="{DynamicResource Fore}"/>
                                          <TextBlock Text="{Binding Uses}" FontSize="10.5"
                                                     Classes="faint" TextWrapping="Wrap"
                                                     MaxWidth="640" Margin="14,0,0,0"
                                                     HorizontalAlignment="Left"/>
                                          <StackPanel Orientation="Horizontal" Spacing="7"
                                                      Margin="14,2,0,0"
                                                      IsVisible="{Binding HasMine}">
                                            <TextBlock Text="yours:" FontSize="10.5"
                                                       Classes="faint" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Mine}" FontSize="11.5"
                                                       Foreground="#4ADE80"
                                                       VerticalAlignment="Center"/>
                                            <Button Classes="tiny" Content="Reset"
                                                    Click="OnResetPoint"/>
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="7"
                                                      Margin="14,2,0,0">
                                            <Button Classes="tiny" Content="Choose…"
                                                    Click="OnChoosePoint"/>
                                            <TextBlock Text="or type one of your own:"
                                                       FontSize="10.5" Classes="faint"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Width="250" FontSize="11" Padding="5,2"
                                                     CornerRadius="0"
                                                     FontFamily="Consolas,monospace"
                                                     Watermark="/Game/Game/... or a copy id"
                                                     Text="{Binding Typed, Mode=TwoWay}"/>
                                            <Button Classes="tiny" Content="Use"
                                                    Click="OnTypedPoint"/>
                                          </StackPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== TAG CONTAINERS
                                 Gates: what has to be true for this to fire. A container is a
                                 SET, and giving this asset one REPLACES whatever the chain held
                                 rather than joining it, so Add starts from what it inherits. -->
                            <Border Classes="card" Tag="Gates"
                                    IsVisible="{Binding SecGates.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecGates}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecGates.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="TAG CONTAINERS"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SecGates.Count}"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="10"
                                            IsVisible="{Binding SecGates.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             MaxWidth="660" HorizontalAlignment="Left"
                                             Text="Gates, mostly: what has to be true for this to fire, and what it blocks while it runs. None of them are written in this asset; they come from further up the chain, and adding one here REPLACES the inherited set for this asset alone. Add starts from what it inherits, so adding one tag does not drop the rest."/>

                                  <ItemsControl ItemsSource="{Binding TagBoxRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+TagBoxRow">
                                        <StackPanel Spacing="2" Margin="0,0,0,8">
                                          <TextBlock Text="{Binding Label}" FontSize="12"
                                                     TextWrapping="Wrap"
                                                     ToolTip.Tip="{Binding Where}"
                                                     Foreground="{DynamicResource Fore}"
                                                     IsVisible="{Binding !Added}"/>
                                          <TextBlock Text="{Binding Label}" FontSize="12"
                                                     TextWrapping="Wrap"
                                                     ToolTip.Tip="{Binding Where}"
                                                     Foreground="#4ADE80"
                                                     IsVisible="{Binding Added}"/>
                                          <TextBlock Text="{Binding Holds}" FontSize="10.5"
                                                     Classes="faint" TextWrapping="Wrap"
                                                     MaxWidth="640" Margin="14,0,0,0"
                                                     HorizontalAlignment="Left"/>

                                          <StackPanel Orientation="Horizontal" Spacing="8"
                                                      Margin="14,2,0,0"
                                                      IsVisible="{Binding !Added}">
                                            <Button Classes="tiny" Content="Add"
                                                    Click="OnAddTagBox"/>
                                            <TextBlock Text="{Binding StartsFrom}" FontSize="10"
                                                       Classes="faint" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasStartsFrom}"/>
                                          </StackPanel>

                                          <StackPanel Spacing="3" Margin="14,2,0,0"
                                                      IsVisible="{Binding Added}">
                                            <TextBox FontSize="11.5" Padding="6,3" Width="440"
                                                     CornerRadius="0" AcceptsReturn="True"
                                                     TextWrapping="NoWrap" MinHeight="74"
                                                     HorizontalAlignment="Left"
                                                     FontFamily="Consolas,monospace"
                                                     Text="{Binding Text, Mode=TwoWay}"
                                                     LostFocus="OnSetTagBox"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                              <TextBlock Text="one tag per line" FontSize="10"
                                                         Classes="faint"
                                                         VerticalAlignment="Center"/>
                                              <Button Classes="tiny" Content="Remove"
                                                      Click="OnDropTagBox"/>
                                            </StackPanel>
                                          </StackPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <Border Classes="card" Tag="Numbers"
                                    IsVisible="{Binding SecNumbers.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecNumbers}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecNumbers.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="NUMBERS"/>
                                    <TextBlock Grid.Column="2" Text="what it carries"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecNumbers.Open}">
                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             Text="Double-click a value to type over it. A number is written only after the build's own write has agreed to it against the game's bytes, and a changed one is drawn in the accent colour."/>
                                  <ItemsControl ItemsSource="{Binding Props.Rows}"
                                                ItemTemplate="{StaticResource PropRowTemplate}"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                            <!-- ============================== DEEPER CHANGES
                                 What this part carries that no other section shows. A re-point
                                 made by Pick appears here too, on purpose: this is the only
                                 place that says a reference has moved without knowing which row
                                 moved it, which is what somebody opening a project made by
                                 another author needs. -->
                            <Border Classes="card" Tag="Deeper" Margin="0,0,0,20"
                                    IsVisible="{Binding SecDeeper.Present}">
                              <StackPanel>
                                <Button Classes="cardhead" Click="OnToggleCard"
                                        Tag="{Binding SecDeeper}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Classes="chev" Width="15" Data="{Binding SecDeeper.Chevron}"/>
                                    <TextBlock Grid.Column="1" Classes="sechead"
                                               Text="ADVANCED"/>
                                    <TextBlock Grid.Column="2" Text="for when there is no field for it"
                                               FontSize="10.5" Classes="faint"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SecDeeper.Changed}"/>
                                    <Ellipse Grid.Column="2" Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding SecDeeper.Changed}"
                                             Fill="{DynamicResource Accent}"/>
                                  </Grid>
                                </Button>
                                <StackPanel Margin="12" Spacing="6"
                                            IsVisible="{Binding SecDeeper.Open}">

                                  <TextBlock FontSize="10.5" Classes="faint" TextWrapping="Wrap"
                                             IsVisible="{Binding !HasDeepRows}"
                                             Text="Nothing yet. A mesh or texture pointed somewhere else appears here, and so does a name rewritten by hand."/>

                                  <ItemsControl ItemsSource="{Binding DeepRows}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="local:SheetTab+DeepRow">
                                        <Border Classes="row mine" Margin="0,0,0,6">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="1">
                                              <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding FromLeaf}" FontSize="12"
                                                           Foreground="{DynamicResource Fore}"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding ToLeaf}" FontSize="12"
                                                           Foreground="{DynamicResource Accent}"/>
                                              </StackPanel>
                                              <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                         Classes="faint"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="tiny" Content="Take off"
                                                    VerticalAlignment="Center"
                                                    Click="OnDropDeepRow"/>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- RENAME A NAME EVERYWHERE. The blunt instrument, and the old
                                       studio's own tooltip says so: for a reference that cannot be
                                       found by scanning. It takes no count and promises nothing
                                       about how many it moved, which is why it lives here and not
                                       beside the mesh rows. -->
                                  <TextBlock Classes="faint" FontSize="11" Margin="0,6,0,0"
                                             Text="Rewrite a name everywhere in this part"/>
                                  <Grid ColumnDefinitions="*,Auto,*,Auto" Width="600"
                                        HorizontalAlignment="Left">
                                    <TextBox FontSize="11.5" Padding="5,2" CornerRadius="0"
                                             Watermark="the name it uses"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding RenameFrom, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" Text="→" Margin="7,0"
                                               VerticalAlignment="Center" Classes="faint"/>
                                    <TextBox Grid.Column="2" FontSize="11.5" Padding="5,2"
                                             CornerRadius="0" Watermark="what to write instead"
                                             FontFamily="Consolas,monospace"
                                             Text="{Binding RenameTo, Mode=TwoWay}"/>
                                    <Button Grid.Column="3" Classes="tiny" Content="Add"
                                            Margin="6,0,0,0" Click="OnAddRename"/>
                                  </Grid>
                                </StackPanel>
                              </StackPanel>
                            </Border>

                          </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="3" Width="1" Background="{DynamicResource Line}"
                                IsVisible="{Binding Editing}"/>

                        <!-- WHAT IT IS NOW. While editing, the sheet is this narrow column so a
                             field can be checked against what the part actually says without
                             leaving; reading, it is the whole pane. Same control either way. -->
                        <ScrollViewer Grid.Column="{Binding SheetColumn}"
                                      Grid.ColumnSpan="{Binding SheetSpan}"
                                      MinWidth="330"
                                      IsVisible="{Binding SheetShown}">
                        <ItemsControl ItemsSource="{Binding Sheet}" Margin="0,4,0,14">
                          <ItemsControl.DataTemplates>

                            <DataTemplate DataType="local:SheetBand" x:DataType="local:SheetBand">
                              <Border Background="{DynamicResource Chrome}"
                                      Margin="0,8,0,2" BorderBrush="{DynamicResource Line}"
                                      BorderThickness="0,1,0,1">
                                <Panel>
                                  <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="14,5"
                                             IsVisible="{Binding !Toggles}"
                                             Foreground="{DynamicResource Muted}"/>
                                  <Button Click="OnToggleTags" IsVisible="{Binding Toggles}"
                                          Background="Transparent" BorderThickness="0"
                                          CornerRadius="0" Padding="14,5"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                      <Path Classes="chev" Width="14" Data="{Binding Chevron}"/>
                                      <TextBlock Text="{Binding Text}" FontSize="11.5"
                                                 Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                  </Button>
                                </Panel>
                              </Border>
                            </DataTemplate>

                            <DataTemplate DataType="local:SheetFact" x:DataType="local:SheetFact">
                              <Border Classes.band="{Binding Band}" Padding="14,5">
                                <Grid ColumnDefinitions="130,*">
                                  <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="faint"
                                             FontSize="11.5" VerticalAlignment="Top"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                             TextWrapping="Wrap" IsVisible="{Binding !Wide}"
                                             Foreground="{DynamicResource Fore}"/>
                                  <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding Value}" FontSize="11.5"
                                             Margin="0,18,0,0" TextWrapping="Wrap"
                                             IsVisible="{Binding Wide}"
                                             FontFamily="Consolas,monospace"
                                             Foreground="{DynamicResource Fore}"/>
                                </Grid>
                              </Border>
                            </DataTemplate>

                            <DataTemplate DataType="local:SheetPair" x:DataType="local:SheetPair">
                              <Border Classes.band="{Binding Band}" Padding="14,4">
                                <Grid ColumnDefinitions="190,*">
                                  <TextBlock Grid.Column="0" Text="{Binding Left}" Classes="dim"
                                             FontSize="12"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Right}" FontSize="12"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="{DynamicResource Fore}"/>
                                </Grid>
                              </Border>
                            </DataTemplate>

                            <DataTemplate DataType="local:SheetBullet" x:DataType="local:SheetBullet">
                              <StackPanel Orientation="Horizontal" Margin="28,2,14,2">
                                <TextBlock Text="•" Classes="faint" FontSize="12" Width="14"/>
                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fore}"/>
                              </StackPanel>
                            </DataTemplate>

                          </ItemsControl.DataTemplates>
                        </ItemsControl>
                        </ScrollViewer>
                      </Grid>
                    </DockPanel>
                  </DataTemplate>

                  <!-- ================================================ A MODEL -->
                  <DataTemplate DataType="local:MeshTab" x:DataType="local:MeshTab">
                    <DockPanel>

                      <Border DockPanel.Dock="Bottom" Padding="8,3"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                                     FontFamily="Consolas,monospace"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Tooltip}"/>
                          <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5"
                                     Margin="10,0,0,0" Text="{Binding Status}"/>
                          <!-- The asset's type, which the reference keeps in its status bar
                               ("SkinnedMeshAsset") rather than in a heading of its own. -->
                          <TextBlock Grid.Column="2" Classes="faint" FontSize="10.5"
                                     Margin="10,0,0,0" Text="{Binding Type}"/>
                        </Grid>
                      </Border>

                      <!-- THE VIEWPORT'S TOOLBAR: ONE SHORT ROW, as the reference has it.
                           There used to be a title heading above this carrying the asset's name
                           and type, which the TAB and the status bar already say — two tall rows
                           where the reference has one thin one. The explanatory sentence about
                           Default Lit went with it; the reference puts no prose in its toolbar,
                           and a line that never changes stops being read after the first time. -->
                      <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                              Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    VerticalAlignment="Center">
                          <!-- THE SCENE, NOT THE ASSET — his placement, and it reads right: the
                               grid and the box describe the space the model is standing in, so
                               they come before anything about which model or which LOD. Always
                               visible, unlike Lod, because they apply to every mesh. -->
                          <CheckBox IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                    MinHeight="0" Padding="4,0,0,0" FontSize="10.5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Grid" FontSize="10.5"/>
                          </CheckBox>
                          <CheckBox IsChecked="{Binding ShowFloor, Mode=TwoWay}"
                                    MinHeight="0" Padding="4,0,0,0" FontSize="10.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Floor" FontSize="10.5"/>
                          </CheckBox>
                          <!-- Turning this on turns the Floor on with it: the slab is the only
                               thing here for a shadow to land on, and a toggle that appears to do
                               nothing is worse than one that is off. -->
                          <CheckBox IsChecked="{Binding ShowShadows, Mode=TwoWay}"
                                    MinHeight="0" Padding="4,0,0,0" FontSize="10.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    ToolTip.Tip="The model casts onto the floor">
                            <TextBlock Text="Shadows" FontSize="10.5"/>
                          </CheckBox>

                          <!-- LOD, HIDDEN when the mesh ships only one: a dropdown with a single
                               entry is a control that cannot be operated, and a Nanite mesh
                               genuinely has no chain. -->
                          <TextBlock Classes="faint" FontSize="10.5" VerticalAlignment="Center"
                                     IsVisible="{Binding HasLods}" Text="Lod:"/>
                          <ComboBox ItemsSource="{Binding Lods}" SelectedItem="{Binding Lod}"
                                    IsVisible="{Binding HasLods}"
                                    MinWidth="52" MinHeight="0" FontSize="10.5"
                                    Padding="6,1" CornerRadius="0" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                          <TextBlock Classes="faint" FontSize="10.5" VerticalAlignment="Center"
                                     Text="View Mode:"/>
                          <!-- The rows come from the SHADER's own mode list. A dropdown filled in
                               here would be a second opinion about what the shader implements,
                               and a mode it does not would fall through to lit without a word. -->
                          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                    MinWidth="126" MinHeight="0" FontSize="10.5"
                                    Padding="6,1" CornerRadius="0"
                                    VerticalAlignment="Center"/>

                          <!-- THE TINT PICKER, "a little button at the top with a color picker
                               that list all the games colors". HIDDEN when the model paints
                               through no tint mask: offering the game's colours on a mesh whose
                               material names no `Tint Mask VT` is a control that looks broken
                               rather than one that is absent.
                               Primary / Secondary / Tertiary are Colour 01 / 02 / 03, which the
                               mask's red, green and blue channels select in that order — the
                               game's own T_DefaultTintMSK has the words painted into them. -->
                          <!-- EXPORT writes the model, then — only if an animation is loaded —
                               asks again for the animation, which is a separate file because FBX
                               here is meshes only. IMPORT puts geometry over the game's own mesh
                               and needs a mod to record it in. -->
                          <Button Classes="tiny" Margin="8,0,0,0" Click="OnExportModel"
                                  VerticalAlignment="Center">
                            <TextBlock Text="Export"/>
                          </Button>
                          <Button Classes="tiny" Margin="4,0,0,0" Click="OnImportModel"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding $parent[Window].((local:StudioVm)DataContext).HasMod}">
                            <TextBlock Text="Import"/>
                          </Button>

                          <Button Classes="tiny" Margin="8,0,0,0" IsVisible="{Binding CanTint}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="Tint"/>
                            <Button.Flyout>
                              <Flyout Placement="Bottom">
                                <StackPanel Width="250" Spacing="6">
                                  <TextBlock Classes="colhead" Text="THE GAME'S COLOURS"/>
                                  <TextBlock Classes="faint" FontSize="10.5" Text="Primary — Color 01"/>
                                  <ComboBox ItemsSource="{Binding Swatches}"
                                            SelectedItem="{Binding Colour1}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                  <TextBlock Classes="faint" FontSize="10.5" Text="Secondary — Color 02"/>
                                  <ComboBox ItemsSource="{Binding Swatches}"
                                            SelectedItem="{Binding Colour2}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                  <TextBlock Classes="faint" FontSize="10.5" Text="Tertiary — Color 03"/>
                                  <ComboBox ItemsSource="{Binding Swatches}"
                                            SelectedItem="{Binding Colour3}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                  <Button Classes="tiny" HorizontalAlignment="Right"
                                          Command="{Binding ClearTint}">
                                    <TextBlock Text="As shipped"/>
                                  </Button>
                                </StackPanel>
                              </Flyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                      </Border>

                      <!-- ONE SIDE PANEL WITH TABS, as the reference has it — Properties,
                           Variations, Mesh, Scene down one edge rather than a stack of boxes.
                           Two panels for two lists is what "cluttered" meant. -->
                      <Border DockPanel.Dock="Right" Width="340" Classes="pane"
                              BorderThickness="1,0,0,0">
                        <TabControl Padding="0" Background="Transparent" Classes="side"
                                    SelectedIndex="{Binding SidePanel, Mode=TwoWay}">

                          <!-- PROPERTIES FIRST IN THE STRIP, as the reference has it, but the
                               panel OPENS on Animations — see MeshTab.SidePanel. That is the tab
                               with something to do in it.
                               and the one that answers "what IS this asset". It is the same grid
                               the data-asset tab uses, over an AssetTab held inside this one —
                               one reader, two places it can be shown. -->
                          <TabItem>
                            <TabItem.Header><TextBlock Text="Properties"/></TabItem.Header>
                            <DockPanel Margin="0,2,0,0">
                              <TextBox DockPanel.Dock="Top" Text="{Binding Props.Filter, Mode=TwoWay}"
                                       Watermark="Filter" FontSize="10.5" Padding="5,2"
                                       CornerRadius="0" BorderThickness="0,0,0,1"
                                       Background="Transparent"
                                       BorderBrush="{DynamicResource Line}"/>
                              <TextBlock DockPanel.Dock="Bottom" Classes="faint" FontSize="10"
                                         Margin="6,3" TextTrimming="CharacterEllipsis"
                                         Text="{Binding Props.Status}"/>
                              <ListBox ItemsSource="{Binding Props.Rows}" Background="Transparent"
                                       BorderThickness="0" Padding="0,1"
                                       ItemTemplate="{StaticResource PropRowTemplate}"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </DockPanel>
                          </TabItem>

                          <TabItem>
                            <TabItem.Header><TextBlock Text="Animations"/></TabItem.Header>
                            <DockPanel Margin="9,6">
                              <!-- WHAT THIS RIG CAN PLAY, not what its skeleton asset names. A
                                   wearable part's own skeleton carries no sequences in this game
                                   — the armour kits hold five between them — so the list is built
                                   by matching BONE NAMES against the skeletons animations really
                                   do target, the same question playback answers. -->
                              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
                                    Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{Binding AnimNote}"/>
                                <!-- FIFTY-SIX GROUPS IS A LOT OF CHEVRONS. One button for all of
                                     them, and it says which way it goes rather than toggling
                                     something the author has to guess at. -->
                                <Button Grid.Column="1" Classes="tiny" Margin="6,0,0,0"
                                        Click="OnAllAnimGroups">
                                  <TextBlock Text="{Binding FoldWord}"/>
                                </Button>
                              </Grid>
                              <!-- A LISTBOX, FOR VIRTUALISATION. This rig can play 2,720
                                   sequences and an ItemsControl builds a container for every one
                                   of them; a ListBox builds only the rows on screen. Selection
                                   comes free, which is what playback will hang off. -->
                              <!-- PLAY / PAUSE / STOP and where it has got to. The frame count
                                   follows the render loop rather than a timer, because the loop
                                   IS the clock — a 16ms DispatcherTimer delivered a tenth of the
                                   time it should have, starved by the rendering it was driving. -->
                              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                          Spacing="4" Margin="0,0,0,4">
                                <Button Classes="tiny" Command="{Binding TogglePlay}">
                                  <TextBlock Text="Play / Pause"/>
                                </Button>
                                <Button Classes="tiny" Command="{Binding StopAnim}">
                                  <TextBlock Text="Stop"/>
                                </Button>
                                <!-- LOOP OFF IS HOW ANYTHING THAT HAPPENS ONCE GETS SEEN — a
                                     death, a reload, a melee. Playback forced it on, so the end
                                     of those had to be caught rather than looked at. -->
                                <CheckBox IsChecked="{Binding Loop, Mode=TwoWay}"
                                          IsEnabled="{Binding HasAnim}"
                                          VerticalAlignment="Center" Margin="4,0,0,0">
                                  <TextBlock Text="Loop" FontSize="11"/>
                                </CheckBox>
                                <TextBlock Text="Speed" Classes="faint" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Slider Minimum="0.05" Maximum="3" Width="96"
                                        Value="{Binding Speed, Mode=TwoWay}"
                                        IsEnabled="{Binding HasAnim}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedSays}" Classes="num" FontSize="10"
                                           Width="38" VerticalAlignment="Center"/>
                              </StackPanel>

                              <!-- THE SCRUB BAR. Dragging it pauses, because the frame you
                                   dragged to is the frame you want to look at and a player that
                                   carried on would take it away before you had seen it. -->
                              <Slider DockPanel.Dock="Top" Minimum="0"
                                      Maximum="{Binding Frames}"
                                      Value="{Binding Frame, Mode=TwoWay}"
                                      IsEnabled="{Binding HasAnim}"
                                      Margin="0,0,0,2"/>
                              <TextBlock DockPanel.Dock="Top" Classes="num" FontSize="10"
                                         Margin="0,0,0,5" TextTrimming="CharacterEllipsis"
                                         Text="{Binding PlayNote}"/>
                              <!-- OUT THROUGH THE PANEL'S GUTTER, which is the 9px the
                                   author kept landing in: the DockPanel above insets everything
                                   it holds by 9, so the row stopped 9px short of the edge and
                                   that strip hit the panel Border and folded nothing. Measured
                                   by the animhit probe, which reported x minus 1 landing on
                                   the Border and folding nothing.

                                   The furniture above still wants the gutter, so the LIST comes
                                   out of it rather than the panel losing it, and each row puts
                                   the 9 back as its own margin. Same picture, except the part
                                   that looks clickable now is. -->
                              <ListBox ItemsSource="{Binding Animations}"
                                       SelectedItem="{Binding PickedAnim, Mode=TwoWay}"
                                       DoubleTapped="OnPlayAnimation"
                                       KeyDown="OnAnimKey"
                                       Margin="-9,0"
                                       Background="Transparent" BorderThickness="0"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.DataTemplates>
                                  <!-- THE SET: the game's own folders. Folds, and takes its
                                       action groups with it — the first view of this tab is
                                       meant to be the handful of set names. -->
                                  <DataTemplate DataType="local:AnimHeading">
                                   <Button Classes="foldrow" Click="OnToggleAnimFold"
                                           Tag="{Binding}">
                                    <Grid ColumnDefinitions="12,*" Margin="9,7,9,2">
                                      <Path Grid.Column="0" Classes="chev" Data="{Binding Chevron}"/>
                                      <TextBlock Grid.Column="1" Classes="colhead"
                                                 TextTrimming="CharacterEllipsis"
                                                 Text="{Binding Label}"/>
                                    </Grid>
                                   </Button>
                                  </DataTemplate>
                                  <!-- THE ACTION, read out of the name: these folders are flat,
                                       so without this level a category is a label over a
                                       thousand rows. Click folds it away. -->
                                  <DataTemplate DataType="local:AnimGroup">
                                   <Button Classes="foldrow" Click="OnToggleAnimFold"
                                           Tag="{Binding}">
                                    <Grid ColumnDefinitions="14,*" Margin="13,4,9,1">
                                      <Path Grid.Column="0" Classes="chev" Data="{Binding Chevron}"/>
                                      <TextBlock Grid.Column="1" FontSize="11"
                                                 FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource Fore}"
                                                 Text="{Binding Label}"/>
                                    </Grid>
                                   </Button>
                                  </DataTemplate>
                                  <DataTemplate DataType="local:AnimRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="27,0,9,0"
                                          ToolTip.Tip="{Binding Path}">
                                      <TextBlock Grid.Column="0" FontSize="11"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource Fore}"
                                                 Text="{Binding Name}"/>
                                      <TextBlock Grid.Column="1" Classes="faint" FontSize="10"
                                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Text="{Binding Detail}"/>
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.DataTemplates>
                              </ListBox>
                            </DockPanel>
                          </TabItem>

                          <!-- MESHES: what else is on this model. His ask — the loaded mesh
                               named at the top, a plus under it, and a picker that offers the
                               meshes built for this rig first. A torso can then wear its helmet,
                               arms, legs and boots. -->
                          <TabItem>
                            <TabItem.Header><TextBlock Text="Meshes"/></TabItem.Header>
                            <DockPanel Margin="9,6">
                              <TextBlock DockPanel.Dock="Top" Classes="colhead" Margin="0,0,0,2"
                                         Text="Loaded"/>
                              <TextBlock DockPanel.Dock="Top" FontSize="11" Margin="0,0,0,8"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource Fore}"
                                         Text="{Binding LoadedName}"/>

                              <TextBlock DockPanel.Dock="Top" Classes="colhead" Margin="0,0,0,2"
                                         Text="Attached"/>
                              <!-- THE PLUS, under the name as he drew it. Docked BEFORE the list
                                   so it keeps its place when the list grows or scrolls. -->
                              <Button DockPanel.Dock="Top" Classes="tiny" Click="OnAttachMesh"
                                      HorizontalAlignment="Left" Margin="0,4,0,6">
                                <TextBlock Text="+"/>
                              </Button>
                              <TextBlock DockPanel.Dock="Top" Classes="faint" FontSize="10"
                                         TextWrapping="Wrap" Margin="0,0,0,6"
                                         IsVisible="{Binding !HasAttached}"
                                         Text="Nothing yet. The picker offers the meshes built for this rig first, and says how well each one really fitted once it is on."/>
                              <ItemsControl ItemsSource="{Binding AttachedMeshes}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="local:AttachedRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4"
                                          ToolTip.Tip="{Binding Key}">
                                      <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Fore}"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Classes="faint" FontSize="10"
                                                   TextWrapping="Wrap" Text="{Binding Fits}"/>
                                      </StackPanel>
                                      <Button Grid.Column="1" Classes="tiny" Click="OnDetachMesh"
                                              Tag="{Binding Key}" VerticalAlignment="Top"
                                              Margin="6,0,0,0">
                                        <TextBlock Text="x"/>
                                      </Button>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </DockPanel>
                          </TabItem>

                          <TabItem>
                            <TabItem.Header><TextBlock Text="Materials"/></TabItem.Header>
                            <DockPanel Margin="9,6">
                              <TextBlock DockPanel.Dock="Top" Classes="faint" FontSize="10.5"
                                         TextWrapping="Wrap" Margin="0,0,0,6"
                                         Text="{Binding Status}"/>
                              <!-- WHICH MAPS REACHED EACH SLOT. Nothing in the picture separates
                                   a material with no mask from one that works — it just draws
                                   with the shader's constants — and this is the readout that
                                   caught the game's own mask going unbound. -->
                              <ListBox ItemsSource="{Binding Materials}"
                                       Background="Transparent" BorderThickness="0"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                  <DataTemplate DataType="local:ModelView+MaterialRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Grid.Column="0" FontSize="11"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource Fore}"
                                                 Text="{Binding Name}"/>
                                      <TextBlock Grid.Column="1" Classes="num" FontSize="10"
                                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Text="{Binding Maps}"/>
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </DockPanel>
                          </TabItem>

                        </TabControl>
                      </Border>

                      <!-- The GL control itself, held by the tab so switching away and back does
                           not re-read the package and re-upload the buffers. -->
                      <ContentControl Content="{Binding View}"/>
                    </DockPanel>
                  </DataTemplate>

                  <!-- ================================================ A TEXTURE -->
                  <!-- ONE SOUND, WITH A TRANSPORT. The decoding, the Wwise media lookup and the
                       playback are all UEToolkit.Core and all already proven; this is the panel
                       over them, and the Extract button is a COPY of the WAV Resolve has already
                       written into the preview cache rather than a second export path. -->
                  <DataTemplate DataType="local:SoundTab" x:DataType="local:SoundTab">
                    <DockPanel>
                      <Border DockPanel.Dock="Bottom" Padding="8,3"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <TextBlock Classes="faint" FontSize="10.5"
                                   FontFamily="Consolas,monospace"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Tooltip}"/>
                      </Border>

                      <StackPanel Margin="18" Spacing="13" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fore}"/>

                        <Grid ColumnDefinitions="95,*" RowDefinitions="Auto,Auto">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Where" Classes="faint"
                                     FontSize="11.5"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Where}"
                                     FontSize="11.5" TextWrapping="Wrap"
                                     Foreground="{DynamicResource Fore}"/>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Language" Classes="faint"
                                     FontSize="11.5" Margin="0,4,0,0"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Language}"
                                     FontSize="11.5" Margin="0,4,0,0"
                                     Foreground="{DynamicResource Fore}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Click="OnPlaySound" Padding="14,5">
                            <TextBlock Text="{Binding PlayWord}"/>
                          </Button>
                          <Button Classes="tiny" Click="OnStopSound">
                            <TextBlock Text="Stop"/>
                          </Button>
                          <TextBlock Text="{Binding Clock}" FontSize="11.5" Margin="8,0,0,0"
                                     FontFamily="Consolas,monospace"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Muted}"/>
                          <!-- DEAD UNTIL IT HAS PLAYED, because that is when the file exists.
                               Offering to save one that does not would have to decode on the
                               press or fail, and saying so is the honest version. -->
                          <Button Classes="tiny" Click="OnExtractSound" Margin="10,0,0,0"
                                  IsEnabled="{Binding CanExtract}">
                            <TextBlock Text="Extract…"/>
                          </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>

                  <DataTemplate DataType="local:TextureTab" x:DataType="local:TextureTab">
                    <DockPanel>

                      <Border DockPanel.Dock="Bottom" Padding="8,3"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Grid.Column="0" Classes="faint" FontSize="10.5"
                                     FontFamily="Consolas,monospace"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Tooltip}"/>
                          <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5"
                                     Margin="10,0,0,0" Text="{Binding Status}"/>
                          <TextBlock Grid.Column="2" Classes="faint" FontSize="10.5"
                                     Margin="10,0,0,0" Text="{Binding Type}"/>
                        </Grid>
                      </Border>

                      <!-- EVERYTHING ALONG THE TOP, as the reference has it for a texture: the
                           channel toggles, then the view controls, then the shipped size and the
                           format right-aligned. There is NO side panel here at all any more.
                           The picture is the point of this tab, and a 168px column down the edge
                           of a square image was taking width from the one thing being looked at.
                           R G B A as TOGGLES rather than checkboxes, which is both what the
                           reference uses and half the width per channel. -->
                      <Border DockPanel.Dock="Top" Background="{DynamicResource Raised}"
                              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                              Padding="6,2">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                      VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowR}" Classes="chan" Content="R"/>
                            <ToggleButton IsChecked="{Binding ShowG}" Classes="chan" Content="G"/>
                            <ToggleButton IsChecked="{Binding ShowB}" Classes="chan" Content="B"/>
                            <ToggleButton IsChecked="{Binding ShowAlpha}" Classes="chan" Content="A"/>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                      Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button Classes="tiny" Command="{Binding Colour}">
                              <TextBlock Text="Colour"/>
                            </Button>
                            <!-- Alpha ALONE, which the shader then draws as GREY rather than
                                 through a filter. Worth its own button: masks in this game carry
                                 a different meaning per channel, and an alpha of zero has
                                 premultiplied the colour away on more than one of them. -->
                            <Button Classes="tiny" Command="{Binding AlphaOnly}">
                              <TextBlock Text="Alpha only"/>
                            </Button>
                          </StackPanel>

                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                      Margin="12,0,0,0" VerticalAlignment="Center">
                            <Button Classes="tiny" Command="{Binding Fit}">
                              <TextBlock Text="Fit"/>
                            </Button>
                            <Button Classes="tiny" Command="{Binding Actual}">
                              <TextBlock Text="1:1"/>
                            </Button>
                            <TextBlock Classes="num" FontSize="10.5" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Text="{Binding Zoom}"/>
                          </StackPanel>

                          <!-- EXPORT AND IMPORT.
                               Export asks WHERE and in WHAT format; the format sits beside the
                               button because picking it inside a file dialog hides the one
                               decision worth seeing. Import puts the author's own image over
                               this GAME texture and marks the file modified — it is an override
                               of the package, so it needs a mod open to belong to. -->
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                      Margin="16,0,0,0" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Formats}"
                                      SelectedItem="{Binding SelectedFormat}"
                                      MinWidth="62" MinHeight="0" FontSize="10.5"
                                      Padding="6,1" CornerRadius="0"
                                      VerticalAlignment="Center"/>
                            <Button Classes="tiny" Click="OnExportTexture">
                              <TextBlock Text="Export"/>
                            </Button>
                            <Button Classes="tiny" Click="OnImportTexture"
                                    IsEnabled="{Binding $parent[Window].((local:StudioVm)DataContext).HasMod}">
                              <TextBlock Text="Import"/>
                            </Button>
                          </StackPanel>

                          <!-- THE SHIPPED SIZE AND FORMAT, right-aligned as the reference puts
                               its own. The shipped size, not the imported one: this game cooks
                               textures down, so the authoring dimensions are a number that is
                               not in the file a mod will load. -->
                          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10"
                                      VerticalAlignment="Center">
                            <TextBlock Classes="num" FontSize="10.5"
                                       VerticalAlignment="Center" Text="{Binding Size}"/>
                            <TextBlock Classes="faint" FontSize="10.5"
                                       VerticalAlignment="Center" Text="{Binding Format}"/>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <ContentControl Content="{Binding View}"/>
                    </DockPanel>
                  </DataTemplate>

                </ContentControl.DataTemplates>
              </ContentControl>
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"/>

        <Border Grid.Row="2" Classes="pane" BorderThickness="0,1,0,0">
          <TabControl Name="BottomTabs" Padding="0">
            <TabItem Name="LogTab" Header="Log" FontSize="12">
              <ScrollViewer Name="LogScroll">
                <ItemsControl Name="LogList" ItemsSource="{Binding Log}" Margin="8,4">
                  <ItemsControl.ItemTemplate>
                    <!-- A COMPLAINT IN RED, everything else as it was. The validator's sentences
                         used to live in the build bar, where three of them share one trimmed
                         line and the rest are a tooltip. -->
                    <DataTemplate x:DataType="local:LogLine">
                      <Panel>
                        <TextBlock Classes="num" Text="{Binding Text}"
                                   IsVisible="{Binding Ok}"/>
                        <TextBlock Classes="num" Text="{Binding Text}"
                                   IsVisible="{Binding Bad}" TextWrapping="Wrap"
                                   Foreground="#F87171"/>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
